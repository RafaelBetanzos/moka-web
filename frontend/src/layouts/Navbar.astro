---
import LinkedIn from "@assets/LinkedIn.svg";
import Logo from "@assets/icons/Logo_Moka_White.png";
import { Image } from "astro:assets";
---

<div class="bg-charcoal relative w-full">
  <nav
    class="flex flex-row justify-between items-center w-full py-4 px-4 sm:px-8 flex-nowrap gap-4"
  >
    <div class="shrink-0">
      <a href="/">
        <Image src={Logo} alt="Moka Bio Logo" class="w-9 sm:w-12" />
      </a>
    </div>

    <div class="flex flex-row gap-3 sm:gap-8 items-center justify-end shrink-0">
      <div
        class="flex flex-row gap-3 sm:gap-8 text-pure text-[10px] xs:text-xs sm:text-2xl font-semibold items-center whitespace-nowrap"
      >
        <a href="/" class="hover:text-freshgreen transition-colors">Home</a>
        <a href="/our-technology" class="hover:text-freshgreen transition-colors">Tech</a> 
        <a href="/about-us" class="hover:text-freshgreen transition-colors">About</a>
        
        {/* <a href="/articles" class="hover:text-secondary transition-colors">Articles</a> */}
      </div>

      <a 
        href="https://www.linkedin.com/company/mokabio" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hover:scale-110 transition-transform"
      >
        <Image 
          src={LinkedIn} 
          alt="LinkedIn Profile" 
          class="w-5 sm:w-10 opacity-90 hover:opacity-100"
          loading="lazy" 
        />
      </a>

      <div
        class="bg-pure text-charcoal rounded-full px-3 py-1 sm:px-6 sm:py-2 text-[10px] sm:text-[16px] font-semibold whitespace-nowrap hover:bg-freshgreen transition-colors"
      >
        <a href="/contact-us">Contact</a>
      </div>
    </div>
  </nav>
</div>
