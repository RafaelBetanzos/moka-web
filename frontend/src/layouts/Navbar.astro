---
import { Image } from "astro:assets";
import Logo from "@assets/Logo.svg";
import LinkedIn from "@assets/LinkedIn.svg";
---

<div class="bg-primary">
  <div class="flex flex-row justify-between items-center ml-12 mr-12">
    <div class="mb-4 mt-4">
      <Image src={Logo} alt="Logo" width={130} height={130} loading="eager" />
    </div>

    <div class="flex flex-row gap-16 text-navbar text-[16px] font-semibold">
      <p>Home</p>
      <p>Our Technology</p>
      <p>About Us</p>
      <p>Articles</p>
    </div>

    <div class="flex flex-row gap-4">
      <Image src={LinkedIn} alt="Linkedin" class="w-[20%]" loading="eager" />
      <div
        class="bg-navbar text-white rounded-full pl-4 pr-4 pt-1 pb-1 text-[16px] font-semibold whitespace-nowrap"
      >
        <p>Contact Us</p>
      </div>
    </div>
  </div>
</div>
