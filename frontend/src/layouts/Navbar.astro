---
import LinkedIn from "@assets/LinkedIn.svg";
import Logo from "@assets/icons/Logo_Moka_White.png";
import { Image } from "astro:assets";

const path = Astro.url.pathname;
const isSpanish = path === "/es" || path.startsWith("/es/");
const isPortuguese = path === "/pt" || path.startsWith("/pt/");
const currentLang = isSpanish ? "ES" : isPortuguese ? "PT" : "EN";
const isHome = path === "/" || path === "" || path === "/es" || path === "/es/" || path === "/pt" || path === "/pt/";
const normalizedPath = path.replace(/\/$/, "") || "/";
const pathWithoutLocale = normalizedPath.replace(/^\/(es|pt)(?=\/|$)/, "") || "/";
const localizedPath = (locale: "en" | "es" | "pt") => {
  if (locale === "en") return pathWithoutLocale;
  return pathWithoutLocale === "/" ? `/${locale}` : `/${locale}${pathWithoutLocale}`;
};
const currentLocale = isSpanish ? "es" : isPortuguese ? "pt" : "en";
const navHref = (href: string) => currentLocale === "en" ? href : href === "/" ? `/${currentLocale}` : `/${currentLocale}${href}`;
const navCopy = {
  en: { home: "Home", tech: "Tech", about: "About", insights: "Insights", bookDemo: "Book a Demo" },
  es: { home: "Inicio", tech: "Tech", about: "Nosotros", insights: "Insights", bookDemo: "Agendar demo" },
  pt: { home: "Início", tech: "Tech", about: "Sobre", insights: "Insights", bookDemo: "Agendar demo" },
}[currentLocale];
---

<div
  class="nav-root sticky top-0 z-50 w-full"
  data-home={isHome ? "" : undefined}
>
  <nav
    class="flex flex-row justify-between items-center w-full py-5 sm:py-7 px-4 sm:px-8 flex-nowrap gap-4"
  >
    <div class="flex items-center gap-4 sm:gap-7 shrink-0">
      <a href={navHref("/")}>
        <Image src={Logo} alt="Moka Bio Logo" class="w-10 sm:w-14" />
      </a>
      <a href={navHref("/")} class="nav-link hover:text-freshgreen transition-colors text-pure text-[16px] font-semibold whitespace-nowrap">{navCopy.home}</a>
    </div>

    <div class="flex flex-row gap-4 sm:gap-8 items-center justify-end shrink-0">
      <div
        class="flex flex-row gap-4 sm:gap-8 text-pure text-[16px] font-semibold items-center whitespace-nowrap"
      >
        <a href={navHref("/our-technology")} class="nav-link hover:text-freshgreen transition-colors">{navCopy.tech}</a>
        <a href={navHref("/about-us")} class="nav-link hover:text-freshgreen transition-colors">{navCopy.about}</a>
        <a href={navHref("/insights")} class="nav-link hover:text-freshgreen transition-colors">{navCopy.insights}</a>
      </div>

      <a
        href="https://www.linkedin.com/company/mokabio"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:scale-110 transition-transform"
      >
        <Image
          src={LinkedIn}
          alt="LinkedIn Profile"
          class="w-5 sm:w-7 opacity-90 hover:opacity-100"
          loading="lazy"
        />
      </a>

      <a
        href={navHref("/contact-us")}
        class="bg-freshgreen text-charcoal rounded-full px-4 py-2 sm:px-6 sm:py-2.5 text-[16px] font-semibold whitespace-nowrap transition-all duration-200 hover:bg-pure hover:shadow-lg hover:shadow-freshgreen/20 no-underline"
      >
        {navCopy.bookDemo}
      </a>

      <details class="language-menu relative">
        <summary class="language-trigger">
          {currentLang}
          <span aria-hidden="true">▾</span>
        </summary>
        <div class="language-options">
          <a href={localizedPath("en")} class:list={["language-option", currentLang === "EN" && "language-option--active"]}>English</a>
          <a href={localizedPath("es")} class:list={["language-option", currentLang === "ES" && "language-option--active"]}>Español</a>
          <a href={localizedPath("pt")} class:list={["language-option", currentLang === "PT" && "language-option--active"]}>Português</a>
        </div>
      </details>
    </div>
  </nav>
</div>

<script>
  const nav = document.querySelector('.nav-root') as HTMLElement | null;
  if (nav && nav.hasAttribute('data-home')) {
    const update = () => nav.classList.toggle('nav-scrolled', window.scrollY > 72);
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  /* ── Scroll-aware background ──────────────────── */
  .nav-root {
    transition: background 280ms ease, backdrop-filter 280ms ease, border-color 280ms ease;
  }

  /* Interior pages: always opaque */
  .nav-root:not([data-home]) {
    background: rgba(18, 18, 18, 0.94);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  /* Home: opaque only after scrolling past the hero intro */
  .nav-root[data-home].nav-scrolled {
    background: rgba(18, 18, 18, 0.94);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  /* ── Nav links ────────────────────────────────── */
  .nav-link {
    position: relative;
    padding-bottom: 2px;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1.5px;
    background: var(--fresh-green-color);
    border-radius: 999px;
    transition: width 260ms ease;
  }

  .nav-link:hover::after,
  .nav-link--active::after {
    width: 100%;
  }

  .nav-link--active {
    color: var(--fresh-green-color);
  }

  .language-menu {
    font-family: Inter, sans-serif;
  }

  .language-menu[open] .language-trigger {
    border-color: rgba(110, 191, 126, 0.5);
    color: var(--fresh-green-color);
  }

  .language-trigger {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid rgba(222, 222, 222, 0.14);
    border-radius: 999px;
    background: rgba(18, 18, 18, 0.46);
    color: var(--birch-color);
    cursor: pointer;
    font-size: 13px;
    font-weight: 700;
    list-style: none;
    padding: 0.45rem 0.7rem;
    transition: border-color 220ms ease, color 220ms ease, background 220ms ease;
  }

  .language-trigger::-webkit-details-marker {
    display: none;
  }

  .language-options {
    position: absolute;
    right: 0;
    top: calc(100% + 0.55rem);
    z-index: 60;
    display: grid;
    min-width: 150px;
    gap: 0.15rem;
    border: 1px solid rgba(110, 191, 126, 0.18);
    border-radius: 0.85rem;
    background: rgba(18, 18, 18, 0.96);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.34);
    padding: 0.45rem;
  }

  .language-option {
    border-radius: 0.55rem;
    color: var(--birch-color);
    font-size: 13px;
    font-weight: 650;
    padding: 0.55rem 0.7rem;
    text-decoration: none;
    transition: background 180ms ease, color 180ms ease;
  }

  .language-option:hover,
  .language-option--active {
    background: rgba(110, 191, 126, 0.12);
    color: var(--fresh-green-color);
  }
</style>

<script>
  const links = document.querySelectorAll('.nav-link');
  const path  = window.location.pathname.replace(/\/$/, '') || '/';

  links.forEach((link) => {
    const href = link.getAttribute('href')?.replace(/\/$/, '') || '';
    const isLocalizedHome = href === '/' || href === '/es' || href === '/pt';
    const isActive = isLocalizedHome ? path === href : path.startsWith(href);
    if (isActive) link.classList.add('nav-link--active');
  });
</script>
