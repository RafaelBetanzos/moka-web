---
import "../styles/global.css";
import CookieConsent from "@components/CookieConsent.astro";
import Footer from "./Footer.astro";
import Navbar from "./Navbar.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  lang?: "en" | "es" | "pt";
  /** Extra JSON-LD nodes for this page (e.g. SoftwareApplication, Service). */
  schema?: Record<string, unknown>[];
  /** Label for this page in the breadcrumb (omitted on home pages). */
  breadcrumb?: string;
}

const {
  title = "Plant Bioactivity Discovery in Latin America | Moka Bio",
  description = "Find and prioritize bioactivity in understudied Latin American plants with the Moka BDE platform or R&D services, from extract to molecule.",
  ogImage = "/og-image.jpg",
  canonicalUrl,
  lang,
  schema = [],
  breadcrumb,
} = Astro.props;

const siteUrl = "https://moka.bio";
const googleAnalyticsId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? "G-MEXX4CR4HW";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentLang = lang ?? (path === "/es" || path.startsWith("/es/") ? "es" : path === "/pt" || path.startsWith("/pt/") ? "pt" : "en");
const pathWithoutLocale = path.replace(/^\/(es|pt)(?=\/|$)/, "") || "/";
// GitHub Pages serves every page as /path/, so canonical URLs always end with a slash
const withSlash = (value: string) => (value.endsWith("/") ? value : `${value}/`);
const localizedPath = (locale: "en" | "es" | "pt") =>
  withSlash(locale === "en" ? pathWithoutLocale : pathWithoutLocale === "/" ? `/${locale}` : `/${locale}${pathWithoutLocale}`);
const canonical = canonicalUrl ?? `${siteUrl}${localizedPath(currentLang)}`;
const ogImageAbsolute = ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`;
const htmlLang = { en: "en", es: "es", pt: "pt-BR" }[currentLang];
const ogLocale = { en: "en_US", es: "es_MX", pt: "pt_BR" }[currentLang];
const homeLabel = { en: "Home", es: "Inicio", pt: "Início" }[currentLang];
const homeUrl = `${siteUrl}${currentLang === "en" ? "/" : `/${currentLang}/`}`;

const organization = {
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  name: "Moka Bio",
  legalName: "Moka Bio, Inc.",
  url: `${siteUrl}/`,
  logo: `${siteUrl}/Logo_Moka_White.png`,
  email: "info@moka.bio",
  description: "Moka Bio finds and prioritizes bioactivity in understudied Latin American plants through the Moka BDE platform, the Icaros plant database, and R&D services from extract to molecule.",
  areaServed: "Latin America",
  knowsAbout: ["plant bioactivity", "bioactive discovery", "natural products", "botanical ingredients", "Latin American biodiversity"],
  founder: [
    { "@type": "Person", name: "Rafael Betanzos San Juan", jobTitle: "CEO", sameAs: ["https://www.linkedin.com/in/rafabetanzos/"] },
    { "@type": "Person", name: "Juan Facundo Gulías", jobTitle: "CSO", sameAs: ["https://www.linkedin.com/in/facugulias/"] },
  ],
  sameAs: ["https://www.linkedin.com/company/mokabio", "https://www.instagram.com/mokabio"],
};

const graph = [
  organization,
  {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    url: `${siteUrl}/`,
    name: "Moka Bio",
    inLanguage: ["en", "es", "pt-BR"],
    publisher: { "@id": `${siteUrl}/#organization` },
  },
  {
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: htmlLang,
    isPartOf: { "@id": `${siteUrl}/#website` },
    about: { "@id": `${siteUrl}/#organization` },
  },
  ...(breadcrumb
    ? [{
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: homeLabel, item: homeUrl },
          { "@type": "ListItem", position: 2, name: breadcrumb, item: canonical },
        ],
      }]
    : []),
  ...schema,
];
---

<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${localizedPath("en")}`} />
    <link rel="alternate" hreflang="es" href={`${siteUrl}${localizedPath("es")}`} />
    <link rel="alternate" hreflang="pt-BR" href={`${siteUrl}${localizedPath("pt")}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${localizedPath("en")}`} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/Logo_Moka_DarkGreen.png" />
    <link rel="apple-touch-icon" href="/Logo_Moka__Square_White.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Moka Bio" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- JSON-LD: organization, website, page, breadcrumb and page-specific nodes -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })} />

    <!-- Google Analytics (centralizado): solo se carga con consentimiento, ver CookieConsent -->
    {googleAnalyticsId && (
      <>
        <script is:inline define:vars={{ googleAnalyticsId }}>
          window.mokaLoadAnalytics = () => {
            if (window.gtag) return;
            window['ga-disable-' + googleAnalyticsId] = false;
            const script = document.createElement('script');
            script.async = true;
            script.src = `https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`;
            document.head.appendChild(script);
            window.dataLayer = window.dataLayer || [];
            window.gtag = function gtag(){ window.dataLayer.push(arguments); };
            window.gtag('js', new Date());
            window.gtag('config', googleAnalyticsId);
          };
          window.mokaDisableAnalytics = () => {
            window['ga-disable-' + googleAnalyticsId] = true;
            const domain = location.hostname.replace(/^www\./, '');
            document.cookie.split(';').map((c) => c.split('=')[0].trim()).filter((name) => name.startsWith('_ga')).forEach((name) => {
              document.cookie = `${name}=; Max-Age=0; path=/`;
              document.cookie = `${name}=; Max-Age=0; path=/; domain=.${domain}`;
            });
          };
          let consent = null;
          try { consent = localStorage.getItem('moka-analytics-consent'); } catch {}
          if (consent === 'granted') window.mokaLoadAnalytics();
        </script>
        <script is:inline>
          document.addEventListener('click', (event) => {
            const target = event.target instanceof Element
              ? event.target.closest('[data-analytics-event]')
              : null;

            const eventName = target?.getAttribute('data-analytics-event');

            if (!eventName || typeof window.gtag !== 'function') return;

            window.gtag('event', eventName, {
              event_category: target.getAttribute('data-analytics-category') || 'engagement',
              event_label: target.getAttribute('data-analytics-label') || target.textContent?.trim(),
              link_url: target instanceof HTMLAnchorElement ? target.href : undefined,
            });
          });
        </script>
      </>
    )}
  </head>
  <body class="bg-charcoal text-birch">
    <Navbar />
    <main><slot /></main>
    <Footer />
    {googleAnalyticsId && <CookieConsent locale={currentLang} />}
  </body>
</html>
