---
import "../styles/global.css";
import Footer from "./Footer.astro";
import Navbar from "./Navbar.astro";
const { children } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg" href="src/assets/icons/isologo.svg" />
    <title>Moka Therapeutics</title>
  </head>
  <body class="bg-whitecolor">
    <Navbar />
    <main><slot>{children}</slot></main>
    <Footer />
  </body>
</html>
