---
import "../styles/global.css";
import Footer from "./Footer.astro";
import Navbar from "./Navbar.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  lang?: "en" | "es" | "pt";
}

const {
  title = "Moka Bio — Discovering the bioactive potential of Latin American plants",
  description = "Moka builds LATAM's largest database for bioactivity and natural compounds.",
  ogImage = "/hero.png",
  canonicalUrl,
  lang,
} = Astro.props;

const siteUrl = "https://moka.bio";
const canonical = canonicalUrl ?? `${siteUrl}${Astro.url.pathname}`;
const ogImageAbsolute = ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentLang = lang ?? (path === "/es" || path.startsWith("/es/") ? "es" : path === "/pt" || path.startsWith("/pt/") ? "pt" : "en");
const pathWithoutLocale = path.replace(/^\/(es|pt)(?=\/|$)/, "") || "/";
const localizedPath = (locale: "en" | "es" | "pt") => {
  if (locale === "en") return pathWithoutLocale;
  return pathWithoutLocale === "/" ? `/${locale}` : `/${locale}${pathWithoutLocale}`;
};
---

<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${localizedPath("en")}`} />
    <link rel="alternate" hreflang="es" href={`${siteUrl}${localizedPath("es")}`} />
    <link rel="alternate" hreflang="pt" href={`${siteUrl}${localizedPath("pt")}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${localizedPath("en")}`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/Logo_Moka__Square_White.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:site_name" content="Moka Bio" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- JSON-LD Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Moka Bio",
      "url": siteUrl,
      "logo": `${siteUrl}/Logo_Moka_White.png`,
      "description": description,
      "email": "info@moka.bio",
      "sameAs": ["https://www.linkedin.com/company/mokabio"]
    })} />

    <!-- Google Analytics (centralizado) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-MEXX4CR4HW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-MEXX4CR4HW');
    </script>
    <script is:inline>
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element
          ? event.target.closest('[data-analytics-event]')
          : null;

        const eventName = target?.getAttribute('data-analytics-event');

        if (!eventName || typeof window.gtag !== 'function') return;

        window.gtag('event', eventName, {
          event_category: target.getAttribute('data-analytics-category') || 'engagement',
          event_label: target.getAttribute('data-analytics-label') || target.textContent?.trim(),
          link_url: target instanceof HTMLAnchorElement ? target.href : undefined,
        });
      });
    </script>
  </head>
  <body class="bg-charcoal text-birch">
    <Navbar />
    <main><slot /></main>
    <Footer />
  </body>
</html>
