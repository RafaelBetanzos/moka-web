---
import { Image } from "astro:assets";
import LogoNegative from "../assets/Logo-negative.svg";
import LinkedIn from "../assets/LinkedIn.svg";
---

<div class="relative bg-secondary flex flex-row justify-between items-center">
  <div class="flex flex-row gap-44 ml-10 items-center">
    <div>
      <Image
        src={LogoNegative}
        alt="Logo"
        width={130}
        height={130}
        loading="lazy"
      />
    </div>

    <div
      class="flex flex-col gap-2 text-navbar text-[16px] font-medium text-white mt-8 mb-8 font-roboto"
    >
      <p>Home</p>
      <p>Our Technology</p>
      <p>About Us</p>
      <p>Articles</p>
    </div>
  </div>

  <div
    class="flex flex-col gap-2 text-navbar font-roboto text-white text-[16px] font-medium mr-10"
  >
    <p>Let's get in touch</p>
    <p>info@mokatherapeutics.com</p>
    <Image src={LinkedIn} alt="Linkedin" width={50} loading="lazy" />
  </div>
</div>
