---
import IndustryPage from "@components/IndustryPage.astro";
import { industrySlugs, type IndustrySlug } from "../../data/industries";

export function getStaticPaths() {
  return industrySlugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as IndustrySlug;
---

<IndustryPage slug={slug} locale="en" />
