<script is:inline>
  (() => {
    const page = document.querySelector(".about-page");
    if (!page) return;

    const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value));

    const updateBotanicalScroll = () => {
      const rect = page.getBoundingClientRect();
      const maxScroll = Math.max(1, rect.height - window.innerHeight);
      const progress = clamp(-rect.top / maxScroll);

      page.style.setProperty("--about-scroll", progress.toFixed(4));
      page.style.setProperty("--reveal-a", clamp(progress * 5 + 0.15).toFixed(4));
      page.style.setProperty("--reveal-c", clamp((progress - 0.12) * 4.5).toFixed(4));
      page.style.setProperty("--reveal-center", clamp((progress - 0.22) * 4.2).toFixed(4));
      page.style.setProperty("--reveal-d", clamp((progress - 0.42) * 4).toFixed(4));
      page.style.setProperty("--reveal-e", clamp((progress - 0.58) * 3.8).toFixed(4));
    };

    updateBotanicalScroll();
    window.addEventListener("scroll", updateBotanicalScroll, { passive: true });
    window.addEventListener("resize", updateBotanicalScroll);
  })();
</script>

<style>
  .about-page {
    --about-scroll: 0;
    --reveal-a: 0.15;
    --reveal-c: 0;
    --reveal-center: 0;
    --reveal-d: 0;
    --reveal-e: 0;
  }

  .about-botanical-field {
    opacity: 0.64;
  }

  .about-plant {
    fill: none;
    stroke: rgba(255, 255, 255, 0.3);
    stroke-width: 0.95;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform-box: fill-box;
    transform-origin: center;
    filter:
      drop-shadow(0 0 9px rgba(110, 191, 126, 0.16))
      drop-shadow(0 0 28px rgba(86, 114, 99, 0.12));
  }

  .about-plant path,
  .about-plant circle {
    vector-effect: non-scaling-stroke;
  }

  .about-plant circle {
    fill: none;
  }

  .about-plant-xl {
    stroke-width: 0.75;
    opacity: 0.58;
  }

  .about-plant-lg {
    stroke-width: 0.85;
    opacity: 0.64;
  }

  .about-plant-md {
    stroke-width: 0.95;
    opacity: 0.68;
  }

  .about-constellation {
    fill: none;
    stroke: rgba(110, 191, 126, 0.1);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-dasharray: 3 18;
    filter: drop-shadow(0 0 18px rgba(110, 191, 126, 0.08));
  }

  .about-constellation circle {
    fill: rgba(110, 191, 126, 0.2);
    stroke: none;
  }

  .about-botanical-image {
    opacity: 0;
    mix-blend-mode: screen;
    transform-box: fill-box;
    transform-origin: center;
    filter:
      drop-shadow(0 0 12px rgba(255, 255, 255, 0.08))
      drop-shadow(0 0 28px rgba(110, 191, 126, 0.16));
  }

  .botanical-a {
    animation: botanicalDriftA 18s ease-in-out infinite;
    opacity: calc(var(--reveal-a) * 0.42);
  }

  .botanical-b {
    animation: botanicalCenterDrift 21s ease-in-out infinite;
    opacity: calc(var(--reveal-center) * 0.38);
  }

  .botanical-c {
    animation: botanicalDriftC 19s ease-in-out infinite;
    opacity: calc(var(--reveal-c) * 0.46);
  }

  .botanical-d {
    animation: botanicalDriftB 23s ease-in-out infinite;
    opacity: calc(var(--reveal-d) * 0.38);
  }

  .botanical-e {
    animation: botanicalDriftC 24s ease-in-out infinite;
    opacity: calc(var(--reveal-e) * 0.32);
  }

  @keyframes botanicalDriftA {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-3deg) scale(1); }
    50% { transform: translate3d(18px, -18px, 0) rotate(2deg) scale(1.03); }
  }

  @keyframes botanicalDriftB {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(4deg) scale(1); }
    50% { transform: translate3d(-16px, 20px, 0) rotate(-2deg) scale(1.025); }
  }

  @keyframes botanicalCenterDrift {
    0%, 100% {
      transform: translate3d(0, calc(var(--about-scroll) * 250px), 0) rotate(2deg) scale(1);
    }
    50% {
      transform: translate3d(-10px, calc((var(--about-scroll) * 250px) + 16px), 0) rotate(-2deg) scale(1.02);
    }
  }

  @keyframes botanicalDriftC {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-1deg) scale(1); }
    50% { transform: translate3d(12px, 22px, 0) rotate(4deg) scale(1.02); }
  }

  .float-a { animation: aboutFloatA 12s ease-in-out infinite; }
  .float-b { animation: aboutFloatB 15s ease-in-out infinite; }
  .float-c { animation: aboutFloatC 13s ease-in-out infinite; }
  .float-d { animation: aboutFloatD 16s ease-in-out infinite; }

  @keyframes aboutFloatA {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-4deg); opacity: 0.7; }
    50% { transform: translate3d(18px, -22px, 0) rotate(5deg); opacity: 1; }
  }

  @keyframes aboutFloatB {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(7deg) scale(1); opacity: 0.62; }
    50% { transform: translate3d(-20px, 18px, 0) rotate(-6deg) scale(1.05); opacity: 0.95; }
  }

  @keyframes aboutFloatC {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-2deg); opacity: 0.6; }
    50% { transform: translate3d(12px, 26px, 0) rotate(8deg); opacity: 0.92; }
  }

  @keyframes aboutFloatD {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(4deg) scale(0.98); opacity: 0.58; }
    50% { transform: translate3d(-14px, -18px, 0) rotate(-7deg) scale(1.04); opacity: 0.9; }
  }
</style>
