---
import MapSection from "@components/MapSection.astro";
import OurTeam from "@components/OurTeam.astro";
import OurVisionCard from "@components/OurVisionCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import LeafsLayout from "@layouts/LeafsLayout.astro";
---
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-MEXX4CR4HW"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-MEXX4CR4HW');
</script>

<BaseLayout>
  <div class="min-h-screen">
    <div class="bg-custom-gradient">
      <LeafsLayout>
        <div
          class="mx-auto flex flex-col justify-center items-center py-32 px-8"
        >
          <OurVisionCard isButtonOn={false} />
        </div>
      </LeafsLayout>
    </div>

    <div class="xl:mx-40 lg:mx-16">
      <MapSection />
    </div>
    <OurTeam />
  </div>
</BaseLayout>
