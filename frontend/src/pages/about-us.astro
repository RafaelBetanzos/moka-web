---
import AboutStory from "@components/AboutStory.astro";
import OurTeam from "@components/OurTeam.astro";
import AboutPurpose from "@components/AboutPurpose.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import BotanicalScrollReveal from "@components/BotanicalScrollReveal.astro";
---

<BaseLayout
  breadcrumb="About"
  title="About Moka Bio | Team and Mission"
  description="Meet the Moka Bio team: scientists and entrepreneurs finding and prioritizing bioactivity in understudied Latin American plants."
>
  <div class="about-page min-h-screen bg-charcoal relative overflow-hidden">
    <BotanicalScrollReveal src="/assets/about-botanicals/botanical-line-04.png" tone="strong" class="about-botanical-focus" revealStart={-0.15} />
    <AboutPurpose />

    <AboutStory />


    <OurTeam />
  </div>
</BaseLayout>

<script>
  // Reveal the story paragraphs as they scroll into view.
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const type = entry.target.getAttribute("data-animation");
      if (type) entry.target.classList.add(`animate-${type}`);
      entry.target.classList.remove("opacity-0");
      revealObserver.unobserve(entry.target);
    });
  }, { threshold: 0.1, rootMargin: "0px 0px -50px 0px" });
  document.querySelectorAll(".reveal").forEach((el) => revealObserver.observe(el));
</script>

<style>
  /* ── Page header ─────────────────────────────── */
  .about-kicker {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.48em;
    text-transform: uppercase;
    color: var(--fresh-green-color);
    animation: aboutReveal 1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .about-title {
    font-family: Inter, sans-serif;
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    font-weight: 650;
    line-height: 1;
    color: var(--pure-color);
    text-wrap: balance;
    animation: aboutReveal 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  .about-tagline {
    max-width: 480px;
    font-family: Inter, sans-serif;
    font-size: clamp(1rem, 1.6vw, 1.22rem);
    line-height: 1.7;
    color: rgba(222, 222, 222, 0.62);
    animation: aboutReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.22s both;
  }

  .about-rule {
    width: min(280px, 60%);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(110, 191, 126, 0.38), transparent);
    animation: aboutReveal 1.3s cubic-bezier(0.16, 1, 0.3, 1) 0.34s both;
  }

  @keyframes aboutReveal {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const anim = entry.target.getAttribute('data-animation');
      if (anim === 'slide-up') entry.target.classList.add('animate-slide-up');
      else if (anim === 'fade-in') entry.target.classList.add('animate-fade-in');
      else entry.target.classList.add('animate-slide-up');
      entry.target.classList.remove('opacity-0');
      observer.unobserve(entry.target);
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
