---
import BrainSection from "@components/BrainSection.astro";
import ProblemSection from "@components/ProblemSection.astro";
import SolutionSection from "@components/SolutionSection.astro";
import TargetSection from "@components/TargetSection.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-MEXX4CR4HW"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-MEXX4CR4HW');
</script>

<BaseLayout>
  <div class="flex flex-col items-center justify-between w-full">
    <div
      class="bg-background-brain flex flex-col items-center justify-center py-20 w-full"
    >
      <h1
        class="text-secondary text-4xl sm:text-8xl font-inter font-semibold px-8"
      >
        Our Technology
      </h1>
      <BrainSection />
    </div>

    <ProblemSection />
    <SolutionSection />
    <TargetSection />
  </div>
</BaseLayout>
