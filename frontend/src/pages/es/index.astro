---
import ContactUsCard from "@components/ContactUsCard.astro";
import DataBioactivitySection from "@components/DataBioactivitySection.astro";
import OurVisionSection from "@components/OurVisionSection.astro";
import { ArticlesCarrousel } from "@components/Swiper/ArticlesCarrousel";
import BaseLayout from "@layouts/BaseLayout.astro";
import BotanicalScrollReveal from "@components/BotanicalScrollReveal.astro";
import Hero from "../../components/Hero.astro";
import MarketsSection from "@components/MarketsSection.astro";
import AudienceSection from "@components/AudienceSection.astro";
import ValueSection from "@components/ValueSection.astro";
import WhyWeDoIt from "@components/WhyWeDoIt.astro";

const seo = {
  title: "Bioactividad en plantas latinoamericanas | Moka Bio",
  description: "Encuentra y prioriza bioactividad en plantas latinoamericanas poco estudiadas con la plataforma Moka BDE o servicios de I+D, del extracto a la molécula.",
};

---
<BaseLayout lang="es" title={seo.title} description={seo.description}>
  <div class="home-color-system relative overflow-hidden">
    <Hero locale="es" />

    <AudienceSection locale="es" />

    <BotanicalScrollReveal src="/assets/about-botanicals/botanical-line-02.png" tone="strong" revealStart={0.92} revealRange={0.42} class="home-botanical" />

    <DataBioactivitySection locale="es" />

    <section class="home-what-section relative overflow-hidden">
      <ValueSection locale="es" />

      <!-- ── Moka platform subsection ────────────── -->
      <div class="home-moka-section relative overflow-hidden px-5 py-12 sm:px-8 lg:py-16">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-birch/8 to-transparent"></div>
        <div class="home-section-shell">
          <div class="moka-showcase-layout">
            <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.05s;">
              <div class="home-section-kicker">MOKA BDE · ICAROS</div>
              <h2 class="home-section-title home-section-title--md mt-4">Todo tu descubrimiento, en un solo lugar.</h2>
              <p class="home-section-copy mt-5">
                Moka BDE es donde trabajas. Icaros, todo lo que sabemos de la flora latinoamericana.
              </p>
              <a href="/es/contact-us?interest=demo" class="moka-demo-cta mt-7" data-analytics-event="book_demo_click" data-analytics-category="cta" data-analytics-label="home_bde_showcase">Agendar demo <span aria-hidden="true">→</span></a>
            </div>
            <div class="moka-carousel reveal opacity-0" id="moka-carousel" role="region" aria-roledescription="carousel" aria-label="Moka BDE" data-animation="pop-in" style="transition-delay: 0.15s;">
              <div class="moka-carousel-track" id="moka-carousel-track">
                <div class="moka-slide">
                  <img class="moka-slide-img" src="/mockups/PlatformMockup.svg" alt="" width="1440" height="810" loading="lazy" />
                  <div class="moka-slide-content">
                    <p class="moka-slide-label">Vista general</p>
                    <p class="moka-slide-desc">Un solo entorno para todo tu flujo de descubrimiento, adaptado a tu industria.</p>
                  </div>
                </div>
                <div class="moka-slide">
                  <img class="moka-slide-img" src="/mockups/Explore.svg" alt="" width="1440" height="810" loading="lazy" />
                  <div class="moka-slide-content">
                    <p class="moka-slide-label">Explora Icaros</p>
                    <p class="moka-slide-desc">Especies, compuestos y evidencia en una sola búsqueda.</p>
                  </div>
                </div>
                <div class="moka-slide">
                  <img class="moka-slide-img" src="/mockups/VirtualLab.svg" alt="" width="1440" height="810" loading="lazy" />
                  <div class="moka-slide-content">
                    <p class="moka-slide-label">Laboratorio Virtual</p>
                    <p class="moka-slide-desc">Predice mecanismos y bioactividad sin escribir una línea de código.</p>
                  </div>
                </div>
                <div class="moka-slide">
                  <img class="moka-slide-img" src="/mockups/WetLab.svg" alt="" width="1440" height="810" loading="lazy" />
                  <div class="moka-slide-content">
                    <p class="moka-slide-label">Wet Lab</p>
                    <p class="moka-slide-desc">Tus resultados de laboratorio, conectados con todo lo demás.</p>
                  </div>
                </div>
              </div>
              <div class="moka-progress-bar" aria-hidden="true">
                <div class="moka-progress-fill" id="moka-progress-fill"></div>
              </div>
              <div class="moka-dots">
                <button type="button" class="moka-arrow" data-dir="-1" aria-label="Anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
                <button type="button" aria-current="true" class="moka-dot is-active" data-slide="0" aria-label="Vista general"></button>
                <button type="button" class="moka-dot" data-slide="1" aria-label="Explora Icaros"></button>
                <button type="button" class="moka-dot" data-slide="2" aria-label="Laboratorio Virtual"></button>
                <button type="button" class="moka-dot" data-slide="3" aria-label="Wet Lab"></button>
                <button type="button" class="moka-arrow" data-dir="1" aria-label="Siguiente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="home-traction relative overflow-hidden px-5 py-12 sm:px-8 lg:py-16">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/20 to-transparent"></div>
      <div class="absolute left-1/2 top-0 h-[480px] w-[480px] -translate-x-1/2 rounded-full bg-freshgreen/5 blur-3xl pointer-events-none"></div>
      <div class="home-section-shell">
        <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.05s;">
          <div class="home-section-kicker">TRACCIÓN</div>
          <h2 class="home-section-title home-section-title--md mt-4">Ciencia real.<br class="hidden sm:block"> Progreso real.</h2>
        </div>
        <div class="traction-grid mt-10">

          <article class="traction-card reveal opacity-0" data-animation="pop-in" style="transition-delay: 0.15s;">
            <div class="traction-card-inner">
              <p class="traction-number">30<span class="traction-unit">K+</span></p>
              <div class="traction-divider"></div>
              <p class="traction-label">Especies indexadas</p>
              <p class="traction-desc">Especies indexadas en Icaros: la base de datos de química natural más completa con foco latinoamericano.</p>
            </div>
            <div class="traction-card-glow"></div>
          </article>

          <article class="traction-card reveal opacity-0" data-animation="pop-in" style="transition-delay: 0.27s;">
            <div class="traction-card-inner">
              <p class="traction-number">1<span class="traction-unit"> patente</span></p>
              <div class="traction-divider"></div>
              <p class="traction-label">Patente pendiente</p>
              <p class="traction-desc">Solicitud de patente no provisional presentada para un candidato inmunomodulador identificado mediante el pipeline de descubrimiento de Moka.</p>
            </div>
            <div class="traction-card-glow"></div>
          </article>



        </div>
      </div>
    </section>

    <MarketsSection locale="es" />

    <WhyWeDoIt locale="es" />

    <section class="home-contact-section relative overflow-hidden px-5 py-10 sm:px-8 lg:py-14">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/28 to-transparent"></div>
      <div class="home-section-shell">
        <ContactUsCard locale="es" ctaHref="/es/contact-us/" />
      </div>
    </section>

    <OurVisionSection locale="es" />

    <div class="home-articles-band mt-4 mb-10">
      <div class="home-section-shell mb-8">
        <div class="flex items-end justify-between gap-6 flex-wrap">
          <div>
            <div class="home-section-kicker">DESDE EL CAMPO</div>
            <h2 class="home-section-title mt-3">
              Ciencia que nos impulsa hacia adelante.
            </h2>
          </div>
          <a
            href="/es/insights"
            class="articles-see-all no-underline"
            data-analytics-event="click_view_insights"
            data-analytics-category="navigation"
            data-analytics-label="home_view_all_insights_es"
          >
            Ver todos los insights →
          </a>
        </div>
      </div>
      <ArticlesCarrousel locale="es" client:only="react" />
    </div>

  </div>
</BaseLayout>

<script>
  // ── Consolidated IntersectionObserver for all .reveal elements on home ──
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const animation = entry.target.getAttribute('data-animation');
          if (animation) entry.target.classList.add(`animate-${animation}`);
          entry.target.classList.remove('opacity-0');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));

  // ── Moka carousel ─────────────────────────────────────────────────
  (function () {
    const carousel = document.getElementById('moka-carousel');
    if (!carousel) return;

    const trackEl = document.getElementById('moka-carousel-track');
    if (!trackEl) return;
    const track: HTMLElement = trackEl;
    const fill  = document.getElementById('moka-progress-fill');
    const slides = Array.from(track.querySelectorAll('.moka-slide'));
    const dots   = Array.from(carousel.querySelectorAll('.moka-dot'));

    const DURATION = 7000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    let manual = false; // once the visitor navigates, autoplay stops for good

    function goTo(idx: number, snap = false) {
      const next = ((idx % slides.length) + slides.length) % slides.length;
      if (snap) {
        track.style.transition = 'none';
        track.style.transform = `translateX(-${next * 100}%)`;
        track.offsetWidth;
        track.style.transition = '';
      } else {
        track.style.transform = `translateX(-${next * 100}%)`;
      }
      current = next;
      dots.forEach((d, i) => {
        d.classList.toggle('is-active', i === current);
        i === current ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current');
      });
      if (timer) resetProgress();
    }

    function resetProgress() {
      if (!fill) return;
      fill.style.transition = 'none';
      fill.style.width = '0%';
      fill.offsetWidth;
      fill.style.transition = `width ${DURATION}ms linear`;
      fill.style.width = '100%';
    }

    function startAuto() {
      if (timer || manual || reduceMotion) return;
      timer = setInterval(() => {
        const next = (current + 1) % slides.length;
        goTo(next, next === 0);
      }, DURATION);
      resetProgress();
    }

    function stopAuto() {
      if (timer) clearInterval(timer);
      timer = null;
      if (fill) { fill.style.transition = 'none'; fill.style.width = '0%'; }
    }

    function takeControl(idx: number) {
      manual = true;
      stopAuto();
      goTo(idx);
    }

    dots.forEach((dot, i) => dot.addEventListener('click', () => takeControl(i)));
    carousel.querySelectorAll('.moka-arrow').forEach((btn) => {
      btn.addEventListener('click', () => takeControl(current + Number(btn.getAttribute('data-dir'))));
    });
    carousel.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') takeControl(current + 1);
      if (e.key === 'ArrowLeft') takeControl(current - 1);
    });

    // Pause while the pointer or keyboard focus is inside; resume on leave
    carousel.addEventListener('mouseenter', stopAuto);
    carousel.addEventListener('mouseleave', startAuto);
    carousel.addEventListener('focusin', stopAuto);

    let tx = 0;
    carousel.addEventListener('touchstart', e => { tx = e.touches[0].clientX; }, { passive: true });
    carousel.addEventListener('touchend', e => {
      const dx = e.changedTouches[0].clientX - tx;
      if (Math.abs(dx) > 40) takeControl(dx < 0 ? current + 1 : current - 1);
    });

    new IntersectionObserver(entries => {
      entries.forEach(e => e.isIntersecting ? startAuto() : stopAuto());
    }, { threshold: 0.2 }).observe(carousel);
  })();
</script>

<style>
  /* ── Page-level fixed background ─────────────── */
  .home-color-system {
    position: relative;
    background: transparent;
  }

  .home-color-system > :not(.botanical-scroll-reveal) {
    position: relative;
    z-index: 1;
  }

  .home-color-system::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    background-image: url("/hero.webp");
    background-size: cover;
    background-position: center;
    filter: grayscale(1) contrast(1.24) brightness(0.38);
  }

  /* dark overlay for readability across all sections */
  .home-color-system::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgba(8, 12, 10, 0.52);
  }

  .home-section-shell {
    width: min(100%, 1180px);
    margin: 0 auto;
  }

  .home-section-kicker {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.42em;
    color: var(--fresh-green-color);
    text-transform: uppercase;
  }

  .home-section-title {
    max-width: 820px;
    font-family: Inter, sans-serif;
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    font-weight: 650;
    line-height: 1.02;
    color: var(--pure-color);
    text-wrap: balance;
  }

  /* Secondary sections: one giant title per screen, the rest medium */
  .home-section-title--md {
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    line-height: 1.05;
  }

  .home-section-copy {
    max-width: 620px;
    font-family: Inter, sans-serif;
    font-size: clamp(1rem, 1.6vw, 1.22rem);
    line-height: 1.75;
    color: var(--moka-text-muted);
  }

  .flow-step,
  .why-panel {
    border: 1px solid var(--moka-border-muted);
    background: linear-gradient(145deg, rgba(18, 18, 18, 0.68), rgba(19, 45, 37, 0.46));
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(18px);
  }

  @keyframes archFlow {
    0%   { opacity: 0;    transform: translateY(-4px); }
    30%  { opacity: 0.9;  transform: translateY(0); }
    70%  { opacity: 0.9;  transform: translateY(0); }
    100% { opacity: 0;    transform: translateY(4px); }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes pipelinePulse {
    0%   { left: -100%; }
    100% { left: 100%; }
  }

  @keyframes proofPulse {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50%       { opacity: 1;   transform: scale(1.4); }
  }

  .home-traction {
    background: transparent;
  }

  .traction-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .traction-card {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid rgba(222, 222, 222, 0.10);
    background: linear-gradient(135deg, rgba(19, 45, 37, 0.72), rgba(18, 18, 18, 0.88));
    backdrop-filter: blur(18px);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transition: transform 320ms ease, border-color 320ms ease;
  }

  .traction-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 24% 0%, rgba(255, 255, 255, 0.04), transparent 36%);
    opacity: 0;
    transition: opacity 320ms ease;
    pointer-events: none;
  }

  .traction-card:hover {
    transform: translateY(-4px);
    border-color: rgba(222, 222, 222, 0.20);
  }

  .traction-card:hover::after { opacity: 1; }

  .traction-card-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding: 2rem 1.75rem;
    height: 100%;
  }

  .traction-card-glow { display: none; }

  .traction-number {
    font-family: Inter, sans-serif;
    font-size: clamp(2.8rem, 5vw, 4.6rem);
    font-weight: 750;
    line-height: 1;
    color: var(--fresh-green-color);
    letter-spacing: -0.02em;
  }

  .traction-unit {
    font-size: 0.42em;
    font-weight: 600;
    color: rgba(110, 191, 126, 0.7);
    letter-spacing: 0.04em;
  }

  .traction-divider {
    display: block;
    height: 1px;
    background: rgba(110, 191, 126, 0.14);
    margin: 0.875rem 0;
  }

  .traction-label {
    font-family: Inter, sans-serif;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    font-weight: 700;
    color: var(--pure-color);
    line-height: 1.2;
    margin: 0;
  }

  .traction-desc {
    font-family: Inter, sans-serif;
    font-size: 14px;
    line-height: 1.65;
    color: rgba(222, 222, 222, 0.62);
  }

  .home-contact-section {
    background: transparent;
  }

  .home-articles-band {
    position: relative;
    isolation: isolate;
    padding: 0 1.25rem;
  }

  @media (min-width: 640px) {
    .home-articles-band { padding: 0 2rem; }
  }

  .home-articles-band::before {
    display: none;
  }

  .articles-see-all {
    font-family: Inter, sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: var(--fresh-green-color);
    opacity: 0.8;
    transition: opacity 200ms ease;
    white-space: nowrap;
    margin-bottom: 0.35rem;
  }

  .articles-see-all:hover {
    opacity: 1;
  }

  /* ── Moka showcase section ─────────────────────── */
  .home-moka-section {
    background: transparent;
    position: relative;
    z-index: 1;
  }

  .moka-showcase-layout {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .moka-showcase-layout { align-items: stretch; }

  .moka-carousel {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 1.75rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(18, 18, 18, 0.62);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(22px);
    overflow: hidden;
  }

  .moka-carousel::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at 28% 0%, rgba(110, 191, 126, 0.10), transparent 55%);
    pointer-events: none;
    z-index: 0;
  }

  .moka-carousel-track {
    display: flex;
    flex: 1;
    min-height: 0;
    transition: transform 620ms cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    z-index: 1;
  }

  .moka-slide {
    flex: 0 0 100%;
    min-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding: 2rem 1.75rem 1.5rem;
  }

  .moka-slide-img { display: block; width: 100%; height: auto; pointer-events: none; }

  .moka-slide-content { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; text-align: center; }

  .moka-slide-label {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.30em;
    text-transform: uppercase;
    color: rgba(110, 191, 126, 0.80);
    text-align: center;
  }

  .moka-slide-desc {
    font-family: Inter, sans-serif;
    font-size: 17px;
    line-height: 1.68;
    color: rgba(222, 222, 222, 0.58);
    text-align: center;
    max-width: 340px;
  }

  .moka-progress-bar {
    position: relative;
    z-index: 1;
    height: 2px;
    background: rgba(110, 191, 126, 0.10);
    overflow: hidden;
  }

  .moka-progress-fill {
    height: 100%;
    width: 0%;
    background: var(--fresh-green-color);
    box-shadow: 0 0 8px rgba(110, 191, 126, 0.55);
  }

  .moka-dots {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.6rem 1rem 0.9rem;
  }

  /* 32px hit area around a small visual dot */
  .moka-dot {
    display: inline-flex;
    height: 32px;
    min-width: 32px;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }

  .moka-dot::before {
    content: "";
    height: 7px;
    width: 7px;
    border-radius: 999px;
    background: rgba(222, 222, 222, 0.28);
    transition: background 300ms ease, width 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .moka-dot:hover::before { background: rgba(222, 222, 222, 0.6); }

  .moka-dot.is-active::before {
    width: 24px;
    background: var(--fresh-green-color);
    box-shadow: 0 0 8px rgba(110, 191, 126, 0.45);
  }

  .moka-dot:focus-visible,
  .moka-arrow:focus-visible {
    outline: 2px solid var(--fresh-green-color);
    outline-offset: 2px;
    border-radius: 999px;
  }

  .moka-arrow {
    display: inline-flex;
    height: 36px;
    width: 36px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(222, 222, 222, 0.22);
    background: rgba(18, 18, 18, 0.5);
    color: var(--birch-color);
    cursor: pointer;
    transition: background 200ms ease, color 200ms ease, border-color 200ms ease;
  }

  .moka-arrow:first-child { margin-right: 0.5rem; }
  .moka-arrow:last-child { margin-left: 0.5rem; }

  .moka-arrow:hover {
    background: var(--fresh-green-color);
    border-color: var(--fresh-green-color);
    color: var(--charcoal-color);
  }

  .moka-arrow svg { width: 16px; height: 16px; }

  /* ── Mobile: fix fixed background ───────────────
     On mobile, position:fixed backdrops appear frozen
     while content scrolls. Switch to absolute.     */
  @media (max-width: 767px) {
    .home-color-system::before,
    .home-color-system::after {
      position: absolute;
    }

  }

  @media (max-width: 1023px) {

    .moka-showcase-layout { grid-template-columns: 1fr; gap: 2rem; }
    .traction-grid, .delta-grid {
      grid-template-columns: 1fr;
