---
import { ContactForm } from "@components/ContactForm/ContactForm";
import ContactUsCard from "@components/ContactUsCard.astro";
import DataPlatformSection from "@components/DataPlatformSection.astro";
import OurVisionSection from "@components/OurVisionSection.astro";
import ProblemSection from "@components/ProblemSection.astro";
import SolutionSection from "@components/SolutionSection.astro";
import { ArticlesCarrousel } from "@components/Swiper/ArticlesCarrousel";
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";

const seo = {
  title: "Moka Bio — The OS for Natural Product Discovery",
  description: "Moka turns the world's natural chemical diversity into programmable bioactive intelligence. Accelerating molecular innovation across pharma, nutraceuticals, cosmetics, food, and agriculture.",
};

const industries = [
  {
    name: "Nutraceuticals",
    market: "$620B",
    growth: "+7.5% CAGR",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="8" rx="4"/><line x1="12" y1="8" x2="12" y2="16"/></svg>`,
  },
  {
    name: "Cosmetics",
    market: "$430B",
    growth: "+5.3% CAGR",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C12 2 5 11 5 15a7 7 0 0 0 14 0c0-4-7-13-7-13z"/></svg>`,
  },
  {
    name: "Pharma",
    market: "$1.6T",
    growth: "+6.1% CAGR",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6M10 3v5L6 16a2 2 0 0 0 1.73 3h8.54A2 2 0 0 0 18 16l-4-8V3"/></svg>`,
  },
  {
    name: "Food & Bev",
    market: "$8.9T",
    growth: "+4.8% CAGR",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="22" x2="12" y2="8"/><path d="M8 11a4 4 0 0 1 8 0"/><path d="M8 15a4 4 0 0 1 8 0"/><path d="M8 19a4 4 0 0 1 8 0"/></svg>`,
  },
  {
    name: "Agriculture",
    market: "$2.7T",
    growth: "+4.1% CAGR",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12"/><path d="M12 12C7 12 4 8 4 4c4 0 8 3 8 8z"/><path d="M12 12c5 0 8-4 8-8-4 0-8 3-8 8z"/></svg>`,
  },
];
---
<BaseLayout title={seo.title} description={seo.description}>
  <div class="home-color-system">
    <Hero />


    <DataPlatformSection />

    <section class="home-flow-section relative overflow-hidden px-5 py-20 sm:px-8 lg:py-28">
      <div class="home-section-shell">
        <div class="home-section-kicker">HOW MOKA WORKS</div>
        <div class="grid items-end gap-8 lg:grid-cols-[0.8fr_1.2fr]">
          <h2 class="home-section-title">A living knowledge system for natural discovery.</h2>
          <p class="home-section-copy">
            Moka connects natural knowledge, bioactive potential, and molecular intelligence into a workflow that can support product discovery.
          </p>
        </div>

        <div class="flow-track mt-14 grid gap-5 lg:grid-cols-3">
          <article class="flow-step">
            <span>01</span>
            <h3>Explore natural knowledge</h3>
            <p>Organize botanical and scientific knowledge into a searchable discovery foundation.</p>
          </article>
          <article class="flow-step">
            <span>02</span>
            <h3>Identify bioactive potential</h3>
            <p>Map biological signals, mechanisms, and chemical patterns across natural molecular space.</p>
          </article>
          <article class="flow-step">
            <span>03</span>
            <h3>Transform findings</h3>
            <p>Turn discoveries into usable molecular, product, IP, and regulatory intelligence.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="home-layers-section relative overflow-hidden px-5 py-20 sm:px-8 lg:py-28">
      <div class="absolute left-[-8%] top-8 h-[520px] w-[520px] rounded-full bg-freshgreen/6 blur-3xl"></div>
      <div class="absolute right-[-10%] bottom-0 h-[560px] w-[560px] rounded-full bg-sage/10 blur-3xl"></div>
      <div class="home-section-shell relative">
        <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div>
            <div class="home-section-kicker">PLATFORM LAYERS</div>
            <h2 class="home-section-title mt-4">From botanical complexity to bioactive intelligence.</h2>
            <p class="home-section-copy mt-5">
              The platform acts as a layered system that structures data, AI interpretation, bioactivity, and product-facing intelligence.
            </p>
          </div>

          <div class="layer-stack">
            <div class="layer-card"><span>01</span><p>Botanical and scientific data layer</p></div>
            <div class="layer-card"><span>02</span><p>AI / knowledge graph layer</p></div>
            <div class="layer-card"><span>03</span><p>Bioactivity intelligence layer</p></div>
            <div class="layer-card"><span>04</span><p>Product, IP, and regulatory intelligence layer</p></div>
          </div>
        </div>
      </div>
    </section>

    <section class="plant-to-bioactives relative overflow-hidden px-5 py-20 sm:px-8 lg:py-32">
      <div class="home-section-shell relative">
        <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
          <div class="bioactive-visual" aria-hidden="true">
            <img src="/assets/about-botanicals/botanical-line-02.png" alt="" class="bioactive-plant plant-one" loading="lazy" />
            <img src="/assets/about-botanicals/botanical-line-04.png" alt="" class="bioactive-plant plant-two" loading="lazy" />
            <div class="bioactive-path"></div>
            <div class="bioactive-orb orb-one"></div>
            <div class="bioactive-orb orb-two"></div>
            <div class="bioactive-orb orb-three"></div>
            <div class="bioactive-panel">
              <span>MOLECULAR SIGNAL</span>
              <div></div>
              <div></div>
              <div></div>
            </div>
          </div>
          <div>
            <div class="home-section-kicker">FROM PLANTS TO BIOACTIVES</div>
            <h2 class="home-section-title mt-4">Plant silhouettes, molecular signals, and data nodes become one discovery interface.</h2>
            <p class="home-section-copy mt-5">
              Moka is built around the idea that natural chemistry can be indexed, interpreted, and transformed into actionable bioactive intelligence.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="home-applications relative overflow-hidden px-5 py-20 sm:px-8 lg:py-28">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/18 to-transparent"></div>
      <div class="home-section-shell">
        <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.1s;">
          <div class="home-section-kicker">APPLICATIONS</div>
          <h2 class="home-section-title mt-4">Natural product intelligence<br class="hidden sm:block"> for global industries.</h2>
          <p class="home-section-copy mt-4">Five high-value sectors where programmable bioactive intelligence unlocks measurable opportunity.</p>
        </div>
        <div class="app-grid mt-12">
          {industries.map((ind, i) => (
            <article class="app-card reveal opacity-0" data-animation="pop-in" style={`transition-delay: ${0.2 + i * 0.12}s;`}>
              <div class="app-icon-wrap">
                <Fragment set:html={ind.icon} />
              </div>
              <p class="app-name">{ind.name}</p>
              <div class="app-meta">
                <span class="app-market">{ind.market}</span>
                <span class="app-growth">{ind.growth}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-traction relative overflow-hidden px-5 py-20 sm:px-8 lg:py-28">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/20 to-transparent"></div>
      <div class="absolute left-1/2 top-0 h-[480px] w-[480px] -translate-x-1/2 rounded-full bg-freshgreen/5 blur-3xl pointer-events-none"></div>
      <div class="home-section-shell">
        <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.05s;">
          <div class="home-section-kicker">TRACTION</div>
          <h2 class="home-section-title mt-4">Real science.<br class="hidden sm:block"> Real progress.</h2>
        </div>
        <div class="traction-grid mt-12">

          <article class="traction-card reveal opacity-0" data-animation="pop-in" style="transition-delay: 0.15s;">
            <div class="traction-card-inner">
              <p class="traction-number">130<span class="traction-unit">K+</span></p>
              <div class="traction-divider"></div>
              <p class="traction-label">Species Indexed</p>
              <p class="traction-desc">Natural species catalogued and structured inside MokaDex — the world's largest validated natural chemical library.</p>
            </div>
            <div class="traction-card-glow"></div>
          </article>

          <article class="traction-card reveal opacity-0" data-animation="pop-in" style="transition-delay: 0.27s;">
            <div class="traction-card-inner">
              <p class="traction-number">1<span class="traction-unit"> patent</span></p>
              <div class="traction-divider"></div>
              <p class="traction-label">Provisional Patent Filed</p>
              <p class="traction-desc">An immunomodulator candidate identified and protected through Moka's bioactivity intelligence pipeline. IP-ready from day one.</p>
            </div>
            <div class="traction-card-glow"></div>
          </article>

          <article class="traction-card reveal opacity-0" data-animation="pop-in" style="transition-delay: 0.39s;">
            <div class="traction-card-inner">
              <p class="traction-number">3<span class="traction-unit"> active</span></p>
              <div class="traction-divider"></div>
              <p class="traction-label">Research Partners</p>
              <p class="traction-desc">Collaborating with institutions and industry partners to validate and deploy natural bioactive intelligence at scale.</p>
            </div>
            <div class="traction-card-glow"></div>
          </article>

        </div>
      </div>
    </section>

    <section class="home-delta-section relative overflow-hidden px-5 py-20 sm:px-8 lg:py-28">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/22 to-transparent"></div>
      <div class="absolute left-1/2 top-0 h-[500px] w-[500px] -translate-x-1/2 rounded-full bg-deepforest/18 blur-3xl pointer-events-none"></div>
      <div class="home-section-shell">

        <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.05s;">
          <div class="home-section-kicker">WHY MOKA</div>
          <h2 class="home-section-title mt-4">What changes<br class="hidden sm:block"> with Moka Bio?</h2>
        </div>

        <div class="delta-grid mt-14">

          <!-- COST -->
          <article class="delta-card reveal opacity-0" data-animation="pop-in" style="transition-delay: 0.15s;">
            <div class="delta-before">
              <span class="delta-tag delta-tag--before">BEFORE</span>
              <p class="delta-metric delta-metric--before">$1<span class="delta-metric-unit">M</span></p>
              <p class="delta-sublabel">Per bioactive compound</p>
            </div>
            <div class="delta-bridge">
              <div class="delta-bridge-line"></div>
              <div class="delta-bridge-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
                94% cost reduction
              </div>
              <div class="delta-bridge-line"></div>
            </div>
            <div class="delta-after">
              <span class="delta-tag delta-tag--after">WITH MOKA</span>
              <p class="delta-metric delta-metric--after">$60<span class="delta-metric-unit">K</span></p>
              <p class="delta-sublabel delta-sublabel--after">For as many compounds as you want</p>
            </div>
          </article>

          <!-- SPEED -->
          <article class="delta-card reveal opacity-0" data-animation="pop-in" style="transition-delay: 0.27s;">
            <div class="delta-before">
              <span class="delta-tag delta-tag--before">BEFORE</span>
              <p class="delta-metric delta-metric--before">2–7<span class="delta-metric-unit"> yr</span></p>
              <p class="delta-sublabel">From research to candidate</p>
            </div>
            <div class="delta-bridge">
              <div class="delta-bridge-line"></div>
              <div class="delta-bridge-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
                From years to weeks
              </div>
              <div class="delta-bridge-line"></div>
            </div>
            <div class="delta-after">
              <span class="delta-tag delta-tag--after">WITH MOKA</span>
              <p class="delta-metric delta-metric--after">Weeks</p>
              <p class="delta-sublabel delta-sublabel--after">To your first validated candidates</p>
            </div>
          </article>

          <!-- IP -->
          <article class="delta-card reveal opacity-0" data-animation="pop-in" style="transition-delay: 0.39s;">
            <div class="delta-before">
              <span class="delta-tag delta-tag--before">BEFORE</span>
              <p class="delta-metric delta-metric--before" style="font-size: clamp(1.8rem, 3.5vw, 2.8rem); line-height: 1.1;">No clear path</p>
              <p class="delta-sublabel">Fragmented IP landscape</p>
            </div>
            <div class="delta-bridge">
              <div class="delta-bridge-line"></div>
              <div class="delta-bridge-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
                Full visibility, day one
              </div>
              <div class="delta-bridge-line"></div>
            </div>
            <div class="delta-after">
              <span class="delta-tag delta-tag--after">WITH MOKA</span>
              <p class="delta-metric delta-metric--after" style="font-size: clamp(1.8rem, 3.5vw, 2.8rem); line-height: 1.1;">Patent-ready</p>
              <p class="delta-sublabel delta-sublabel--after">Complete patent landscape mapping included</p>
            </div>
          </article>

        </div>
      </div>
    </section>

    <div class="home-problem-solution relative overflow-hidden py-10">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/20 to-transparent"></div>
      <ProblemSection />
      <SolutionSection />
    </div>
    
    <OurVisionSection />

    <div class="home-articles-band mt-4 mb-10">
      <div class="home-section-shell mb-8">
        <div class="flex items-end justify-between gap-6 flex-wrap">
          <div>
            <div class="home-section-kicker">FROM THE FIELD</div>
            <h2 class="home-section-title mt-3" style="font-size: clamp(1.8rem, 3.5vw, 2.8rem);">
              Science that moves us forward.
            </h2>
          </div>
          <a href="/insights" class="articles-see-all no-underline">
            View all insights →
          </a>
        </div>
      </div>
      <ArticlesCarrousel client:only="react" />
    </div>

    <section class="home-contact-section relative overflow-hidden px-5 py-20 sm:px-8 lg:py-28">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/28 to-transparent"></div>
      <div class="home-section-shell grid gap-12 lg:grid-cols-[0.86fr_1.14fr] lg:items-center">
        <ContactUsCard />
        <div class="contact-form-shell">
          <ContactForm client:only="react" />
        </div>
      </div>
    </section>
    
  </div>
</BaseLayout>

<script>
  // ── Consolidated IntersectionObserver for all .reveal elements on home ──
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const animation = entry.target.getAttribute('data-animation');
          if (animation) entry.target.classList.add(`animate-${animation}`);
          entry.target.classList.remove('opacity-0');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
</script>

<style>
  /* ── Page-level fixed background ─────────────── */
  .home-color-system {
    position: relative;
    background: transparent;
  }

  .home-color-system::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    background-image: url("/hero.png");
    background-size: cover;
    background-position: center;
    filter: grayscale(1) contrast(1.24) brightness(0.38);
  }

  /* dark overlay for readability across all sections */
  .home-color-system::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgba(8, 12, 10, 0.52);
  }

  .home-section-shell {
    width: min(100%, 1180px);
    margin: 0 auto;
  }

  .home-section-kicker {
    font-family: Roboto, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.42em;
    color: var(--fresh-green-color);
    text-transform: uppercase;
  }

  .home-section-title {
    max-width: 820px;
    font-family: Inter, sans-serif;
    font-size: clamp(2.2rem, 5vw, 4.7rem);
    font-weight: 650;
    line-height: 1.02;
    color: var(--pure-color);
    text-wrap: balance;
  }

  .home-section-copy {
    max-width: 620px;
    font-family: Inter, sans-serif;
    font-size: clamp(1rem, 1.6vw, 1.22rem);
    line-height: 1.75;
    color: var(--moka-text-muted);
  }

  .home-flow-section {
    background: transparent;
  }

  .home-proof-motion {
    background: transparent;
  }

  .flow-track {
    position: relative;
  }

  .flow-track::before {
    content: "";
    position: absolute;
    left: 8%;
    right: 8%;
    top: 50%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(110, 191, 126, 0.42), transparent);
    opacity: 0.65;
  }

  .flow-step,
  .layer-card,
  .why-panel,
  .contact-form-shell {
    border: 1px solid var(--moka-border-muted);
    background: linear-gradient(145deg, rgba(18, 18, 18, 0.68), rgba(19, 45, 37, 0.46));
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(18px);
  }

  .flow-step {
    position: relative;
    min-height: 260px;
    border-radius: 1.5rem;
    padding: 2rem;
    transition: transform 320ms ease, border-color 320ms ease, background 320ms ease;
  }

  .flow-step:hover {
    transform: translateY(-4px);
    border-color: var(--moka-border-accent);
    background: linear-gradient(145deg, rgba(19, 45, 37, 0.82), rgba(18, 18, 18, 0.58));
  }

  /* Keep staircase offset intact while lifting on hover */
  .layer-card:hover {
    transform: translateX(calc(var(--offset, 0) * 1rem)) translateY(-4px);
    border-color: var(--moka-border-accent);
    background: linear-gradient(145deg, rgba(19, 45, 37, 0.82), rgba(18, 18, 18, 0.58));
  }

  .flow-step span,
  .layer-card span {
    color: var(--fresh-green-color);
    font-family: Roboto, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.32em;
  }

  .flow-step h3 {
    margin-top: 3rem;
    font-family: Inter, sans-serif;
    font-size: 1.45rem;
    font-weight: 650;
    line-height: 1.14;
    color: var(--pure-color);
  }

  .flow-step p {
    margin-top: 1rem;
    color: rgba(222, 222, 222, 0.72);
    line-height: 1.65;
  }

  .home-layers-section {
    background: transparent;
  }

  .layer-stack {
    display: grid;
    gap: 1rem;
    perspective: 1000px;
  }

  .layer-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: center;
    border-radius: 1.25rem;
    padding: 1.35rem 1.5rem;
    transform: translateX(calc(var(--offset, 0) * 1rem));
    transition: transform 320ms ease, border-color 320ms ease, background 320ms ease;
  }

  .layer-card:nth-child(2) { --offset: 1; }
  .layer-card:nth-child(3) { --offset: 2; }
  .layer-card:nth-child(4) { --offset: 3; }

  .layer-card p {
    color: var(--birch-color);
    font-family: Inter, sans-serif;
    font-size: clamp(1rem, 1.6vw, 1.22rem);
    font-weight: 600;
  }

  .plant-to-bioactives {
    background: transparent;
  }

  .bioactive-visual {
    position: relative;
    min-height: 520px;
    border-radius: 2rem;
    overflow: hidden;
    border: 1px solid rgba(110, 191, 126, 0.18);
    background:
      linear-gradient(135deg, rgba(19, 45, 37, 0.7), rgba(18, 18, 18, 0.72)),
      radial-gradient(circle at 28% 24%, rgba(110, 191, 126, 0.16), transparent 38%);
    box-shadow: 0 30px 100px rgba(0, 0, 0, 0.34), inset 0 0 90px rgba(110, 191, 126, 0.06);
  }

  .bioactive-plant {
    position: absolute;
    width: 300px;
    filter: invert(1);
    opacity: 0.16;
  }

  .plant-one {
    left: 1rem;
    bottom: -2rem;
    animation: slowPlant 18s ease-in-out infinite;
  }

  .plant-two {
    right: -2rem;
    top: -1rem;
    animation: slowPlant 22s ease-in-out infinite reverse;
  }

  .bioactive-path {
    position: absolute;
    inset: 20%;
    border: 1px solid rgba(110, 191, 126, 0.2);
    border-radius: 999px;
    box-shadow: 0 0 60px rgba(110, 191, 126, 0.08);
  }

  .bioactive-orb {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--fresh-green-color);
    box-shadow: 0 0 24px rgba(110, 191, 126, 0.5);
  }

  .orb-one { left: 24%; top: 30%; }
  .orb-two { right: 24%; top: 48%; }
  .orb-three { left: 44%; bottom: 26%; }

  .bioactive-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(70%, 320px);
    transform: translate(-50%, -50%);
    border: 1px solid rgba(222, 222, 222, 0.12);
    border-radius: 1.25rem;
    background: rgba(18, 18, 18, 0.72);
    padding: 1.4rem;
    backdrop-filter: blur(18px);
  }

  .bioactive-panel span {
    color: var(--fresh-green-color);
    font: 700 11px/1 Roboto, sans-serif;
    letter-spacing: 0.3em;
  }

  .bioactive-panel div {
    height: 10px;
    margin-top: 1rem;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(110, 191, 126, 0.7), rgba(222, 222, 222, 0.1));
  }

  .bioactive-panel div:nth-child(3) { width: 74%; }
