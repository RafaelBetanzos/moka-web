---
import AudienceSection from "@components/AudienceSection.astro";
import ContactUsCard from "@components/ContactUsCard.astro";
import DataBioactivitySection from "@components/DataBioactivitySection.astro";
import OurVisionSection from "@components/OurVisionSection.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import BotanicalScrollReveal from "@components/BotanicalScrollReveal.astro";
import Hero from "../components/Hero.astro";
import MarketsSection from "@components/MarketsSection.astro";
import PlantToProduct from "@components/PlantToProduct.astro";
import WhyWeDoIt from "@components/WhyWeDoIt.astro";
import { hasPublicFile } from "../utils/publicAsset";

// Opportunity block photo, supplied later; the block is text-only until the file exists.
const opportunityImage = "/webpics/home-opportunity.jpeg";
const hasOpportunityImage = hasPublicFile(opportunityImage);

const seo = {
  title: "Plant Bioactivity Discovery in Latin America | Moka Bio",
  description: "Find and prioritize bioactivity in understudied Latin American plants with the Moka BDE platform or R&D services, from extract to molecule.",
};

---
<BaseLayout title={seo.title} description={seo.description}>
  <div class="home-color-system relative overflow-hidden">
    <Hero />

    <BotanicalScrollReveal src="/assets/about-botanicals/botanical-line-02.png" tone="strong" revealStart={0.92} revealRange={0.42} class="home-botanical" />

    <WhyWeDoIt showForces={false} />

    <DataBioactivitySection />

    <!-- ── The opportunity: answers the question that closes the previous block ────────────── -->
    <section class="home-moka-section relative overflow-hidden px-5 py-12 sm:px-8 lg:py-16">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-birch/8 to-transparent"></div>
      <div class="home-section-shell">
        <div class:list={["home-opportunity", hasOpportunityImage && "moka-showcase-layout home-opportunity--media"]}>
          {hasOpportunityImage && (
            <div class="home-opportunity-media reveal opacity-0" data-animation="pop-in" style="transition-delay: 0.05s;">
              <img src={opportunityImage} alt="Native plant beside a vial of its extract" width="2400" height="1792" loading="lazy" decoding="async" />
            </div>
          )}
          <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.15s;">
            <h2 class="home-section-title home-section-title--md">The next bioactive may not need to be invented.</h2>
            <p class="home-opportunity-sub mt-4">It may already be growing in Latin America.</p>
            <p class="home-section-copy mt-5">Markets want natural ingredients with evidence behind them, and access and origin rules now reward plants sourced the right way.</p>
            <a href="#pathways" class="moka-demo-cta mt-7" data-analytics-event="click_view_pathways" data-analytics-category="cta" data-analytics-label="home_opportunity">Find yours <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── A novel natural product needs three elements ────────────── -->
    <section id="pathways" class="home-moka-section relative overflow-hidden px-5 py-12 sm:px-8 lg:py-16">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-birch/8 to-transparent"></div>
      <div class="home-section-shell">
        <div class="home-system">
          <div class="home-system-head reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.05s;">
            <h2 class="home-section-title home-section-title--md">A novel natural product needs three elements.</h2>
            <a href="/our-technology/" class="moka-demo-cta mt-7" data-analytics-event="click_view_technology" data-analytics-category="cta" data-analytics-label="home_system">Discover how we do it <span aria-hidden="true">→</span></a>
          </div>
          <div class="home-system-path reveal opacity-0" data-animation="pop-in" style="transition-delay: 0.15s;">
            <PlantToProduct
              fork={[
                { label: "Plant", href: "/our-technology/#plant-push", event: "click_view_technology" },
                { label: "Product", href: "/our-technology/#market-pull", event: "click_view_technology" },
              ]}
              steps={[
                { label: "What it is", hint: "Even in plants without a single previous study.", href: "/our-technology/#predict-bioactivity", event: "click_view_technology" },
                { label: "Proof that it works", hint: "Validated in the lab.", href: "/services/#process", event: "click_view_services" },
                { label: "Where it comes from", hint: "Traceable from its origin.", href: "/our-technology/#traceable-origin", event: "click_view_technology" },
              ]}
              vial="/webpics/greenvial.png"
              analyticsLabel="home_path"
            />
          </div>
        </div>
      </div>
    </section>


    <AudienceSection variant="profiles" />

    <MarketsSection />

    <OurVisionSection />

    <section class="home-contact-section relative overflow-hidden px-5 py-10 sm:px-8 lg:py-14">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/28 to-transparent"></div>
      <div class="home-section-shell">
        <ContactUsCard ctaHref="/contact-us/" />
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  // ── Consolidated IntersectionObserver for all .reveal elements on home ──
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const animation = entry.target.getAttribute('data-animation');
          if (animation) entry.target.classList.add(`animate-${animation}`);
          entry.target.classList.remove('opacity-0');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
</script>

<style>
  /* Pathways anchor clears the sticky navbar */
  :global(#pathways) {
    scroll-margin-top: 5rem;
  }

  /* ── Page-level fixed background ─────────────── */
  .home-color-system {
    position: relative;
    background: transparent;
  }

  .home-color-system > :not(.botanical-scroll-reveal) {
    position: relative;
    z-index: 1;
  }

  /* The hero doesn't form its own layer, so the Latin America block can overlap its
     image while staying below the marquee (see WhyWeDoIt .why-section--rooted). */
  .home-color-system > :global(.hero-xray) {
    z-index: auto;
  }

  .home-color-system::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    background-image: url("/hero.webp");
    background-size: cover;
    background-position: center;
    filter: grayscale(1) contrast(1.24) brightness(0.38);
  }

  /* dark overlay for readability across all sections */
  .home-color-system::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgba(8, 12, 10, 0.52);
  }

  .home-section-shell {
    width: min(100%, 1180px);
    margin: 0 auto;
  }

  .home-section-kicker {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.42em;
    color: var(--fresh-green-color);
    text-transform: uppercase;
  }

  .home-section-title {
    max-width: 820px;
    font-family: Inter, sans-serif;
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    font-weight: 650;
    line-height: 1.02;
    color: var(--pure-color);
    text-wrap: balance;
  }

  /* Secondary sections: one giant title per screen, the rest medium */
  .home-section-title--md {
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    line-height: 1.05;
  }

  .home-section-copy {
    max-width: 620px;
    font-family: Inter, sans-serif;
    font-size: clamp(1rem, 1.6vw, 1.22rem);
    line-height: 1.75;
    color: var(--moka-text-muted);
  }

  .flow-step,
  .why-panel {
    border: 1px solid var(--moka-border-muted);
    background: linear-gradient(145deg, rgba(18, 18, 18, 0.68), rgba(19, 45, 37, 0.46));
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(18px);
  }

  @keyframes archFlow {
    0%   { opacity: 0;    transform: translateY(-4px); }
    30%  { opacity: 0.9;  transform: translateY(0); }
    70%  { opacity: 0.9;  transform: translateY(0); }
    100% { opacity: 0;    transform: translateY(4px); }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes pipelinePulse {
    0%   { left: -100%; }
    100% { left: 100%; }
  }

  @keyframes proofPulse {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50%       { opacity: 1;   transform: scale(1.4); }
  }

  .home-contact-section {
    background: transparent;
  }

  /* ── Moka showcase section ─────────────────────── */
  .home-moka-section {
    background: transparent;
    position: relative;
    z-index: 1;
  }

  .home-system-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .home-system-head :global(.home-section-title) {
    margin-left: auto;
    margin-right: auto;
  }

  /* Centred under the title; on wide screens nudged left so the vial stays clear of the
     botanical drawing on the right edge (the fork on the left is visually lighter). */
  .home-system-path {
    max-width: 900px;
    margin: 3.5rem auto 0;
  }

  @media (min-width: 1280px) {
    /* `left`, not transform: the reveal animation owns the transform. */
    .home-system-path { position: relative; left: -4rem; }
  }

  .home-opportunity-sub {
    font-family: Inter, sans-serif;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--fresh-green-color);
  }

  .home-opportunity--media {
    align-items: center;
  }

  .home-opportunity-media {
    overflow: hidden;
    border-radius: 1.75rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
  }

  .home-opportunity-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .moka-showcase-layout {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 3.5rem;
    align-items: stretch;
  }

  /* ── Mobile: fix fixed background ───────────────
     On mobile, position:fixed backdrops appear frozen
     while content scrolls. Switch to absolute.     */
  @media (max-width: 767px) {
    .home-color-system::before,
    .home-color-system::after {
      position: absolute;
    }

  }

  @media (max-width: 1023px) {

    .moka-showcase-layout { grid-template-columns: 1fr; gap: 2rem; }

  }


  @media (prefers-reduced-motion: reduce) {
    .arch-dot,
    .pipeline-arrow-pulse,
    .pipeline-proof-dot {
      transition: none !important;
    }
  }
</style>
