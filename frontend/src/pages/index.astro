---
import { ContactForm } from "@components/ContactForm/ContactForm";
import ContactUsCard from "@components/ContactUsCard.astro";
import DataPlatformSection from "@components/DataPlatformSection.astro";
import { MarqueeComponent } from "@components/Marquee/MarqueeComponent";
import OurVisionSection from "@components/OurVisionSection.astro";
import { ArticlesCarrousel } from "@components/Swiper/ArticlesCarrousel";
import BaseLayout from "@layouts/BaseLayout.astro";
import LeafsLayout from "@layouts/LeafsLayout.astro";
import Hero from "../components/Hero.astro";
---

<BaseLayout>
  <div class="bg-whitecolor">
    <Hero />
    <DataPlatformSection />
    
    <OurVisionSection />

    <div class="relative -mt-4 py-2 bg-transparent">
      <MarqueeComponent client:only="react" />
    </div>

    <div class="flex flex-col items-center justify-center mt-4 mb-10">
      <ArticlesCarrousel client:only="react" />
    </div>
    
    </div>
</BaseLayout>