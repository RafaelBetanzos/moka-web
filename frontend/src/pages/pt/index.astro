---
import { ContactForm } from "@components/ContactForm/ContactForm";
import ContactUsCard from "@components/ContactUsCard.astro";
import DataBioactivitySection from "@components/DataBioactivitySection.astro";
import OurVisionSection from "@components/OurVisionSection.astro";
import { ArticlesCarrousel } from "@components/Swiper/ArticlesCarrousel";
import BaseLayout from "@layouts/BaseLayout.astro";
import BotanicalScrollReveal from "@components/BotanicalScrollReveal.astro";
import Hero from "../../components/Hero.astro";
import MapSection from "@components/MapSection.astro";

const seo = {
  title: "Moka Bio — Descobrindo o potencial bioativo das plantas latino-americanas",
  description: "Construindo a maior base de dados de bioatividade e compostos naturais da LATAM.",
};

const industries = [
  {
    name: "Nutracêuticos",
    market: "$620B",
    growth: "+7.5% CAGR",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="8" rx="4"/><line x1="12" y1="8" x2="12" y2="16"/></svg>`,
  },
  {
    name: "Cosméticos",
    market: "$430B",
    growth: "+5.3% CAGR",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C12 2 5 11 5 15a7 7 0 0 0 14 0c0-4-7-13-7-13z"/></svg>`,
  },
  {
    name: "Farma",
    market: "$1.6T",
    growth: "+6.1% CAGR",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6M10 3v5L6 16a2 2 0 0 0 1.73 3h8.54A2 2 0 0 0 18 16l-4-8V3"/></svg>`,
  },
  {
    name: "Alimentos e bebidas",
    market: "$8.9T",
    growth: "+4.8% CAGR",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="22" x2="12" y2="8"/><path d="M8 11a4 4 0 0 1 8 0"/><path d="M8 15a4 4 0 0 1 8 0"/><path d="M8 19a4 4 0 0 1 8 0"/></svg>`,
  },
  {
    name: "Agricultura",
    market: "$2.7T",
    growth: "+4.1% CAGR",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12"/><path d="M12 12C7 12 4 8 4 4c4 0 8 3 8 8z"/><path d="M12 12c5 0 8-4 8-8-4 0-8 3-8 8z"/></svg>`,
  },
];
---
<BaseLayout lang="pt" title={seo.title} description={seo.description}>
  <div class="home-color-system relative overflow-hidden">
    <Hero locale="pt" />
    <BotanicalScrollReveal src="/assets/about-botanicals/botanical-line-02.png" tone="strong" revealStart={0.92} revealRange={0.42} class="home-botanical" />

    <DataBioactivitySection locale="pt" />

    <section class="home-what-section relative overflow-hidden">
      <div class="home-flow-section px-5 py-8 sm:px-8 lg:py-10">
        <div class="home-section-shell">
          <div class="mx-auto max-w-4xl text-center">
            <div class="home-section-kicker">O QUE FAZEMOS</div>
            <h2 class="home-section-title mt-4">Construindo a maior base de dados de bioatividade e compostos naturais da LATAM.</h2>
          </div>
        </div>
      </div>

      <MapSection locale="pt" />

      <div class="home-layers-section relative overflow-hidden px-5 py-10 sm:px-8 lg:py-14">
        <div class="absolute left-[-8%] top-8 h-[520px] w-[520px] rounded-full bg-freshgreen/6 blur-3xl"></div>
        <div class="absolute right-[-10%] bottom-0 h-[560px] w-[560px] rounded-full bg-sage/10 blur-3xl"></div>
        <div class="home-section-shell relative">
        <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div>
            <div class="home-section-kicker">MOKADEX</div>
            <h2 class="home-section-title mt-4">Encontrando os sinais bioativos mais fortes nas plantas latino-americanas.</h2>
            <p class="home-section-copy mt-5">
              O MokaDex é nossa ferramenta proprietária que interpreta os dados e os integra em um pipeline repetível, transformando uma base de dados em descoberta molecular acionável.
            </p>
            <a href="/pt/our-technology" class="learn-more-link mt-7 no-underline">Saiba mais</a>
          </div>

          <div class="arch-stack reveal opacity-0" data-animation="fade-up">

            <!-- Layer 01 — raw -->
            <div class="arch-layer arch-layer--04">
              <div class="arch-layer-left">
                <span class="arch-num">01</span>
                <div class="arch-accent arch-accent--04"></div>
              </div>
              <div class="arch-layer-body">
                <div class="arch-layer-head">
                  <svg class="arch-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/><circle cx="12" cy="12" r="3" stroke-width="1.2"/></svg>
                  <p class="arch-name">Dados botânicos e científicos</p>
                  <span class="arch-badge arch-badge--04">DADOS BRUTOS</span>
                </div>
                <p class="arch-desc">Literatura botânica, registros etnobotânicos, referências fitoquímicas e datasets experimentais estruturados para análise com MokaDex.</p>
              </div>
            </div>

            <!-- Connector 01→02 -->
            <div class="arch-connector" aria-hidden="true">
              <div class="arch-connector-line"></div>
              <div class="arch-flow-dots">
                <span class="arch-dot arch-dot--1"></span>
                <span class="arch-dot arch-dot--2"></span>
                <span class="arch-dot arch-dot--3"></span>
              </div>
              <div class="arch-connector-line"></div>
            </div>

            <!-- Layer 02 -->
            <div class="arch-layer arch-layer--03">
              <div class="arch-layer-left">
                <span class="arch-num">02</span>
                <div class="arch-accent arch-accent--03"></div>
              </div>
              <div class="arch-layer-body">
                <div class="arch-layer-head">
                  <svg class="arch-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><circle cx="4" cy="6" r="2"/><circle cx="20" cy="6" r="2"/><circle cx="4" cy="18" r="2"/><circle cx="20" cy="18" r="2"/><line x1="6" y1="7" x2="10" y2="10.5"/><line x1="18" y1="7" x2="14" y2="10.5"/><line x1="6" y1="17" x2="10" y2="13.5"/><line x1="18" y1="17" x2="14" y2="13.5"/></svg>
                  <p class="arch-name">IA / grafo de conhecimento</p>
                  <span class="arch-badge arch-badge--03">INTELIGÊNCIA</span>
                </div>
                <p class="arch-desc">MokaDex conecta espécies, compostos, evidências e sinais biológicos usando raciocínio baseado em grafos.</p>
              </div>
            </div>

            <!-- Connector 02→03 -->
            <div class="arch-connector" aria-hidden="true">
              <div class="arch-connector-line"></div>
              <div class="arch-flow-dots">
                <span class="arch-dot arch-dot--1"></span>
                <span class="arch-dot arch-dot--2"></span>
                <span class="arch-dot arch-dot--3"></span>
              </div>
              <div class="arch-connector-line"></div>
            </div>

            <!-- Layer 03 -->
            <div class="arch-layer arch-layer--02">
              <div class="arch-layer-left">
                <span class="arch-num">03</span>
                <div class="arch-accent arch-accent--02"></div>
              </div>
              <div class="arch-layer-body">
                <div class="arch-layer-head">
                  <svg class="arch-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="8" width="5" height="5" rx="1"/><rect x="17" y="8" width="5" height="5" rx="1"/><rect x="9.5" y="3" width="5" height="5" rx="1"/><rect x="9.5" y="16" width="5" height="5" rx="1"/><line x1="7" y1="10.5" x2="9.5" y2="10.5"/><line x1="14.5" y1="10.5" x2="17" y2="10.5"/><line x1="12" y1="8" x2="12" y2="10.5"/><line x1="12" y1="13.5" x2="12" y2="16"/></svg>
                  <p class="arch-name">Inteligência bioativa</p>
                  <span class="arch-badge arch-badge--02">VALIDADO</span>
                </div>
                <p class="arch-desc">O MokaDex ajuda a priorizar hipóteses de mecanismo, alvos biológicos e sinais de bioatividade para validação posterior.</p>
              </div>
            </div>

            <!-- Connector 03→04 -->
            <div class="arch-connector" aria-hidden="true">
              <div class="arch-connector-line"></div>
              <div class="arch-flow-dots">
                <span class="arch-dot arch-dot--1"></span>
                <span class="arch-dot arch-dot--2"></span>
                <span class="arch-dot arch-dot--3"></span>
              </div>
              <div class="arch-connector-line"></div>
            </div>

            <!-- Layer 04 — market-ready -->
            <div class="arch-layer arch-layer--01">
              <div class="arch-layer-left">
                <span class="arch-num">04</span>
                <div class="arch-accent arch-accent--01"></div>
              </div>
              <div class="arch-layer-body">
                <div class="arch-layer-head">
                  <svg class="arch-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22C12 12 5 8 4 4c4 0 8 4 8 8z"/><path d="M12 22C12 13 19 8 20 4c-4 0-8 4-8 8z"/><line x1="12" y1="12" x2="12" y2="22"/></svg>
                  <p class="arch-name">Produto, PI e regulatório</p>
                  <span class="arch-badge arch-badge--01">PRONTO PARA O MERCADO</span>
                </div>
                <p class="arch-desc">Os resultados do MokaDex podem apoiar direção de produto, avaliação de PI, revisão regulatória e decisões de formulação.</p>
              </div>
            </div>

          </div>
        </div>
      </div>
      </div>
    </section>

    <section class="home-applications relative overflow-hidden px-5 py-8 sm:px-8 lg:py-10">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/18 to-transparent"></div>
      <div class="home-section-shell">
        <div class="reveal opacity-0 mx-auto max-w-4xl text-center" data-animation="slide-in" style="transition-delay: 0.1s;">
          <div class="home-section-kicker">PARA QUEM É</div>
          <h2 class="home-section-title mt-4">Para empresas inovadoras<br class="hidden sm:block"> que constroem com a natureza.</h2>
          <p class="home-section-copy mt-4 mx-auto">Cinco setores de alto valor onde a inteligência bioativa programável abre oportunidades mensuráveis.</p>
        </div>
        <div class="app-grid mt-8">
          {industries.map((ind, i) => (
            <article class="app-card reveal opacity-0" data-animation="pop-in" style={`transition-delay: ${0.2 + i * 0.12}s;`}>
              <div class="app-icon-wrap">
                <Fragment set:html={ind.icon} />
              </div>
              <p class="app-name">{ind.name}</p>
              <div class="app-meta">
                <span class="app-market">{ind.market}</span>
                <span class="app-growth">{ind.growth}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-traction relative overflow-hidden px-5 py-12 sm:px-8 lg:py-16">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/20 to-transparent"></div>
      <div class="absolute left-1/2 top-0 h-[480px] w-[480px] -translate-x-1/2 rounded-full bg-freshgreen/5 blur-3xl pointer-events-none"></div>
      <div class="home-section-shell">
        <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.05s;">
          <div class="home-section-kicker">TRAÇÃO</div>
          <h2 class="home-section-title mt-4">Ciência real.<br class="hidden sm:block"> Progresso real.</h2>
        </div>
        <div class="traction-grid mt-10">

          <article class="traction-card reveal opacity-0" data-animation="pop-in" style="transition-delay: 0.15s;">
            <div class="traction-card-inner">
              <p class="traction-number">30<span class="traction-unit">K+</span></p>
              <div class="traction-divider"></div>
              <p class="traction-label">Espécies indexadas</p>
              <p class="traction-desc">Espécies indexadas no MokaDex: a base de dados de química natural mais completa com foco latino-americano.</p>
            </div>
            <div class="traction-card-glow"></div>
          </article>

          <article class="traction-card reveal opacity-0" data-animation="pop-in" style="transition-delay: 0.27s;">
            <div class="traction-card-inner">
              <p class="traction-number">1<span class="traction-unit"> patent</span></p>
              <div class="traction-divider"></div>
              <p class="traction-label">Patente provisória depositada</p>
              <p class="traction-desc">Patente provisória depositada: um candidato imunomodulador identificado e protegido pelo pipeline de descoberta da Moka.</p>
            </div>
            <div class="traction-card-glow"></div>
          </article>

          <article class="traction-card reveal opacity-0" data-animation="pop-in" style="transition-delay: 0.39s;">
            <div class="traction-card-inner">
              <p class="traction-number">3<span class="traction-unit"> active</span></p>
              <div class="traction-divider"></div>
              <p class="traction-label">Parceiros de pesquisa</p>
              <p class="traction-desc">Parceiros de pesquisa ativos: colaborando com instituições e indústria para validar inteligência bioativa em escala.</p>
            </div>
            <div class="traction-card-glow"></div>
          </article>

        </div>
      </div>
    </section>

    <OurVisionSection locale="pt" />

    <div class="home-articles-band mt-4 mb-10">
      <div class="home-section-shell mb-8">
        <div class="flex items-end justify-between gap-6 flex-wrap">
          <div>
            <div class="home-section-kicker">DO CAMPO</div>
            <h2 class="home-section-title mt-3" style="font-size: clamp(1.8rem, 3.5vw, 2.8rem);">
              Ciência que nos impulsiona.
            </h2>
          </div>
          <a href="/insights" class="articles-see-all no-underline">
            Ver todos os insights →
          </a>
        </div>
      </div>
      <ArticlesCarrousel client:only="react" />
    </div>

    <section class="home-contact-section relative overflow-hidden px-5 py-10 sm:px-8 lg:py-14">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/28 to-transparent"></div>
      <div class="home-section-shell grid gap-12 lg:grid-cols-[0.86fr_1.14fr] lg:items-center">
        <ContactUsCard locale="pt" />
        <div class="contact-form-shell">
          <ContactForm locale="pt" client:only="react" />
        </div>
      </div>
    </section>
    
  </div>
</BaseLayout>

<script>
  // ── Consolidated IntersectionObserver for all .reveal elements on home ──
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const animation = entry.target.getAttribute('data-animation');
          if (animation) entry.target.classList.add(`animate-${animation}`);
          entry.target.classList.remove('opacity-0');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
</script>

<style>
  /* ── Page-level fixed background ─────────────── */
  .home-color-system {
    position: relative;
    background: transparent;
  }

  .home-color-system > :not(.botanical-scroll-reveal) {
    position: relative;
    z-index: 1;
  }

  .home-color-system::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    background-image: url("/hero.png");
    background-size: cover;
    background-position: center;
    filter: grayscale(1) contrast(1.24) brightness(0.38);
  }

  /* dark overlay for readability across all sections */
  .home-color-system::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgba(8, 12, 10, 0.52);
  }

  .home-section-shell {
    width: min(100%, 1180px);
    margin: 0 auto;
  }

  .home-section-kicker {
    font-family: Roboto, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.42em;
    color: var(--fresh-green-color);
    text-transform: uppercase;
  }

  .home-section-title {
    max-width: 820px;
    font-family: Inter, sans-serif;
    font-size: clamp(2.2rem, 5vw, 4.7rem);
    font-weight: 650;
    line-height: 1.02;
    color: var(--pure-color);
    text-wrap: balance;
  }

  .home-section-copy {
    max-width: 620px;
    font-family: Inter, sans-serif;
    font-size: clamp(1rem, 1.6vw, 1.22rem);
    line-height: 1.75;
    color: var(--moka-text-muted);
  }

  .learn-more-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(110, 191, 126, 0.28);
    background: rgba(19, 45, 37, 0.36);
    padding: 0.8rem 1.15rem;
    font-family: Inter, sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--fresh-green-color);
    transition: transform 260ms ease, background 260ms ease, color 260ms ease;
  }

  .learn-more-link:hover {
    transform: translateY(-2px);
    background: var(--fresh-green-color);
    color: var(--charcoal-color);
  }

  .home-flow-section {
    background: transparent;
  }


  .home-proof-motion {
    background: transparent;
  }

  .flow-track {
    position: relative;
  }

  .flow-track::before {
    content: "";
    position: absolute;
    left: 8%;
    right: 8%;
    top: 50%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(110, 191, 126, 0.42), transparent);
    opacity: 0.65;
  }

  .flow-step,
  .why-panel,
  .contact-form-shell {
    border: 1px solid var(--moka-border-muted);
    background: linear-gradient(145deg, rgba(18, 18, 18, 0.68), rgba(19, 45, 37, 0.46));
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(18px);
  }

  .flow-step {
    position: relative;
    min-height: 260px;
    border-radius: 1.5rem;
    padding: 2rem;
    transition: transform 320ms ease, border-color 320ms ease, background 320ms ease;
  }

  .flow-step:hover {
    transform: translateY(-4px);
    border-color: var(--moka-border-accent);
    background: linear-gradient(145deg, rgba(19, 45, 37, 0.82), rgba(18, 18, 18, 0.58));
  }

  .flow-step span {
    color: var(--fresh-green-color);
    font-family: Roboto, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.32em;
  }

  .flow-step h3 {
    margin-top: 3rem;
    font-family: Inter, sans-serif;
    font-size: 1.45rem;
    font-weight: 650;
    line-height: 1.14;
    color: var(--pure-color);
  }

  .flow-step p {
    margin-top: 1rem;
    color: rgba(222, 222, 222, 0.72);
    line-height: 1.65;
  }

  .home-layers-section {
    background: transparent;
  }

  /* ── Architecture Stack ──────────────────────── */
  .arch-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Individual layer card */
  .arch-layer {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0;
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid rgba(110, 191, 126, 0.10);
    transition: transform 300ms ease, border-color 300ms ease, box-shadow 300ms ease;
    cursor: default;
  }

  .arch-layer:hover {
    transform: translateX(6px);
    border-color: rgba(110, 191, 126, 0.28);
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.28), 0 0 32px rgba(110, 191, 126, 0.07);
  }

  /* Left rail with number + accent bar */
  .arch-layer-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.25rem 0 1.25rem;
    gap: 0.6rem;
    background: rgba(12, 12, 12, 0.6);
  }

  .arch-num {
    font-family: Roboto, sans-serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: rgba(110, 191, 126, 0.50);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .arch-accent {
    flex: 1;
    width: 2px;
    border-radius: 999px;
    min-height: 20px;
  }

  /* Layer body */
  .arch-layer-body {
    padding: 1.1rem 1.4rem;
  }

  .arch-layer-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .arch-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--fresh-green-color);
    opacity: 0.82;
    transition: opacity 280ms ease, transform 280ms ease;
  }

  .arch-layer:hover .arch-icon {
    opacity: 1;
    transform: scale(1.15);
  }

  .arch-name {
    font-family: Inter, sans-serif;
    font-size: clamp(0.85rem, 1.3vw, 1rem);
    font-weight: 650;
    color: var(--pure-color);
    flex: 1;
  }

  .arch-badge {
    font-family: Roboto, sans-serif;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
  }

  .arch-desc {
    font-family: Inter, sans-serif;
    font-size: 13px;
    line-height: 1.6;
    color: rgba(222, 222, 222, 0.52);
    transition: color 280ms ease;
  }

  .arch-layer:hover .arch-desc {
    color: rgba(222, 222, 222, 0.72);
  }

  /* Layer-specific theming — darkest (raw) to brightest (refined) */
  .arch-layer--01 {
