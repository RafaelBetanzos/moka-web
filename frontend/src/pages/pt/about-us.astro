---
import OurTeam from "@components/OurTeam.astro";
import OurVisionCard from "@components/OurVisionCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import BotanicalScrollReveal from "@components/BotanicalScrollReveal.astro";
---

<BaseLayout
  lang="pt"
  title="Sobre nós | Moka Bio"
  description="Conheça a equipe da Moka Bio. Construímos a base de dados líder de bioatividade da LATAM para plantas latino-americanas."
>
  <div class="about-page min-h-screen bg-charcoal relative overflow-hidden">
    <BotanicalScrollReveal src="/assets/about-botanicals/botanical-line-04.png" tone="strong" class="about-botanical-focus" revealStart={-0.15} />
    <!-- Page header -->
    <div class="relative z-10 flex flex-col items-center text-center px-6 sm:px-8 pt-20 pb-16">
      <p class="about-kicker">MOKA BIO</p>
      <h1 class="about-title mt-5">Sobre nós</h1>
      <p class="about-tagline mt-5">
        Construindo a base de dados de bioatividade<br class="hidden sm:block"> para plantas latino-americanas.
      </p>
      <div class="about-rule mt-6" aria-hidden="true"></div>
    </div>

    <div class="relative z-10 overflow-hidden bg-transparent">
      <div class="absolute left-1/2 top-0 h-[520px] w-[520px] -translate-x-1/2 rounded-full bg-deepforest/35 blur-3xl"></div>
      <div class="mx-auto flex flex-col justify-center items-center py-16 px-5 sm:px-8">
        <OurVisionCard isButtonOn={false} locale="pt" />
      </div>
    </div>

    <OurTeam locale="pt" />
  </div>
</BaseLayout>

<style>
  /* ── Page header ─────────────────────────────── */
  .about-kicker {
    font-family: Roboto, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.48em;
    text-transform: uppercase;
    color: var(--fresh-green-color);
    animation: aboutReveal 1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .about-title {
    font-family: Inter, sans-serif;
    font-size: clamp(2.8rem, 9vw, 7rem);
    font-weight: 650;
    line-height: 1;
    color: var(--pure-color);
    text-wrap: balance;
    animation: aboutReveal 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  .about-tagline {
    max-width: 480px;
    font-family: Inter, sans-serif;
    font-size: clamp(1rem, 1.6vw, 1.22rem);
    line-height: 1.7;
    color: rgba(222, 222, 222, 0.62);
    animation: aboutReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.22s both;
  }

  .about-rule {
    width: min(280px, 60%);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(110, 191, 126, 0.38), transparent);
    animation: aboutReveal 1.3s cubic-bezier(0.16, 1, 0.3, 1) 0.34s both;
  }

  @keyframes aboutReveal {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const anim = entry.target.getAttribute('data-animation');
      if (anim === 'slide-up') entry.target.classList.add('animate-slide-up');
      else if (anim === 'fade-in') entry.target.classList.add('animate-fade-in');
      else entry.target.classList.add('animate-slide-up');
      entry.target.classList.remove('opacity-0');
      observer.unobserve(entry.target);
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
