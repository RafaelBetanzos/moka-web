---
import BrainSection from "@components/BrainSection.astro";
import ProblemSection from "@components/ProblemSection.astro";
import SolutionSection from "@components/SolutionSection.astro";
import TargetSection from "@components/TargetSection.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  lang="pt"
  title="Nossa tecnologia | Moka Bio"
  description="Explore a plataforma Moka: da complexidade botânica à inteligência molecular programável."
>
  <div class="tech-page relative flex flex-col items-center justify-between w-full bg-charcoal overflow-hidden">
    <div class="tech-biofield pointer-events-none fixed inset-0 z-0" aria-hidden="true">
      <svg class="h-full w-full" viewBox="0 0 1440 2200" preserveAspectRatio="xMidYMid slice">
        <defs>
          <filter id="softGlow">
            <feGaussianBlur stdDeviation="5" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
          <symbol id="plant-node" viewBox="-18 -18 36 36">
            <path d="M0 13 C-12 6 -13 -8 0 -15 C13 -8 12 6 0 13Z" />
            <path d="M0 12 C0 4 0 -5 0 -14" />
            <path d="M0 2 C-5 -2 -9 -4 -13 -5" />
            <path d="M0 4 C5 0 9 -2 13 -3" />
          </symbol>
        </defs>
        <g class="tech-graph">
          <path class="tech-path trunk" pathLength="1" d="M720 120 C650 265 790 350 720 500 C650 650 790 785 718 945 C642 1128 800 1270 708 1460 C640 1605 770 1760 690 1910 C640 2025 625 2110 580 2240" />
          <g class="generation generation-1">
            <path class="tech-path branch" pathLength="1" d="M720 120 C575 130 450 175 330 270 M720 120 C890 130 1015 178 1140 285 M720 500 C545 485 410 560 255 690 M720 500 C910 475 1065 580 1220 710" />
          </g>
          <g class="generation generation-2">
            <path class="tech-path branch" pathLength="1" d="M330 270 C260 250 200 285 145 355 M330 270 C420 235 500 260 575 330 M1140 285 C1220 250 1290 285 1345 365 M1140 285 C1050 245 970 270 890 345 M255 690 C170 670 110 725 70 810 M255 690 C345 640 430 660 520 745 M1220 710 C1310 690 1370 745 1415 830 M1220 710 C1135 650 1048 665 955 748" />
          </g>
          <g class="generation generation-3">
            <path class="tech-path branch" pathLength="1" d="M718 945 C565 890 405 970 255 1090 M718 945 C875 880 1055 980 1210 1110 M708 1460 C520 1420 390 1535 230 1640 M708 1460 C875 1412 1060 1535 1240 1665" />
            <path class="tech-path twig" pathLength="1" d="M255 1090 C165 1055 110 1125 75 1210 M255 1090 C350 1040 430 1070 505 1155 M1210 1110 C1305 1080 1370 1145 1415 1228 M1210 1110 C1115 1050 1035 1080 950 1160 M230 1640 C145 1610 95 1685 55 1775 M230 1640 C335 1590 420 1628 505 1710 M1240 1665 C1330 1635 1390 1700 1430 1785 M1240 1665 C1145 1610 1060 1640 970 1725" />
          </g>
          <g class="generation generation-4">
            <path class="tech-path branch" pathLength="1" d="M690 1910 C540 1865 410 1950 315 2070 M690 1910 C860 1860 1010 1970 1135 2110 M580 2240 C490 2160 390 2180 300 2260 M580 2240 C690 2168 790 2195 900 2265" />
            <path class="tech-path twig" pathLength="1" d="M315 2070 C240 2035 180 2075 130 2145 M315 2070 C400 2035 470 2072 540 2140 M1135 2110 C1225 2075 1290 2125 1360 2190 M1135 2110 C1045 2060 980 2105 910 2175" />
          </g>
        </g>
        <g class="tech-leaf-nodes generation-0" filter="url(#softGlow)">
          <use href="#plant-node" x="720" y="120" width="34" height="34" />
        </g>
        <g class="tech-leaf-nodes generation-1" filter="url(#softGlow)">
          <use href="#plant-node" x="330" y="270" width="24" height="24" />
          <use href="#plant-node" x="1140" y="285" width="24" height="24" />
          <use href="#plant-node" x="720" y="500" width="30" height="30" />
          <use href="#plant-node" x="255" y="690" width="24" height="24" />
          <use href="#plant-node" x="1220" y="710" width="24" height="24" />
        </g>
        <g class="tech-leaf-nodes generation-2" filter="url(#softGlow)">
          <use href="#plant-node" x="145" y="355" width="18" height="18" />
          <use href="#plant-node" x="575" y="330" width="18" height="18" />
          <use href="#plant-node" x="1345" y="365" width="18" height="18" />
          <use href="#plant-node" x="890" y="345" width="18" height="18" />
          <use href="#plant-node" x="70" y="810" width="18" height="18" />
          <use href="#plant-node" x="520" y="745" width="18" height="18" />
          <use href="#plant-node" x="1415" y="830" width="18" height="18" />
          <use href="#plant-node" x="955" y="748" width="18" height="18" />
          <use href="#plant-node" x="718" y="945" width="32" height="32" />
        </g>
        <g class="tech-leaf-nodes generation-3" filter="url(#softGlow)">
          <use href="#plant-node" x="255" y="1090" width="22" height="22" />
          <use href="#plant-node" x="1210" y="1110" width="22" height="22" />
          <use href="#plant-node" x="708" y="1460" width="32" height="32" />
          <use href="#plant-node" x="230" y="1640" width="22" height="22" />
          <use href="#plant-node" x="1240" y="1665" width="22" height="22" />
          <use href="#plant-node" x="75" y="1210" width="16" height="16" />
          <use href="#plant-node" x="505" y="1155" width="16" height="16" />
          <use href="#plant-node" x="1415" y="1228" width="16" height="16" />
          <use href="#plant-node" x="950" y="1160" width="16" height="16" />
        </g>
        <g class="tech-leaf-nodes generation-4" filter="url(#softGlow)">
          <use href="#plant-node" x="690" y="1910" width="30" height="30" />
          <use href="#plant-node" x="315" y="2070" width="22" height="22" />
          <use href="#plant-node" x="1135" y="2110" width="22" height="22" />
          <use href="#plant-node" x="300" y="2260" width="18" height="18" />
          <use href="#plant-node" x="900" y="2265" width="18" height="18" />
          <use href="#plant-node" x="130" y="2145" width="16" height="16" />
          <use href="#plant-node" x="540" y="2140" width="16" height="16" />
          <use href="#plant-node" x="1360" y="2190" width="16" height="16" />
          <use href="#plant-node" x="910" y="2175" width="16" height="16" />
        </g>
      </svg>
    </div>
    <div
      class="relative z-10 overflow-hidden bg-transparent flex flex-col items-center justify-center py-20 w-full"
    >
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/40 to-transparent"></div>
      <div class="absolute left-1/2 top-24 h-[520px] w-[520px] -translate-x-1/2 rounded-full bg-deepforest/35 blur-3xl"></div>
      <div class="tech-silhouette-layer pointer-events-none absolute inset-0 z-[5] overflow-hidden" aria-hidden="true">
        <div class="absolute left-3 top-24 hidden h-[78%] w-[30%] md:block">
          <svg class="tech-silhouette float-a absolute left-[8%] top-[4%] w-20 lg:w-24" viewBox="0 0 80 80">
            <path d="M34 10h12M38 10v18L22 56c-4 7 1 14 9 14h18c8 0 13-7 9-14L42 28V10" />
            <path d="M29 50h22M31 58h18" />
          </svg>
          <svg class="tech-silhouette float-b absolute left-[44%] top-[22%] w-16 lg:w-20" viewBox="0 0 80 80">
            <path d="M20 66h42M28 66V54h26v12M32 54l8-18 8 18" />
            <path d="M28 24h24M34 24v12M46 24v12M25 18h30" />
            <circle cx="40" cy="18" r="5" />
          </svg>
          <svg class="tech-silhouette float-c absolute left-[16%] top-[48%] w-16 lg:w-20" viewBox="0 0 80 80">
            <path d="M28 14h24M34 14v18L22 58c-3 7 2 12 9 12h18c7 0 12-5 9-12L46 32V14" />
            <path d="M30 50c7-4 13 4 20 0" />
          </svg>
          <svg class="tech-silhouette float-d absolute left-[58%] top-[68%] w-14 lg:w-16" viewBox="0 0 80 80">
            <path d="M26 12h28M32 12v42a14 14 0 0 0 28 0V12" />
            <path d="M32 44h28M32 54h28" />
          </svg>
        </div>

        <div class="absolute right-3 top-24 hidden h-[78%] w-[30%] md:block">
          <svg class="tech-silhouette float-c absolute right-[10%] top-[6%] w-20 lg:w-24" viewBox="0 0 80 80">
            <rect x="22" y="22" width="36" height="36" rx="6" />
            <path d="M30 12v10M40 12v10M50 12v10M30 58v10M40 58v10M50 58v10M12 30h10M12 40h10M12 50h10M58 30h10M58 40h10M58 50h10" />
            <path d="M32 48V33l8 15 8-15v15" />
          </svg>
          <svg class="tech-silhouette float-a absolute right-[48%] top-[28%] w-16 lg:w-20" viewBox="0 0 80 80">
            <circle cx="20" cy="40" r="5" />
            <circle cx="40" cy="22" r="5" />
            <circle cx="40" cy="58" r="5" />
            <circle cx="60" cy="40" r="5" />
            <path d="M25 38l10-12M25 42l10 12M45 24l10 12M45 56l10-12M40 27v26" />
          </svg>
          <svg class="tech-silhouette float-d absolute right-[18%] top-[52%] w-16 lg:w-20" viewBox="0 0 80 80">
            <path d="M16 58h48M22 58V24h36v34" />
            <path d="M30 48V36M40 48V28M50 48V40" />
            <path d="M28 24l8-10h8l8 10" />
          </svg>
          <svg class="tech-silhouette float-b absolute right-[60%] top-[72%] w-14 lg:w-16" viewBox="0 0 80 80">
            <path d="M18 54c14-22 30-22 44 0" />
            <path d="M22 46c8-10 16-16 28-16M30 58c8-9 18-13 30-10" />
            <circle cx="24" cy="46" r="4" />
            <circle cx="50" cy="30" r="4" />
            <circle cx="60" cy="48" r="4" />
          </svg>
        </div>
      </div>
      <div class="relative z-10 flex flex-col items-center text-center px-6 sm:px-8 gap-5">
        <p class="tech-page-kicker">
          PLATAFORMA MOKA
        </p>
        <h1 class="tech-page-title">
          Nossa tecnologia
        </h1>
        <p class="tech-page-tagline">
          Da complexidade botânica à inteligência molecular programável.
        </p>
        <div class="tech-page-rule" aria-hidden="true"></div>
      </div>
      <BrainSection locale="pt" />
    </div>

    <ProblemSection locale="pt" />

    <div class="answer-bridge" aria-hidden="true">
      <div class="answer-bridge-line"></div>
      <div class="answer-bridge-pill">NOSSA RESPOSTA</div>
      <div class="answer-bridge-line"></div>
    </div>

    <SolutionSection locale="pt" />
    <TargetSection locale="pt" />
  </div>
</BaseLayout>

<script>
  const techPage = document.querySelector('.tech-page') as HTMLElement | null;

  const updateTechProgress = () => {
    if (!techPage) return;
    const rect = techPage.getBoundingClientRect();
    const scrollable = rect.height - window.innerHeight;
    const progress = scrollable <= 0 ? 1 : Math.min(1, Math.max(0, -rect.top / scrollable));
    techPage.style.setProperty('--tech-progress', progress.toString());
    techPage.style.setProperty('--branch-1', Math.min(1, progress / 0.18).toString());
    techPage.style.setProperty('--branch-2', Math.min(1, Math.max(0, (progress - 0.14) / 0.22)).toString());
    techPage.style.setProperty('--branch-3', Math.min(1, Math.max(0, (progress - 0.34) / 0.28)).toString());
    techPage.style.setProperty('--branch-4', Math.min(1, Math.max(0, (progress - 0.58) / 0.34)).toString());
  };

  updateTechProgress();
  window.addEventListener('scroll', updateTechProgress, { passive: true });
  window.addEventListener('resize', updateTechProgress);

  // ── Consolidated IntersectionObserver for all .reveal elements ──
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const animation = entry.target.getAttribute('data-animation');
          if (animation) entry.target.classList.add(`animate-${animation}`);
          entry.target.classList.remove('opacity-0');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
</script>

<style>
  /* ── Page Header ─────────────────────────────── */
  .tech-page-kicker {
    font-family: Roboto, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.48em;
    text-transform: uppercase;
    color: var(--fresh-green-color);
    animation: mokaReveal 1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .tech-page-title {
    font-family: Inter, sans-serif;
    font-size: clamp(2.8rem, 9vw, 7rem);
    font-weight: 650;
    line-height: 1;
    color: var(--pure-color);
    text-wrap: balance;
    animation: mokaReveal 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  .tech-page-tagline {
    max-width: 540px;
    font-family: Inter, sans-serif;
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    line-height: 1.7;
    color: rgba(222, 222, 222, 0.62);
    text-wrap: balance;
    animation: mokaReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.22s both;
  }

  .tech-page-rule {
    width: min(280px, 60%);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(110, 191, 126, 0.38), transparent);
    margin-top: 0.5rem;
    animation: mokaReveal 1.3s cubic-bezier(0.16, 1, 0.3, 1) 0.34s both;
  }

  @keyframes mokaReveal {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-page-kicker,
    .tech-page-title,
    .tech-page-tagline,
    .tech-page-rule {
      animation-duration: 1ms;
    }
  }

  /* ── Problem → Solution bridge ──────────────── */
  .answer-bridge {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 2rem;
    max-width: 480px;
    margin: 0 auto;
  }

  .answer-bridge-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(110, 191, 126, 0.30));
  }

  .answer-bridge-line:last-child {
    background: linear-gradient(90deg, rgba(110, 191, 126, 0.30), transparent);
  }

  .answer-bridge-pill {
    flex-shrink: 0;
    padding: 0.35rem 1.1rem;
    border: 1px solid rgba(110, 191, 126, 0.30);
    border-radius: 999px;
    font-family: Roboto, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: rgba(110, 191, 126, 0.70);
    background: rgba(19, 45, 37, 0.40);
    backdrop-filter: blur(8px);
  }

  /* ── Existing styles ─────────────────────────── */
  .tech-biofield {
    opacity: 0.42;
  }

  .tech-page {
    isolation: isolate;
    background: var(--charcoal-color);
  }

  .tech-page::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(rgba(222, 222, 222, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(222, 222, 222, 0.014) 1px, transparent 1px);
    background-size: 88px 88px;
    mask-image: radial-gradient(circle at 62% 28%, black, transparent 68%);
    opacity: 0.26;
    pointer-events: none;
  }

  .tech-page::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, rgba(18, 18, 18, 0.18), rgba(18, 18, 18, 0.72) 100%);
    pointer-events: none;
  }

  .tech-path {
    fill: none;
    stroke-dasharray: 1;
    transition: stroke-dashoffset 80ms linear;
  }

  .tech-path.trunk {
    stroke: rgba(110, 191, 126, 0.5);
    stroke-width: 3;
    stroke-dashoffset: calc(1 - var(--tech-progress, 0));
    filter: drop-shadow(0 0 12px rgba(110, 191, 126, 0.22));
  }

  .tech-path.primary,
  .tech-path.branch {
    stroke: rgba(110, 191, 126, 0.46);
    stroke-width: 3;
    filter: drop-shadow(0 0 12px rgba(110, 191, 126, 0.22));
  }

  .tech-path.secondary {
    stroke: rgba(86, 114, 99, 0.42);
    stroke-width: 2;
  }

  .tech-path.tertiary {
    stroke: rgba(222, 222, 222, 0.13);
    stroke-width: 1.2;
  }

  .tech-path.twig {
    stroke: rgba(86, 114, 99, 0.34);
    stroke-width: 1.4;
  }

  .generation-1 .tech-path,
  .tech-path.generation-1,
  .generation-1.tech-leaf-nodes {
    stroke-dashoffset: calc(1 - var(--branch-1, 0));
    opacity: calc(0.08 + var(--branch-1, 0) * 0.84);
  }

  .generation-2 .tech-path,
  .tech-path.generation-2,
  .generation-2.tech-leaf-nodes {
    stroke-dashoffset: calc(1 - var(--branch-2, 0));
    opacity: calc(0.04 + var(--branch-2, 0) * 0.78);
  }

  .generation-3 .tech-path,
  .tech-path.generation-3,
  .generation-3.tech-leaf-nodes {
    stroke-dashoffset: calc(1 - var(--branch-3, 0));
    opacity: calc(0.03 + var(--branch-3, 0) * 0.72);
  }

  .generation-4 .tech-path,
  .tech-path.generation-4,
  .generation-4.tech-leaf-nodes {
    stroke-dashoffset: calc(1 - var(--branch-4, 0));
    opacity: calc(0.02 + var(--branch-4, 0) * 0.68);
  }

  .generation-0.tech-leaf-nodes {
    opacity: 0.95;
  }

  .tech-leaf-nodes use {
    fill: rgba(19, 45, 37, 0.58);
    stroke: rgba(110, 191, 126, 0.48);
    stroke-width: 1.6;
    transform-box: fill-box;
    transform-origin: center;
    animation: leafPulse 4.8s ease-in-out infinite;
  }

  .tech-leaf-nodes use:nth-child(3n) {
    animation-delay: 0.8s;
  }

  .tech-leaf-nodes use:nth-child(4n) {
    animation-delay: 1.6s;
  }

  #plant-node path:nth-child(n + 2) {
    fill: none;
    stroke: rgba(222, 222, 222, 0.22);
    stroke-width: 1.2;
  }

  @keyframes leafPulse {
    0%, 100% { opacity: 0.55; transform: scale(1); }
    50% { opacity: 0.9; transform: scale(1.08); }
  }

  .tech-silhouette {
    fill: none;
    stroke: rgba(255, 255, 255, 0.9);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.18;
    mix-blend-mode: screen;
    transform-origin: center;
    filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.12));
  }

  .float-a { animation: techFloatA 8s ease-in-out infinite; }
  .float-b { animation: techFloatB 10s ease-in-out infinite; }
  .float-c { animation: techFloatC 9s ease-in-out infinite; }
  .float-d { animation: techFloatD 11s ease-in-out infinite; }

  @keyframes techFloatA {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-4deg); opacity: 0.1; }
    50% { transform: translate3d(12px, -18px, 0) rotate(5deg); opacity: 0.2; }
  }

  @keyframes techFloatB {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(6deg); opacity: 0.12; }
    50% { transform: translate3d(-16px, 16px, 0) rotate(-6deg); opacity: 0.22; }
  }

  @keyframes techFloatC {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); opacity: 0.1; }
    50% { transform: translate3d(10px, 20px, 0) scale(1.08); opacity: 0.18; }
  }

  @keyframes techFloatD {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-8deg) scale(0.96); opacity: 0.09; }
    50% { transform: translate3d(-10px, -14px, 0) rotate(7deg) scale(1.06); opacity: 0.18; }
  }
</style>
