---
import { Image } from "astro:assets";
import LeafPill from "@assets/icons/LeafPill.svg";

const pillsTag = ["Drug Discovery", "IA", "Nature"];
---

<div
  class="bg-secondary relative z-10 rounded-3xl p-12 flex flex-col justify-center text-white font-inter xl:mx-32 lg:mx-16 md:mx-6"
>
  <div class="mb-16 flex flex-col gap-6">
    <p class="xl:text-[40px] lg:text-[35px] md:text-[25px]">CONTACT US!</p>
    <p class="xl:text-[35px] lg:text-[25px] md:text-[18px]">
      Let's unlock the potential of nature together.
    </p>
  </div>
  <div class="flex gap-3">
    {
      pillsTag.map((tag, index) => (
        <div
          key={index}
          class="flex items-center gap-3 text-white bg-pills rounded-full p-1"
        >
          <Image src={LeafPill} alt="Leaf Pill" class="w-[14px] object-fit" />
          <span class="text-white xl:text-[16px] lg:text-[12px] md:text-[8px]">
            {tag}
          </span>
        </div>
      ))
    }
  </div>
</div>
