---
import GenericImage from "@assets/GenericImage.svg";
import ArrowRightSecondaryh from "@assets/icons/ArrowRightSecondary.svg";
import { Image } from "astro:assets";
---

<div class="relative z-10 overflow-hidden">
  <div class="flex flex-col items-start justify-start py-24 px-8 max-w-6xl mx-auto">
    <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.1s;">
      <h1 class="font-roboto font-medium text-birch leading-4 tracking-widest mb-4">
        INDUSTRY UPDATES
      </h1>
    </div>

    <div class="xl:text-[48px] lg:text-[32px] md:text-[32px] font-semibold">
      <h2 class="reveal opacity-0 text-pure mb-6 text-6xl" data-animation="slide-in" style="transition-delay: 0.2s;">
        Latest news
      </h2>
      <p class="reveal opacity-0 text-birch/75 font-inter font-thin text-lg leading-relaxed max-w-96" data-animation="slide-in" style="transition-delay: 0.3s;">
        Insights, research and opinion articles on ethnobotany, AI-Driven
        innovations for Human wellness
      </p>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row justify-between items-stretch py-12 gap-8 px-8 max-w-6xl mx-auto mb-24">
    {[1, 2, 3].map((_, index) => (
      <div 
        class="article-card reveal opacity-0 group rounded-3xl text-birch/72 text-[18px] w-full sm:w-1/3 border shadow-2xl shadow-black/20 transition-all duration-500 hover:scale-[1.03] hover:shadow-2xl cursor-pointer flex flex-col overflow-hidden"
        data-animation="pop-in"
        style={`transition-delay: ${0.4 + index * 0.2}s;`}
      >
        <div class="overflow-hidden">
          <Image 
            src={GenericImage} 
            alt="Generic Image" 
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 article-image" 
          />
        </div>
        
        <div class="px-6 flex flex-col flex-grow">
          <p class="font-inter text-[11px] mt-6 text-birch/58 tracking-[0.24em]">SEPTEMBER 5, 2025</p>
          <p class="text-[32px] text-pure pb-12 leading-tight mt-2 group-hover:text-freshgreen transition-colors duration-300">
            Article title
          </p>

          <div class="mt-auto flex items-center justify-between pb-8">
            <p class="text-freshgreen font-medium transition-all duration-300 group-hover:tracking-wider">Read More</p>
            <div class="transition-transform duration-300 group-hover:translate-x-2">
              <Image src={ArrowRightSecondaryh} alt="More" />
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const animationType = entry.target.getAttribute('data-animation');
        entry.target.classList.add(`animate-${animationType}`);
        entry.target.classList.remove('opacity-0');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>

<style>
  .article-card {
    border-color: rgba(222, 222, 222, 0.1);
    background:
      radial-gradient(circle at 18% 0%, rgba(110, 191, 126, 0.12), transparent 34%),
      linear-gradient(145deg, rgba(18, 18, 18, 0.68), rgba(19, 45, 37, 0.48));
    backdrop-filter: blur(18px);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.24), inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .article-card:hover {
    border-color: rgba(110, 191, 126, 0.34);
  }

  .article-image {
    filter: grayscale(1) contrast(1.22) brightness(0.62);
  }

  .animate-slide-in { animation: slideIn 0.8s ease-out forwards; }
  .animate-pop-in { animation: popIn 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }

  @keyframes slideIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.9) translateY(40px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
</style>
