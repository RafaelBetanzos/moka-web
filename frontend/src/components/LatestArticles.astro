---
import GenericImage from "@assets/GenericImage.svg";
import ArrowRightSecondaryh from "@assets/icons/ArrowRightSecondary.svg";
import { Image } from "astro:assets";
---

<div class="overflow-hidden">
  <div class="flex flex-col items-start justify-start py-24 px-8 max-w-6xl mx-auto">
    <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.1s;">
      <h1 class="font-roboto font-medium text-black leading-4 tracking-widest mb-4">
        INDUSTRY UPDATES
      </h1>
    </div>

    <div class="xl:text-[48px] lg:text-[32px] md:text-[32px] font-semibold">
      <h2 class="reveal opacity-0 text-secondary mb-6 text-6xl" data-animation="slide-in" style="transition-delay: 0.2s;">
        Latest news
      </h2>
      <p class="reveal opacity-0 text-neutral-500 font-inter font-thin text-lg leading-relaxed max-w-96" data-animation="slide-in" style="transition-delay: 0.3s;">
        Insights, research and opinion articles on ethnobotany, AI-Driven
        innovations for Human wellness
      </p>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row justify-between items-stretch py-12 gap-8 px-8 max-w-6xl mx-auto mb-24">
    {[1, 2, 3].map((_, index) => (
      <div 
        class="reveal opacity-0 group bg-white rounded-3xl text-[#BBBBBBFF] text-[18px] w-full sm:w-1/3 border border-transparent shadow-sm transition-all duration-500 hover:scale-[1.03] hover:shadow-2xl hover:border-neutral-100 cursor-pointer flex flex-col"
        data-animation="pop-in"
        style={`transition-delay: ${0.4 + index * 0.2}s;`}
      >
        <div class="overflow-hidden rounded-t-3xl">
          <Image 
            src={GenericImage} 
            alt="Generic Image" 
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" 
          />
        </div>
        
        <div class="px-6 flex flex-col flex-grow">
          <p class="font-inter text-[11px] mt-6">SEPTEMBER 5, 2025</p>
          <p class="text-[32px] text-secondary pb-12 leading-tight mt-2 group-hover:text-black transition-colors duration-300">
            Article title
          </p>

          <div class="mt-auto flex items-center justify-between pb-8">
            <p class="text-secondary font-medium transition-all duration-300 group-hover:tracking-wider">Read More</p>
            <div class="transition-transform duration-300 group-hover:translate-x-2">
              <Image src={ArrowRightSecondaryh} alt="More" />
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const animationType = entry.target.getAttribute('data-animation');
        entry.target.classList.add(`animate-${animationType}`);
        entry.target.classList.remove('opacity-0');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>

<style>
  .animate-slide-in { animation: slideIn 0.8s ease-out forwards; }
  .animate-pop-in { animation: popIn 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }

  @keyframes slideIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.9) translateY(40px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
</style>