---
import { Image } from "astro:assets";
import { Fragment } from "react";
const { title, content, grayPoint, greenPoint, number, image, altImage } =
  Astro.props;
---

<div class="bg-white drop-shadow-sm rounded-3xl p-3 md:w-[300px] mb-3">
  <div class="pl-8 pr-8 pb-4 rounded-t-3xl flex items-center justify-center">
    <p
      class="text-secondary text-center font-semibold min-h-[3.5rem] flex items-center justify-center"
    >
      {title}
    </p>
  </div>
  <div class="flex flex-col items-center justify-center gap-2">
    <div class="relative">
      <Image src={image} alt={altImage} />
      <p
        class="absolute inset-0 flex items-center justify-center font-inter font-semibold text-graycolor text-lg"
      >
        {number}
      </p>
    </div>
    <div class="flex flex-row justify-center gap-3 w-full">
      <div class="flex flex-row items-center gap-2">
        <div class="w-3 h-3 bg-secondgray rounded-full"></div>
        <p class="text-graycolor text-[16px]">{grayPoint}</p>
      </div>
      <div class="flex flex-row items-center gap-2">
        <div class="w-3 h-3 bg-custom-gradient rounded-full"></div>
        <p class="text-graycolor text-[16px]">{greenPoint}</p>
      </div>
    </div>
    <div class="flex justify-center items-center mt-6 pl-8 pr-8">
      {
        content && content.type === "span" ? (
          <span>
            {content.props.children.map((child: any) => {
              if (child.type === "strong") {
                return <strong>{child.props.children}</strong>;
              }
              return child;
            })}
          </span>
        ) : (
          content
        )
      }
    </div>
  </div>
</div>
