---
import Brain from "@assets/Brain.svg";
import { Image } from "astro:assets";

type Part = "brain" | "capabilities" | "process";

interface Props {
  locale?: "en" | "es" | "pt";
  /** Which blocks to render: the Icaros brain, the Moka BDE capabilities, the project steps. */
  parts?: Part[];
  /** Render the project-steps label as the section's H2 (when the steps stand alone). */
  processHeading?: boolean;
}

const { locale = "en", parts = ["brain", "capabilities", "process"], processHeading = false } = Astro.props;
const show = (part: Part) => parts.includes(part);
// Anchors for the capability cards (the home links to #predict-bioactivity).
const capabilityIds = ["explore-icaros", "predict-bioactivity", "mechanisms-and-targets", "intellectual-property", "formulation", "lab-results"];
const process = {
  en: [
    { step: "01", kicker: "YOUR GOAL",       title: "Tell us what you need",        body: "A plant, or a need." },
    { step: "02", kicker: "PRIORITIZATION",  title: "We prioritize",                body: "The plants and compounds with the most potential." },
    { step: "03", kicker: "DEVELOPMENT",     title: "We develop",                   body: "Extract, fraction, or molecule." },
    { step: "04", kicker: "DELIVERY",        title: "We deliver",                   body: "Results and an IP assessment." },
  ],
  es: [
    { step: "01", kicker: "TU OBJETIVO",     title: "Nos cuentas qué buscas",       body: "Una planta, o una necesidad." },
    { step: "02", kicker: "PRIORIZACIÓN",    title: "Priorizamos",                  body: "Las plantas y compuestos con más potencial." },
    { step: "03", kicker: "DESARROLLO",      title: "Desarrollamos",                body: "Extracto, fracción o molécula." },
    { step: "04", kicker: "ENTREGA",         title: "Entregamos",                   body: "Resultados y evaluación de PI." },
  ],
  pt: [
    { step: "01", kicker: "SEU OBJETIVO",    title: "Você nos conta o que busca",   body: "Uma planta, ou uma necessidade." },
    { step: "02", kicker: "PRIORIZAÇÃO",     title: "Priorizamos",                  body: "As plantas e compostos com mais potencial." },
    { step: "03", kicker: "DESENVOLVIMENTO", title: "Desenvolvemos",                body: "Extrato, fração ou molécula." },
    { step: "04", kicker: "ENTREGA",         title: "Entregamos",                   body: "Resultados e avaliação de PI." },
  ],
}[locale];

const copy = {
  en: {
    analytical: "What is already known",
    experimental: "Evidence",
    experimentalText: "Icaros brings together the scientific evidence on each plant and its compounds.",
    creative: "What no one knows yet",
    silico: "Prediction",
    silicoText: "Icaros anticipates bioactivity in plants that have never been studied.",
    kicker: "MOKA BDE",
    title: "What you can do with Moka BDE",
    body: "From a Latin American plant to a prioritized candidate, in one place.",
    capabilities: [
      { title: "Explore Icaros", body: "Plants, compounds, and evidence in a single search." },
      { title: "Predict bioactivity", body: "Even in plants without a single previous study." },
      { title: "Mechanisms and targets", body: "See how a candidate would act before testing it." },
      { title: "Intellectual property", body: "Know whether you can protect it before you invest." },
      { title: "Formulation", body: "From the active to your product." },
      { title: "Your lab results", body: "Your data, connected to what is known about each plant." },
    ],
    connector: "WHAT A PROJECT LOOKS LIKE",
  },
  es: {
    analytical: "Lo que ya se sabe",
    experimental: "Evidencia",
    experimentalText: "Icaros reúne la evidencia científica sobre cada planta y sus compuestos.",
    creative: "Lo que aún nadie sabe",
    silico: "Predicción",
    silicoText: "Icaros anticipa bioactividad en plantas que nunca se han estudiado.",
    kicker: "MOKA BDE",
    title: "Qué puedes hacer con Moka BDE",
    body: "De una planta latinoamericana a un candidato priorizado, en un solo lugar.",
    capabilities: [
      { title: "Explorar Icaros", body: "Plantas, compuestos y evidencia en una sola búsqueda." },
      { title: "Predecir bioactividad", body: "Incluso en plantas sin un solo estudio previo." },
      { title: "Mecanismos y dianas", body: "Entiende cómo actuaría un candidato antes de ensayarlo." },
      { title: "Propiedad intelectual", body: "Sabe si puedes protegerlo antes de invertir." },
      { title: "Formulación", body: "Del activo a tu producto." },
      { title: "Tus resultados de laboratorio", body: "Tus datos, conectados con lo que se sabe de cada planta." },
    ],
    connector: "CÓMO ES UN PROYECTO CON MOKA",
  },
  pt: {
    analytical: "O que já se sabe",
    experimental: "Evidência",
    experimentalText: "O Icaros reúne a evidência científica sobre cada planta e seus compostos.",
    creative: "O que ninguém sabe ainda",
    silico: "Predição",
    silicoText: "O Icaros antecipa bioatividade em plantas que nunca foram estudadas.",
    kicker: "MOKA BDE",
    title: "O que você pode fazer com o Moka BDE",
    body: "De uma planta latino-americana a um candidato priorizado, em um só lugar.",
    capabilities: [
      { title: "Explorar o Icaros", body: "Plantas, compostos e evidências em uma só busca." },
      { title: "Prever bioatividade", body: "Mesmo em plantas sem nenhum estudo anterior." },
      { title: "Mecanismos e alvos", body: "Entenda como um candidato agiria antes de testá-lo." },
      { title: "Propriedade intelectual", body: "Saiba se pode protegê-lo antes de investir." },
      { title: "Formulação", body: "Do ativo ao seu produto." },
      { title: "Seus resultados de laboratório", body: "Seus dados, conectados ao que se sabe sobre cada planta." },
    ],
    connector: "COMO É UM PROJETO COM A MOKA",
  },
}[locale];
---

<div class="flex flex-col justify-center items-center w-full max-w-7xl mx-auto px-6 py-16 overflow-hidden bg-transparent">
  
  {show("brain") && (
  <div class="w-full" id="icaros">
    {/* Versión Mobile */}
    <div class="reveal opacity-0 sm:hidden mb-12 text-center" data-animation="pop-in">
      <Image src={Brain} alt="" class="w-56 h-auto mx-auto" loading="lazy" />
      <p class="brain-name mt-4">Icaros</p>
      <div class="brain-mobile-pair">
        <div>
          <h3 class="brain-side-title">{copy.analytical}</h3>
          <p class="text-birch font-semibold text-lg">{copy.experimental}</p>
          <p class="text-birch/75 text-sm leading-relaxed">{copy.experimentalText}</p>
        </div>
        <div>
          <h3 class="brain-side-title">{copy.creative}</h3>
          <p class="text-birch font-semibold text-lg">{copy.silico}</p>
          <p class="text-birch/75 text-sm leading-relaxed">{copy.silicoText}</p>
        </div>
      </div>
    </div>

    {/* Desktop Grid */}
    <div class="brain-grid hidden sm:grid w-full mb-24">

      {/* 1. Lado Izquierdo: Analytical Thinking */}
      <div
        class="reveal opacity-0 brain-side brain-side--left group"
        data-animation="slide-left"
        style="transition-delay: 0.1s;"
      >
        <h3 class="brain-side-title group-hover:text-pure transition-colors duration-300">
          {copy.analytical}
        </h3>
        <div class="brain-side-rule ml-auto transition-all duration-300 group-hover:w-20 group-hover:bg-secondary"></div>
        <p class="text-birch font-semibold text-lg">{copy.experimental}</p>
        <p class="text-birch/75 text-sm md:text-base leading-relaxed max-w-[260px]">
          {copy.experimentalText}
        </p>
      </div>

      {/* 2. Centro: Cerebro */}
      <div
        class="reveal opacity-0 flex justify-center items-center"
        data-animation="pop-in"
        style="transition-delay: 0.3s;"
      >
        <div class="flex flex-col items-center">
          <Image
            src={Brain}
            alt=""
            class="w-full max-w-sm lg:max-w-md h-auto object-contain transition-transform duration-1000 hover:scale-110"
          />
          <p class="brain-name mt-6">Icaros</p>
        </div>
      </div>

      {/* 3. Lado Derecho: Creative Thinking */}
      <div
        class="reveal opacity-0 brain-side brain-side--right group"
        data-animation="slide-right"
        style="transition-delay: 0.5s;"
      >
        <h3 class="brain-side-title group-hover:text-pure transition-colors duration-300">
          {copy.creative}
        </h3>
        <div class="brain-side-rule mr-auto transition-all duration-300 group-hover:w-20 group-hover:bg-secondary"></div>
        <p class="text-birch font-semibold text-lg">{copy.silico}</p>
        <p class="text-birch/75 text-sm md:text-base leading-relaxed max-w-[260px]">
          {copy.silicoText}
        </p>
      </div>
    </div>
  </div>
  )}

  {/* Capabilities */}
  {show("capabilities") && (
  <div id="capabilities" class="flex flex-col w-full gap-6 text-center items-center py-4 mt-12">
    <div class="reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.1s;">
      <p class="font-roboto font-medium text-[13px] leading-none tracking-[0.48em] uppercase text-freshgreen">
        {copy.kicker}
      </p>
    </div>
    <div class="reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.2s;">
      <h2 class="text-pure text-[clamp(1.9rem,3.4vw,3rem)] leading-[1.05] font-inter font-semibold max-w-3xl mx-auto text-wrap-balance">
        {copy.title}
      </h2>
    </div>
    <div class="reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.3s;">
      <p class="text-birch/75 text-[18px] md:text-[20px] font-inter font-medium leading-relaxed max-w-3xl">
        {copy.body}
      </p>
    </div>

    <div class="capability-grid">
      {copy.capabilities.map((cap, i) => (
        <article id={capabilityIds[i]} class="reveal opacity-0 brain-thinking-card capability-card" data-animation="pop-in" style={`transition-delay: ${0.1 + i * 0.08}s;`}>
          <p class="capability-index">0{i + 1}</p>
          <h3 class="brain-thinking-title">{cap.title}</h3>
          <p class="brain-thinking-body">{cap.body}</p>
        </article>
      ))}
    </div>
  </div>
  )}

  {show("process") && (<>
  {/* Connector → project steps */}
  <div id="process" class="brain-connector" aria-hidden={processHeading ? undefined : "true"}>
    <div class="brain-connector-line" aria-hidden="true"></div>
    <div class="brain-connector-dot" aria-hidden="true"></div>
    {processHeading ? <h2 class="brain-connector-label">{copy.connector}</h2> : <p class="brain-connector-label">{copy.connector}</p>}
  </div>

  {/* Diagrama de proceso */}
  <div class="process-flow">
    {process.map((step, i) => (
      <>
        <article class="process-card moka-page-panel reveal opacity-0 group" data-animation="pop-in" style={`transition-delay: ${0.1 + i * 0.15}s;`}>
          <p class="process-step">{step.step}</p>
          <p class="process-kicker">{step.kicker}</p>
          <h3 class="process-title">{step.title}</h3>
          <p class="process-body">{step.body}</p>
        </article>
        {i < process.length - 1 && (
          <div class="process-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </div>
        )}
      </>
    ))}
  </div>
  </>)}
</div>

<script>
  const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -50px 0px' };
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const animationType = entry.target.getAttribute('data-animation');
        entry.target.classList.add(`animate-${animationType}`);
        entry.target.classList.remove('opacity-0');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>

<style>
  .brain-mobile-pair {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
    text-align: left;
  }

  .brain-mobile-pair > div {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border-radius: 1.25rem;
    border: 1px solid var(--moka-border-muted);
    background: linear-gradient(145deg, rgba(19, 45, 37, 0.5), rgba(18, 18, 18, 0.4));
  }

  /* ── Brain desktop grid ───────────────────────── */
  .brain-grid {
    grid-template-columns: minmax(0, 0.72fr) minmax(360px, 1.56fr) minmax(0, 0.72fr);
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .brain-grid { gap: 2rem; }
  }

  .brain-side {
    display: flex;
    flex-direction: column;
    gap: 0;
    cursor: default;
    transition: transform 500ms ease;
  }

  .brain-side:hover { transform: scale(1.03); }

  .brain-side--left { align-items: flex-end; text-align: right; }
  .brain-side--right { align-items: flex-start; text-align: left; }

  .brain-side-title {
    font-family: Inter, sans-serif;
    font-size: clamp(1.1rem, 2.4vw, 1.75rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--fresh-green-color);
  }

  .brain-side-rule {
    width: 3rem;
    height: 4px;
    background: rgba(86, 114, 99, 0.3);
    border-radius: 999px;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .brain-thinking-grid {
    display: grid;
    width: min(100%, 980px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .brain-thinking-card {
    width: 100%;
    border: 1px solid rgba(222, 222, 222, 0.10);
    border-radius: 1.5rem;
    background: linear-gradient(145deg, rgba(18, 18, 18, 0.66), rgba(19, 45, 37, 0.42));
    padding: 1.75rem;
    text-align: left;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.20), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(18px);
  }

  .brain-thinking-card--accent {
    border-color: rgba(110, 191, 126, 0.22);
    background: linear-gradient(145deg, rgba(19, 45, 37, 0.72), rgba(18, 18, 18, 0.58));
  }

  .brain-thinking-card--together {
    width: min(100%, 980px);
    text-align: center;
    border-color: rgba(110, 191, 126, 0.24);
  }

  .brain-thinking-title {
    font-family: Inter, sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--pure-color);
  }

  .brain-thinking-title--accent {
    color: var(--fresh-green-color);
  }

  .brain-thinking-body {
    margin-top: 1rem;
    font-family: Inter, sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(222, 222, 222, 0.74);
  }

  @media (max-width: 767px) {
    .brain-thinking-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Brain → Problem connector ───────────────── */
  /* Anchor targets clear the sticky navbar */
  .capability-card,
  #process {
    scroll-margin-top: 7rem;
  }

  .brain-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding-top: 2.5rem;
    padding-bottom: 0.5rem;
  }

  .brain-connector-line {
    width: 1px;
    height: 56px;
    background: linear-gradient(180deg, rgba(110, 191, 126, 0.0), rgba(110, 191, 126, 0.42));
  }

  .brain-connector-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--fresh-green-color);
    box-shadow: 0 0 16px rgba(110, 191, 126, 0.55);
    animation: dotPulse 2.4s ease-in-out infinite;
  }

  .brain-connector-label {
    margin-top: 0.75rem;
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: rgba(110, 191, 126, 0.55);
  }

  @keyframes dotPulse {
    0%, 100% { transform: scale(1);    opacity: 0.7; }
    50%       { transform: scale(1.5); opacity: 1;   }
  }

  /* ── Entrance animations ─────────────────────── */
  .animate-slide-left  { animation: slideLeft  0.8s ease-out forwards; }
  .animate-slide-right { animation: slideRight 0.8s ease-out forwards; }
  .animate-slide-up    { animation: slideUp    0.8s ease-out forwards; }
  .animate-pop-in      { animation: popIn      1s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

  @keyframes slideLeft  { from { opacity: 0; transform: translateX(-40px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes slideRight { from { opacity: 0; transform: translateX( 40px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes slideUp    { from { opacity: 0; transform: translateY( 30px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes popIn      { from { opacity: 0; transform: scale(0.95);       } to { opacity: 1; transform: scale(1);      } }

  @media (prefers-reduced-motion: reduce) {
    .animate-slide-left,
    .animate-slide-right,
    .animate-slide-up,
    .animate-pop-in {
      animation-duration: 1ms;
    }
    .brain-connector-dot {
      animation: none;
    }
  }

  /* ── Process flow diagram ─────────────────────── */
  .process-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    grid-template-rows: auto auto auto 1fr;
    row-gap: 0.5rem;
    width: min(100%, 1200px);
    margin-top: 2rem;
  }

  .process-card {
    grid-row: 1 / 5;
    display: grid;
    grid-template-rows: subgrid;
    align-content: start;
    padding: 1.75rem;
    border-radius: 1.5rem;
    cursor: default;
    transition: transform 400ms ease, border-color 400ms ease, box-shadow 400ms ease;
  }

  .process-card:hover {
    transform: translateY(-6px);
    border-color: var(--moka-border-accent);
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.28), 0 0 40px var(--moka-glow-soft);
  }

  .process-step {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: rgba(110, 191, 126, 0.45);
    align-self: start;
  }

  .process-kicker {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.44em;
    text-transform: uppercase;
    color: var(--fresh-green-color);
    align-self: start;
  }

  .process-title {
    font-family: Inter, sans-serif;
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    font-weight: 700;
    color: var(--pure-color);
    line-height: 1.3;
    align-self: start;
    transition: color 300ms ease;
  }

  .process-card:hover .process-title { color: var(--fresh-green-color); }

  .process-body {
    font-family: Inter, sans-serif;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--moka-text-muted);
    align-self: start;
  }

  .process-arrow {
    grid-row: 1 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    color: rgba(110, 191, 126, 0.35);
  }

  .process-arrow svg { width: 20px; height: 20px; }

  @media (max-width: 900px) {
    .process-flow {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }
    .process-card {
      grid-row: auto;
      grid-template-rows: none;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .process-arrow {
      grid-row: auto;
      width: auto;
      height: 2rem;
      transform: rotate(90deg);
    }
  }

  /* ── Capabilities ─────────────────────────────── */
  .capability-grid {
    margin-top: 1.5rem;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    text-align: left;
  }

  .capability-index {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--fresh-green-color);
    margin-bottom: 0.6rem;
  }

  @media (max-width: 1000px) {
    .capability-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .capability-grid { grid-template-columns: 1fr; }
  }

  /* The brain is Icaros */
  .brain-name {
    display: inline-flex;
    padding: 0.45rem 1.4rem;
    border-radius: 999px;
    border: 1px solid rgba(110, 191, 126, 0.45);
    background: rgba(19, 45, 37, 0.6);
    font-family: Roboto, sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--fresh-green-color);
  }
</style>
