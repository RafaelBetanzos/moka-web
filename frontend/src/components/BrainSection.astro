---
import Brain from "@assets/Brain.svg";
import { Image } from "astro:assets";

interface Props {
  locale?: "en" | "es" | "pt";
}

const { locale = "en" } = Astro.props;
const process = {
  en: [
    { step: "01", kicker: "RAW DATA",       title: "Botanical & Scientific Data",  body: "Botanical literature, phytochemistry references, species records, and experimental datasets structured for MokaDex analysis." },
    { step: "02", kicker: "INTELLIGENCE",   title: "AI / Knowledge Graph",          body: "MokaDex connects species, compounds, evidence, and biological signals through graph-based reasoning." },
    { step: "03", kicker: "VALIDATED",      title: "Bioactivity Intelligence",      body: "MokaDex helps prioritize mechanism hypotheses, biological targets, and bioactivity signals for further validation." },
    { step: "04", kicker: "MARKET-READY",   title: "Product, IP & Regulatory",      body: "MokaDex outputs can support product direction, IP assessment, regulatory review, and formulation decisions." },
  ],
  es: [
    { step: "01", kicker: "DATOS BRUTOS",          title: "Datos Botánicos y Científicos",   body: "Literatura botánica, referencias de fitoquímica, registros de especies y conjuntos de datos experimentales estructurados para el análisis de MokaDex." },
    { step: "02", kicker: "INTELIGENCIA",          title: "IA / Grafo de Conocimiento",      body: "MokaDex conecta especies, compuestos, evidencias y señales biológicas mediante razonamiento basado en grafos." },
    { step: "03", kicker: "VALIDADO",              title: "Inteligencia de Bioactividad",    body: "MokaDex ayuda a priorizar hipótesis de mecanismo, dianas biológicas y señales de bioactividad para su validación posterior." },
    { step: "04", kicker: "LISTO PARA MERCADO",    title: "Producto, IP y Regulatorio",      body: "Los resultados de MokaDex pueden orientar la dirección de productos, la evaluación de PI, la revisión regulatoria y las decisiones de formulación." },
  ],
  pt: [
    { step: "01", kicker: "DADOS BRUTOS",          title: "Dados Botânicos e Científicos",   body: "Literatura botânica, referências de fitoquímica, registros de espécies e conjuntos de dados experimentais estruturados para a análise do MokaDex." },
    { step: "02", kicker: "INTELIGÊNCIA",          title: "IA / Grafo de Conhecimento",      body: "O MokaDex conecta espécies, compostos, evidências e sinais biológicos por meio de raciocínio baseado em grafos." },
    { step: "03", kicker: "VALIDADO",              title: "Inteligência de Bioatividade",    body: "O MokaDex ajuda a priorizar hipóteses de mecanismo, alvos biológicos e sinais de bioatividade para validação posterior." },
    { step: "04", kicker: "PRONTO PARA MERCADO",   title: "Produto, PI e Regulatório",       body: "Os resultados do MokaDex podem apoiar a direção de produtos, avaliação de PI, revisão regulatória e decisões de formulação." },
  ],
}[locale];

const copy = {
  en: {
    analytical: "Analytical thinking",
    experimental: "Experimental lobe",
    experimentalText: "AI model trained on in-house experimental data",
    creative: "Creative thinking",
    silico: "In silico lobe",
    silicoText: "AI model trained on in-house predicted data",
    kicker: "HOW IT WORKS",
    titleStart: "MokaDex integrates nature’s knowledge with",
    titleHighlight: "cutting edge technology",
    body: "MokaDex combines empirical evidence with predictive biology to turn Latin America's biodiversity into a searchable, programmable discovery system.",
    leftTitle: "Left Brain",
    leftBody: "Empirical data — chemical fingerprints, LC-MS, experimental bioactives, species records, and validated biological activity.",
    rightTitle: "Right Brain",
    rightBody: "MokaDex — bioinformatic prediction, mechanism of action inference, structure-activity relationships, pathway mapping, and market intelligence.",
    togetherTitle: "Together",
    togetherBody: "A knowledge graph of Latin American biodiversity — built to identify what nature already knows, and translate it into molecules, products, IP, and scalable innovation.",
    connector: "THE PROCESS",
  },
  es: {
    analytical: "Pensamiento analítico",
    experimental: "Lóbulo experimental",
    experimentalText: "Modelo de IA entrenado con datos experimentales propios",
    creative: "Pensamiento creativo",
    silico: "Lóbulo in silico",
    silicoText: "Modelo de IA entrenado con datos predichos internos",
    kicker: "CÓMO FUNCIONA",
    titleStart: "MokaDex integra el conocimiento de la naturaleza con",
    titleHighlight: "tecnología de vanguardia",
    body: "MokaDex combina evidencia empírica con biología predictiva para convertir la biodiversidad latinoamericana en un sistema de descubrimiento consultable y programable.",
    leftTitle: "Cerebro izquierdo",
    leftBody: "Datos empíricos: fingerprints químicos, LC-MS, bioactivos experimentales, registros de especies y actividad biológica validada.",
    rightTitle: "Cerebro derecho",
    rightBody: "MokaDex: predicción bioinformática, inferencia de mecanismos de acción, relaciones estructura-actividad, mapeo de rutas e inteligencia de mercado.",
    togetherTitle: "Juntos",
    togetherBody: "Un grafo de conocimiento de la biodiversidad latinoamericana, creado para identificar lo que la naturaleza ya sabe y traducirlo en moléculas, productos, PI e innovación escalable.",
    connector: "EL PROCESO",
  },
  pt: {
    analytical: "Pensamento analítico",
    experimental: "Lobo experimental",
    experimentalText: "Modelo de IA treinado com dados experimentais próprios",
    creative: "Pensamento criativo",
    silico: "Lobo in silico",
    silicoText: "Modelo de IA treinado com dados preditos internos",
    kicker: "COMO FUNCIONA",
    titleStart: "MokaDex integra o conhecimento da natureza com",
    titleHighlight: "tecnologia de ponta",
    body: "O MokaDex combina evidência empírica com biologia preditiva para transformar a biodiversidade latino-americana em um sistema de descoberta pesquisável e programável.",
    leftTitle: "Cérebro esquerdo",
    leftBody: "Dados empíricos: fingerprints químicos, LC-MS, bioativos experimentais, registros de espécies e atividade biológica validada.",
    rightTitle: "Cérebro direito",
    rightBody: "MokaDex: predição bioinformática, inferência de mecanismos de ação, relações estrutura-atividade, mapeamento de vias e inteligência de mercado.",
    togetherTitle: "Juntos",
    togetherBody: "Um grafo de conhecimento da biodiversidade latino-americana, criado para identificar o que a natureza já sabe e traduzir isso em moléculas, produtos, PI e inovação escalável.",
    connector: "O PROCESSO",
  },
}[locale];
---

<div class="flex flex-col justify-center items-center w-full max-w-7xl mx-auto px-6 py-16 overflow-hidden bg-transparent">
  
  <div class="w-full">
    {/* Versión Mobile */}
    <div class="reveal opacity-0 sm:hidden mb-12 text-center" data-animation="pop-in">
      <Image src={Brain} alt="Brain" class="w-56 h-auto mx-auto" loading="lazy" />
    </div>

    {/* Desktop Grid */}
    <div class="brain-grid hidden sm:grid w-full mb-24">

      {/* 1. Lado Izquierdo: Analytical Thinking */}
      <div
        class="reveal opacity-0 brain-side brain-side--left group"
        data-animation="slide-left"
        style="transition-delay: 0.1s;"
      >
        <h3 class="brain-side-title group-hover:text-pure transition-colors duration-300">
          {copy.analytical}
        </h3>
        <div class="brain-side-rule ml-auto transition-all duration-300 group-hover:w-20 group-hover:bg-secondary"></div>
        <p class="text-birch font-semibold text-lg">{copy.experimental}</p>
        <p class="text-birch/75 text-sm md:text-base leading-relaxed max-w-[260px]">
          {copy.experimentalText}
        </p>
      </div>

      {/* 2. Centro: Cerebro */}
      <div
        class="reveal opacity-0 flex justify-center items-center"
        data-animation="pop-in"
        style="transition-delay: 0.3s;"
      >
        <Image
          src={Brain}
          alt="Brain Diagram"
          class="w-full max-w-sm lg:max-w-md h-auto object-contain transition-transform duration-1000 hover:scale-110"
        />
      </div>

      {/* 3. Lado Derecho: Creative Thinking */}
      <div
        class="reveal opacity-0 brain-side brain-side--right group"
        data-animation="slide-right"
        style="transition-delay: 0.5s;"
      >
        <h3 class="brain-side-title group-hover:text-pure transition-colors duration-300">
          {copy.creative}
        </h3>
        <div class="brain-side-rule mr-auto transition-all duration-300 group-hover:w-20 group-hover:bg-secondary"></div>
        <p class="text-birch font-semibold text-lg">{copy.silico}</p>
        <p class="text-birch/75 text-sm md:text-base leading-relaxed max-w-[260px]">
          {copy.silicoText}
        </p>
      </div>
    </div>
  </div>

  {/* Sección Inferior */}
  <div class="flex flex-col w-full gap-10 text-center items-center py-4 mt-12">
    <div class="reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.1s;">
      <p class="font-roboto font-medium text-xs leading-none tracking-[0.48em] uppercase text-freshgreen">
        {copy.kicker}
      </p>
    </div>
    <div class="reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.3s;">
      <h2 class="text-pure text-[28px] md:text-[36px] font-inter tracking-wide font-semibold max-w-3xl mx-auto text-wrap-balance">
        {copy.titleStart} <span class="text-freshgreen">{copy.titleHighlight}</span>
      </h2>
    </div>
    <div class="reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.5s;">
      <p class="text-birch/75 text-[18px] md:text-[20px] font-inter font-medium leading-relaxed max-w-3xl">
        {copy.body}
      </p>
    </div>

    <div class="brain-thinking-grid">
      <article class="reveal opacity-0 brain-thinking-card" data-animation="slide-left" style="transition-delay: 0.65s;">
        <p class="brain-thinking-title">{copy.leftTitle}</p>
        <p class="brain-thinking-body">{copy.leftBody}</p>
      </article>

      <article class="reveal opacity-0 brain-thinking-card brain-thinking-card--accent" data-animation="slide-right" style="transition-delay: 0.75s;">
        <p class="brain-thinking-title">{copy.rightTitle}</p>
        <p class="brain-thinking-body">{copy.rightBody}</p>
      </article>
    </div>

    <article class="reveal opacity-0 brain-thinking-card brain-thinking-card--together" data-animation="slide-up" style="transition-delay: 0.85s;">
      <p class="brain-thinking-title brain-thinking-title--accent">{copy.togetherTitle}</p>
      <p class="brain-thinking-body">{copy.togetherBody}</p>
    </article>
  </div>

  {/* Conector visual → THE PROCESS */}
  <div class="brain-connector" aria-hidden="true">
    <div class="brain-connector-line"></div>
    <div class="brain-connector-dot"></div>
    <p class="brain-connector-label">{copy.connector}</p>
  </div>

  {/* Diagrama de proceso */}
  <div class="process-flow">
    {process.map((step, i) => (
      <>
        <article class="process-card moka-page-panel reveal opacity-0 group" data-animation="pop-in" style={`transition-delay: ${0.1 + i * 0.15}s;`}>
          <p class="process-step">{step.step}</p>
          <p class="process-kicker">{step.kicker}</p>
          <h3 class="process-title">{step.title}</h3>
          <p class="process-body">{step.body}</p>
        </article>
        {i < process.length - 1 && (
          <div class="process-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </div>
        )}
      </>
    ))}
  </div>
</div>

<script>
  const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -50px 0px' };
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const animationType = entry.target.getAttribute('data-animation');
        entry.target.classList.add(`animate-${animationType}`);
        entry.target.classList.remove('opacity-0');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>

<style>
  /* ── Brain desktop grid ───────────────────────── */
  .brain-grid {
    grid-template-columns: minmax(0, 0.72fr) minmax(360px, 1.56fr) minmax(0, 0.72fr);
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .brain-grid { gap: 2rem; }
  }

  .brain-side {
    display: flex;
    flex-direction: column;
    gap: 0;
    cursor: default;
    transition: transform 500ms ease;
  }

  .brain-side:hover { transform: scale(1.03); }

  .brain-side--left { align-items: flex-end; text-align: right; }
  .brain-side--right { align-items: flex-start; text-align: left; }

  .brain-side-title {
    font-family: Inter, sans-serif;
    font-size: clamp(1.1rem, 2.4vw, 1.75rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--fresh-green-color);
  }

  .brain-side-rule {
    width: 3rem;
    height: 4px;
    background: rgba(86, 114, 99, 0.3);
    border-radius: 999px;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .brain-thinking-grid {
    display: grid;
    width: min(100%, 980px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .brain-thinking-card {
    width: 100%;
    border: 1px solid rgba(222, 222, 222, 0.10);
    border-radius: 1.5rem;
    background: linear-gradient(145deg, rgba(18, 18, 18, 0.66), rgba(19, 45, 37, 0.42));
    padding: 1.75rem;
    text-align: left;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.20), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(18px);
  }

  .brain-thinking-card--accent {
    border-color: rgba(110, 191, 126, 0.22);
    background: linear-gradient(145deg, rgba(19, 45, 37, 0.72), rgba(18, 18, 18, 0.58));
  }

  .brain-thinking-card--together {
    width: min(100%, 980px);
    text-align: center;
    border-color: rgba(110, 191, 126, 0.24);
  }

  .brain-thinking-title {
    font-family: Inter, sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--pure-color);
  }

  .brain-thinking-title--accent {
    color: var(--fresh-green-color);
  }

  .brain-thinking-body {
    margin-top: 1rem;
    font-family: Inter, sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(222, 222, 222, 0.74);
  }

  @media (max-width: 767px) {
    .brain-thinking-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Brain → Problem connector ───────────────── */
  .brain-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding-top: 2.5rem;
    padding-bottom: 0.5rem;
  }

  .brain-connector-line {
    width: 1px;
    height: 56px;
    background: linear-gradient(180deg, rgba(110, 191, 126, 0.0), rgba(110, 191, 126, 0.42));
  }

  .brain-connector-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--fresh-green-color);
    box-shadow: 0 0 16px rgba(110, 191, 126, 0.55);
    animation: dotPulse 2.4s ease-in-out infinite;
  }

  .brain-connector-label {
    margin-top: 0.75rem;
    font-family: Roboto, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: rgba(110, 191, 126, 0.55);
  }

  @keyframes dotPulse {
    0%, 100% { transform: scale(1);    opacity: 0.7; }
    50%       { transform: scale(1.5); opacity: 1;   }
  }

  /* ── Entrance animations ─────────────────────── */
  .animate-slide-left  { animation: slideLeft  0.8s ease-out forwards; }
  .animate-slide-right { animation: slideRight 0.8s ease-out forwards; }
  .animate-slide-up    { animation: slideUp    0.8s ease-out forwards; }
  .animate-pop-in      { animation: popIn      1s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

  @keyframes slideLeft  { from { opacity: 0; transform: translateX(-40px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes slideRight { from { opacity: 0; transform: translateX( 40px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes slideUp    { from { opacity: 0; transform: translateY( 30px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes popIn      { from { opacity: 0; transform: scale(0.95);       } to { opacity: 1; transform: scale(1);      } }

  @media (prefers-reduced-motion: reduce) {
    .animate-slide-left,
    .animate-slide-right,
    .animate-slide-up,
    .animate-pop-in {
      animation-duration: 1ms;
    }
    .brain-connector-dot {
      animation: none;
    }
  }

  /* ── Process flow diagram ─────────────────────── */
  .process-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    grid-template-rows: auto auto auto 1fr;
    row-gap: 0.5rem;
    width: min(100%, 1200px);
    margin-top: 2rem;
  }

  .process-card {
    grid-row: 1 / 5;
    display: grid;
    grid-template-rows: subgrid;
    align-content: start;
    padding: 1.75rem;
    border-radius: 1.5rem;
    cursor: default;
    transition: transform 400ms ease, border-color 400ms ease, box-shadow 400ms ease;
  }

  .process-card:hover {
    transform: translateY(-6px);
    border-color: var(--moka-border-accent);
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.28), 0 0 40px var(--moka-glow-soft);
  }

  .process-step {
    font-family: Roboto, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: rgba(110, 191, 126, 0.45);
    align-self: start;
  }

  .process-kicker {
    font-family: Roboto, sans-serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.44em;
    text-transform: uppercase;
    color: var(--fresh-green-color);
    align-self: start;
  }

  .process-title {
    font-family: Inter, sans-serif;
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    font-weight: 700;
    color: var(--pure-color);
    line-height: 1.3;
    align-self: start;
    transition: color 300ms ease;
  }

  .process-card:hover .process-title { color: var(--fresh-green-color); }

  .process-body {
    font-family: Inter, sans-serif;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--moka-text-muted);
    align-self: start;
  }

  .process-arrow {
    grid-row: 1 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    color: rgba(110, 191, 126, 0.35);
  }

  .process-arrow svg { width: 20px; height: 20px; }

  @media (max-width: 900px) {
    .process-flow {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }
    .process-card {
      grid-row: auto;
      grid-template-rows: none;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .process-arrow {
      grid-row: auto;
      width: auto;
      height: 2rem;
      transform: rotate(90deg);
    }
  }
</style>
