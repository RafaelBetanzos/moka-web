---
import Brain from "@assets/Brain.svg";
import { Image } from "astro:assets";
---

<div class="flex flex-col justify-center items-center w-full max-w-7xl mx-auto px-6 py-16 overflow-hidden bg-transparent">
  
  <div class="w-full">
    {/* Mobile Image */}
    <div class="reveal opacity-0 sm:hidden mb-12 text-center" data-animation="pop-in">
      <Image
        src={Brain}
        alt="Brain Diagram Mobile"
        class="w-56 h-auto mx-auto"
      />
    </div>

    <div class="flex flex-row w-full justify-between items-center gap-4 lg:gap-12 mb-24">
      
      {/* Left Info: Analytical Thinking */}
      <div 
        class="reveal opacity-0 flex flex-col items-start lg:items-end justify-center w-1/3 transition-transform duration-500 hover:scale-105 cursor-default group"
        data-animation="slide-left"
        style="transition-delay: 0.1s;"
      >
        <h3 class="text-xl md:text-3xl text-secondary font-bold leading-tight lg:text-right group-hover:text-black transition-colors duration-300">
          Analytical thinking
        </h3>
        <div class="w-12 h-1 bg-secondary/30 my-4 rounded-full transition-all duration-300 group-hover:w-20 group-hover:bg-secondary"></div>
        <p class="text-black font-semibold text-lg lg:text-right">Experimental lobe</p>
        <p class="text-gray-600 text-sm md:text-base lg:text-right leading-relaxed max-w-[250px]">
          AI model trained on In-house experimental data
        </p>
      </div>

      {/* Central Image: Brain.svg */}
      <div 
        class="reveal opacity-0 hidden sm:flex flex-1 justify-center items-center px-6" 
        data-animation="pop-in" 
        style="transition-delay: 0.3s;"
      >
        <Image
          src={Brain}
          alt="Brain Diagram"
          class="w-full max-w-sm lg:max-w-md h-auto object-contain transition-transform duration-1000 hover:scale-110"
        />
      </div>

      {/* Right Info: Creative Thinking */}
      <div 
        class="reveal opacity-0 flex flex-col items-start justify-center w-1/3 transition-transform duration-500 hover:scale-105 cursor-default group"
        data-animation="slide-right"
        style="transition-delay: 0.5s;"
      >
        <h3 class="text-xl md:text-3xl text-secondary font-bold leading-tight group-hover:text-black transition-colors duration-300">
          Creative thinking
        </h3>
        <div class="w-12 h-1 bg-secondary/30 my-4 rounded-full transition-all duration-300 group-hover:w-20 group-hover:bg-secondary"></div>
        <p class="text-black font-semibold text-lg">In silico lobe</p>
        <p class="text-gray-600 text-sm md:text-base leading-relaxed max-w-[250px]">
          AI model trained on In-silico data
        </p>
      </div>
    </div>
  </div>

  <div class="flex flex-col w-full gap-10 text-left lg:text-center items-start lg:items-center py-4">
    <div class="reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.1s;">
      <h1 class="font-roboto font-medium text-4xl leading-4 tracking-widest uppercase transition-transform duration-300 hover:scale-105 cursor-default inline-block">
        HOW IT WORKS
      </h1>
    </div>

    <div class="reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.3s;">
      <h2 class="text-[#4F7363FF] text-[32px] md:text-[36px] font-inter tracking-wider font-semibold transition-transform duration-300 hover:scale-105 cursor-default">
        MokaDex integrates nature's knowledge with cutting edge technology
      </h2>
    </div>

    <div class="reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.5s;">
      <p class="text-gray-600 text-[20px] md:text-[22px] font-inter font-medium leading-relaxed max-w-4xl transition-transform duration-300 hover:scale-105 cursor-default">
        MokaDex is our proprietary AI engine that serves as the digital architect for Moka’s Operating System. 
        By transforming billions of years of plant evolution into a searchable database, 
        it identifies novel bioactive molecules and their mechanisms of action with unprecedented speed.
      </p>
    </div>
  </div>
</div>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const animationType = entry.target.getAttribute('data-animation');
        entry.target.classList.add(`animate-${animationType}`);
        entry.target.classList.remove('opacity-0');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>

<style>
  .animate-slide-left { animation: slideLeft 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards; }
  .animate-slide-right { animation: slideRight 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards; }
  .animate-slide-up { animation: slideUp 0.8s ease-out forwards; }
  .animate-pop-in { animation: popIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

  @keyframes slideLeft {
    from { opacity: 0; transform: translateX(-60px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes slideRight {
    from { opacity: 0; transform: translateX(60px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 1; transform: scale(1); }
  }
</style>