---
import BrainData from "./BrainData.astro";
---

<div class="overflow-hidden bg-transparent"> <div class="flex flex-col lg:flex-row justify-between items-center py-24 max-w-7xl mx-auto px-6 md:px-12 gap-12">
    
    <div class="flex flex-col lg:w-1/3 gap-4 justify-center">
      
      <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.1s;">
        <h1 class="font-roboto font-medium text-black leading-4 tracking-widest uppercase transition-transform duration-300 hover:scale-105 cursor-default origin-left inline-block">
          HOW IT WORKS
        </h1>
      </div>

      <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.3s;">
        <h2 class="text-[#4F7363FF] text-[28px] md:text-[32px] font-inter tracking-wider font-semibold transition-transform duration-300 hover:scale-105 cursor-default origin-left">
          MokaDex integrates nature's knowledge with cutting edge technology
        </h2>
      </div>

      <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.5s;">
        <p class="text-[#BBBBBBFF] text-[18px] md:text-[20px] font-inter font-medium leading-relaxed transition-transform duration-300 hover:scale-105 cursor-default origin-left">
          MokaDex is our proprietary AI engine that serves as the digital architect for Moka’s Operating System. 
          By transforming billions of years of plant evolution into a searchable database.
        </p>
      </div>
      
    </div>

    <div 
      class="reveal opacity-0 flex-[2] w-full max-w-5xl transition-all duration-1000 hover:scale-110 hover:drop-shadow-[0_0_50px_rgba(79,115,99,0.4)]" 
      data-animation="pop-in" 
      style="transition-delay: 0.6s;"
    >
      <div class="w-full scale-110 lg:scale-125 origin-center"> <BrainData />
      </div>
    </div>

  </div>
</div>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const animationType = entry.target.getAttribute('data-animation');
        entry.target.classList.add(`animate-${animationType}`);
        entry.target.classList.remove('opacity-0');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>

<style>
  .animate-slide-in { animation: slideIn 0.8s ease-out forwards; }
  .animate-pop-in { animation: popIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

  @keyframes slideIn {
    from { opacity: 0; transform: translateX(-40px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes popIn {
    from { 
      opacity: 0; 
      transform: scale(0.8) translateY(30px); 
    }
    to { 
      opacity: 1; 
      transform: scale(1) translateY(0); 
    }
  }
</style>