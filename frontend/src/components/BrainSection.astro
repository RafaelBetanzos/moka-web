---
import Brain from "@assets/Brain.svg";
import { Image } from "astro:assets";
---

<div class="flex flex-col justify-center items-center w-full max-w-7xl mx-auto px-6 py-16 overflow-hidden bg-transparent">
  
  <div class="w-full">
    {/* Versión Mobile */}
    <div class="reveal opacity-0 sm:hidden mb-12 text-center" data-animation="pop-in">
      <Image src={Brain} alt="Brain" class="w-56 h-auto mx-auto" loading="lazy" />
    </div>

    {/* Desktop Grid */}
    <div class="brain-grid hidden sm:grid w-full mb-24">

      {/* 1. Lado Izquierdo: Analytical Thinking */}
      <div
        class="reveal opacity-0 brain-side brain-side--left group"
        data-animation="slide-left"
        style="transition-delay: 0.1s;"
      >
        <h3 class="brain-side-title group-hover:text-pure transition-colors duration-300">
          Analytical thinking
        </h3>
        <div class="brain-side-rule ml-auto transition-all duration-300 group-hover:w-20 group-hover:bg-secondary"></div>
        <p class="text-birch font-semibold text-lg">Experimental lobe</p>
        <p class="text-birch/75 text-sm md:text-base leading-relaxed max-w-[260px]">
          AI model trained on in-house experimental data
        </p>
      </div>

      {/* 2. Centro: Cerebro */}
      <div
        class="reveal opacity-0 flex justify-center items-center"
        data-animation="pop-in"
        style="transition-delay: 0.3s;"
      >
        <Image
          src={Brain}
          alt="Brain Diagram"
          class="w-full max-w-sm lg:max-w-md h-auto object-contain transition-transform duration-1000 hover:scale-110"
        />
      </div>

      {/* 3. Lado Derecho: Creative Thinking */}
      <div
        class="reveal opacity-0 brain-side brain-side--right group"
        data-animation="slide-right"
        style="transition-delay: 0.5s;"
      >
        <h3 class="brain-side-title group-hover:text-pure transition-colors duration-300">
          Creative thinking
        </h3>
        <div class="brain-side-rule mr-auto transition-all duration-300 group-hover:w-20 group-hover:bg-secondary"></div>
        <p class="text-birch font-semibold text-lg">In silico lobe</p>
        <p class="text-birch/75 text-sm md:text-base leading-relaxed max-w-[260px]">
          AI model trained on public experimental data
        </p>
      </div>
    </div>
  </div>

  {/* Sección Inferior */}
  <div class="flex flex-col w-full gap-10 text-center items-center py-4 mt-12">
    <div class="reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.1s;">
      <p class="font-roboto font-medium text-xs leading-none tracking-[0.48em] uppercase text-freshgreen">
        HOW IT WORKS
      </p>
    </div>
    <div class="reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.3s;">
      <h2 class="text-pure text-[28px] md:text-[36px] font-inter tracking-wide font-semibold max-w-3xl mx-auto text-wrap-balance">
        MokaDex integrates nature’s knowledge with <span class="text-freshgreen">cutting edge technology</span>
      </h2>
    </div>
    <div class="reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.5s;">
      <p class="text-birch/75 text-[18px] md:text-[20px] font-inter font-medium leading-relaxed max-w-3xl">
        MokaDex is our proprietary AI engine that serves as the digital architect for Moka’s Operating System.
        It identifies novel bioactive molecules and their mechanisms of action with unprecedented speed.
      </p>
    </div>
  </div>

  {/* Conector visual → ProblemSection */}
  <div class="brain-connector" aria-hidden="true">
    <div class="brain-connector-line"></div>
    <div class="brain-connector-dot"></div>
    <p class="brain-connector-label">THE PROBLEM</p>
  </div>
</div>

<script>
  const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -50px 0px' };
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const animationType = entry.target.getAttribute('data-animation');
        entry.target.classList.add(`animate-${animationType}`);
        entry.target.classList.remove('opacity-0');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>

<style>
  /* ── Brain desktop grid ───────────────────────── */
  .brain-grid {
    grid-template-columns: minmax(0, 0.72fr) minmax(360px, 1.56fr) minmax(0, 0.72fr);
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .brain-grid { gap: 2rem; }
  }

  .brain-side {
    display: flex;
    flex-direction: column;
    gap: 0;
    cursor: default;
    transition: transform 500ms ease;
  }

  .brain-side:hover { transform: scale(1.03); }

  .brain-side--left { align-items: flex-end; text-align: right; }
  .brain-side--right { align-items: flex-start; text-align: left; }

  .brain-side-title {
    font-family: Inter, sans-serif;
    font-size: clamp(1.1rem, 2.4vw, 1.75rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--fresh-green-color);
  }

  .brain-side-rule {
    width: 3rem;
    height: 4px;
    background: rgba(86, 114, 99, 0.3);
    border-radius: 999px;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  /* ── Brain → Problem connector ───────────────── */
  .brain-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding-top: 2.5rem;
    padding-bottom: 0.5rem;
  }

  .brain-connector-line {
    width: 1px;
    height: 56px;
    background: linear-gradient(180deg, rgba(110, 191, 126, 0.0), rgba(110, 191, 126, 0.42));
  }

  .brain-connector-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--fresh-green-color);
    box-shadow: 0 0 16px rgba(110, 191, 126, 0.55);
    animation: dotPulse 2.4s ease-in-out infinite;
  }

  .brain-connector-label {
    margin-top: 0.75rem;
    font-family: Roboto, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: rgba(110, 191, 126, 0.55);
  }

  @keyframes dotPulse {
    0%, 100% { transform: scale(1);    opacity: 0.7; }
    50%       { transform: scale(1.5); opacity: 1;   }
  }

  /* ── Entrance animations ─────────────────────── */
  .animate-slide-left  { animation: slideLeft  0.8s ease-out forwards; }
  .animate-slide-right { animation: slideRight 0.8s ease-out forwards; }
  .animate-slide-up    { animation: slideUp    0.8s ease-out forwards; }
  .animate-pop-in      { animation: popIn      1s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

  @keyframes slideLeft  { from { opacity: 0; transform: translateX(-40px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes slideRight { from { opacity: 0; transform: translateX( 40px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes slideUp    { from { opacity: 0; transform: translateY( 30px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes popIn      { from { opacity: 0; transform: scale(0.95);       } to { opacity: 1; transform: scale(1);      } }

  @media (prefers-reduced-motion: reduce) {
    .animate-slide-left,
    .animate-slide-right,
    .animate-slide-up,
    .animate-pop-in {
      animation-duration: 1ms;
    }
    .brain-connector-dot {
      animation: none;
    }
  }
</style>
