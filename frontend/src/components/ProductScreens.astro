---
// Moka BDE product screens. "carousel": the four screens with captions (moved from the home).
// "preview": a single static screen for the home.
interface Props {
  locale?: "en" | "es" | "pt";
  variant?: "carousel" | "preview";
}

const { locale = "en", variant = "carousel" } = Astro.props;
const copy = {
  en: {
    prev: "Previous slide",
    next: "Next slide",
    slides: [
      { src: "/mockups/PlatformMockup.svg", label: "Platform overview", desc: "One environment for your whole discovery workflow, shaped to your industry." },
      { src: "/mockups/Explore.svg", label: "Explore Icaros", desc: "Species, compounds, and evidence in a single search." },
      { src: "/mockups/VirtualLab.svg", label: "Virtual Lab", desc: "Predict mechanisms and bioactivity without writing a line of code." },
      { src: "/mockups/WetLab.svg", label: "Wet Lab", desc: "Your lab results, connected to everything else." },
    ],
  },
  es: {
    prev: "Anterior",
    next: "Siguiente",
    slides: [
      { src: "/mockups/PlatformMockup.svg", label: "Vista general", desc: "Un solo entorno para todo tu flujo de descubrimiento, adaptado a tu industria." },
      { src: "/mockups/Explore.svg", label: "Explora Icaros", desc: "Especies, compuestos y evidencia en una sola búsqueda." },
      { src: "/mockups/VirtualLab.svg", label: "Laboratorio Virtual", desc: "Predice mecanismos y bioactividad sin escribir una línea de código." },
      { src: "/mockups/WetLab.svg", label: "Wet Lab", desc: "Tus resultados de laboratorio, conectados con todo lo demás." },
    ],
  },
  pt: {
    prev: "Anterior",
    next: "Próximo",
    slides: [
      { src: "/mockups/PlatformMockup.svg", label: "Visão geral", desc: "Um só ambiente para todo o seu fluxo de descoberta, adaptado à sua indústria." },
      { src: "/mockups/Explore.svg", label: "Explore o Icaros", desc: "Espécies, compostos e evidências em uma só busca." },
      { src: "/mockups/VirtualLab.svg", label: "Laboratório Virtual", desc: "Preveja mecanismos e bioatividade sem escrever uma linha de código." },
      { src: "/mockups/WetLab.svg", label: "Wet Lab", desc: "Seus resultados de laboratório, conectados a todo o resto." },
    ],
  },
}[locale];
---

{variant === "preview" ? (
  <div class="moka-carousel moka-carousel--static reveal opacity-0" data-animation="pop-in" style="transition-delay: 0.15s;">
    <div class="moka-slide">
      <img class="moka-slide-img" src={copy.slides[0].src} alt={`Moka BDE: ${copy.slides[0].label}`} width="1440" height="810" loading="lazy" decoding="async" />
    </div>
  </div>
) : (
  <div class="moka-carousel reveal opacity-0" id="moka-carousel" role="region" aria-roledescription="carousel" aria-label="Moka BDE" data-animation="pop-in" style="transition-delay: 0.15s;">
    <div class="moka-carousel-track" id="moka-carousel-track">
      {copy.slides.map((slide) => (
        <div class="moka-slide">
          <img class="moka-slide-img" src={slide.src} alt="" width="1440" height="810" loading="lazy" />
          <div class="moka-slide-content">
            <p class="moka-slide-label">{slide.label}</p>
            <p class="moka-slide-desc">{slide.desc}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="moka-progress-bar" aria-hidden="true">
      <div class="moka-progress-fill" id="moka-progress-fill"></div>
    </div>
    <div class="moka-dots">
      <button type="button" class="moka-arrow" data-dir="-1" aria-label={copy.prev}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
      {copy.slides.map((slide, i) => (
        <button type="button" aria-current={i === 0 ? "true" : undefined} class:list={["moka-dot", i === 0 && "is-active"]} data-slide={i} aria-label={slide.label}></button>
      ))}
      <button type="button" class="moka-arrow" data-dir="1" aria-label={copy.next}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
    </div>
  </div>
)}

<script>
  // ── Moka carousel ─────────────────────────────────────────────────
  (function () {
    const carousel = document.getElementById('moka-carousel');
    if (!carousel) return;

    const trackEl = document.getElementById('moka-carousel-track');
    if (!trackEl) return;
    const track: HTMLElement = trackEl;
    const fill  = document.getElementById('moka-progress-fill');
    const slides = Array.from(track.querySelectorAll('.moka-slide'));
    const dots   = Array.from(carousel.querySelectorAll('.moka-dot'));

    const DURATION = 7000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    let manual = false; // once the visitor navigates, autoplay stops for good

    function goTo(idx: number, snap = false) {
      const next = ((idx % slides.length) + slides.length) % slides.length;
      if (snap) {
        track.style.transition = 'none';
        track.style.transform = `translateX(-${next * 100}%)`;
        track.offsetWidth;
        track.style.transition = '';
      } else {
        track.style.transform = `translateX(-${next * 100}%)`;
      }
      current = next;
      dots.forEach((d, i) => {
        d.classList.toggle('is-active', i === current);
        i === current ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current');
      });
      if (timer) resetProgress();
    }

    function resetProgress() {
      if (!fill) return;
      fill.style.transition = 'none';
      fill.style.width = '0%';
      fill.offsetWidth;
      fill.style.transition = `width ${DURATION}ms linear`;
      fill.style.width = '100%';
    }

    function startAuto() {
      if (timer || manual || reduceMotion) return;
      timer = setInterval(() => {
        const next = (current + 1) % slides.length;
        goTo(next, next === 0);
      }, DURATION);
      resetProgress();
    }

    function stopAuto() {
      if (timer) clearInterval(timer);
      timer = null;
      if (fill) { fill.style.transition = 'none'; fill.style.width = '0%'; }
    }

    function takeControl(idx: number) {
      manual = true;
      stopAuto();
      goTo(idx);
    }

    dots.forEach((dot, i) => dot.addEventListener('click', () => takeControl(i)));
    carousel.querySelectorAll('.moka-arrow').forEach((btn) => {
      btn.addEventListener('click', () => takeControl(current + Number(btn.getAttribute('data-dir'))));
    });
    carousel.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') takeControl(current + 1);
      if (e.key === 'ArrowLeft') takeControl(current - 1);
    });

    // Pause while the pointer or keyboard focus is inside; resume on leave
    carousel.addEventListener('mouseenter', stopAuto);
    carousel.addEventListener('mouseleave', startAuto);
    carousel.addEventListener('focusin', stopAuto);

    let tx = 0;
    carousel.addEventListener('touchstart', e => { tx = e.touches[0].clientX; }, { passive: true });
    carousel.addEventListener('touchend', e => {
      const dx = e.changedTouches[0].clientX - tx;
      if (Math.abs(dx) > 40) takeControl(dx < 0 ? current + 1 : current - 1);
    });

    new IntersectionObserver(entries => {
      entries.forEach(e => e.isIntersecting ? startAuto() : stopAuto());
    }, { threshold: 0.2 }).observe(carousel);
  })();
</script>

<style>
  /* ── Carousel ─────────────────────────────────── */
  .moka-carousel {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 1.75rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(18, 18, 18, 0.62);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(22px);
    overflow: hidden;
  }

  .moka-carousel::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at 28% 0%, rgba(110, 191, 126, 0.10), transparent 55%);
    pointer-events: none;
    z-index: 0;
  }

  .moka-carousel-track {
    display: flex;
    flex: 1;
    min-height: 0;
    transition: transform 620ms cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    z-index: 1;
  }

  .moka-slide {
    flex: 0 0 100%;
    min-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding: 2rem 1.75rem 1.5rem;
  }

  .moka-slide-img {
    display: block;
    width: 100%;
    pointer-events: none;
  }

  .moka-slide-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
  }

  .moka-slide-label {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.30em;
    text-transform: uppercase;
    color: rgba(110, 191, 126, 0.80);
    text-align: center;
  }

  .moka-slide-desc {
    font-family: Inter, sans-serif;
    font-size: 17px;
    line-height: 1.68;
    color: rgba(222, 222, 222, 0.58);
    text-align: center;
    max-width: 340px;
  }

  /* Progress bar — thin green fill at bottom of image area */
  .moka-progress-bar {
    position: relative;
    z-index: 1;
    height: 2px;
    background: rgba(110, 191, 126, 0.10);
    overflow: hidden;
  }

  .moka-progress-fill {
    height: 100%;
    width: 0%;
    background: var(--fresh-green-color);
    box-shadow: 0 0 8px rgba(110, 191, 126, 0.55);
  }

  /* Dot navigation */
  .moka-dots {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.6rem 1rem 0.9rem;
  }

  /* 32px hit area around a small visual dot */
  .moka-dot {
    display: inline-flex;
    height: 32px;
    min-width: 32px;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }

  .moka-dot::before {
    content: "";
    height: 7px;
    width: 7px;
    border-radius: 999px;
    background: rgba(222, 222, 222, 0.28);
    transition: background 300ms ease, width 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .moka-dot:hover::before { background: rgba(222, 222, 222, 0.6); }

  .moka-dot.is-active::before {
    width: 24px;
    background: var(--fresh-green-color);
    box-shadow: 0 0 8px rgba(110, 191, 126, 0.45);
  }

  .moka-dot:focus-visible,
  .moka-arrow:focus-visible {
    outline: 2px solid var(--fresh-green-color);
    outline-offset: 2px;
    border-radius: 999px;
  }

  .moka-arrow {
    display: inline-flex;
    height: 36px;
    width: 36px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(222, 222, 222, 0.22);
    background: rgba(18, 18, 18, 0.5);
    color: var(--birch-color);
    cursor: pointer;
    transition: background 200ms ease, color 200ms ease, border-color 200ms ease;
  }

  .moka-arrow:first-child { margin-right: 0.5rem; }
  .moka-arrow:last-child { margin-left: 0.5rem; }

  .moka-arrow:hover {
    background: var(--fresh-green-color);
    border-color: var(--fresh-green-color);
    color: var(--charcoal-color);
  }

  .moka-arrow svg { width: 16px; height: 16px; }

  .moka-carousel--static .moka-slide {
    padding: 1.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .moka-progress-fill {
      transition: none !important;
    }
  }
</style>
