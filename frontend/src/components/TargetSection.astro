---
interface Props {
  locale?: "en" | "es" | "pt";
  /** "full": the original two-starting-points block with CTAs. "links": two short cards linking to the journey pages. */
  variant?: "full" | "links";
  /** Heading for the links variant: the home "How we create value" or the "Same technology, two starting points" heading. */
  heading?: "pathways" | "starting";
  id?: string;
}

const { locale = "en", variant = "full", heading = "starting", id } = Astro.props;
const contactBase = locale === "en" ? "/contact-us" : `/${locale}/contact-us`;
const localePrefix = locale === "en" ? "" : `/${locale}`;
const pathways = {
  en: {
    title: "There are two ways to get there.",
    startTitle: "I want to develop a new natural product.",
    startIntro: "Where do I start?",
    intro: "",
    cards: [
      { key: "plant", strategy: "PLANT PUSH", title: "I have a plant, but I don't know where to start.", body: "Find out what it could become.", link: "Start with a plant", path: "/plant-potential/" },
      { key: "need", strategy: "MARKET PULL", title: "I know what I need, but not how to develop the bioactive.", body: "Find the plant that could deliver it.", link: "Start with a need", path: "/find-your-plant/" },
    ],
  },
  es: {
    title: "Hay dos formas de hacerlo.",
    startTitle: "Quiero desarrollar un nuevo producto natural.",
    startIntro: "¿Por dónde empiezo?",
    intro: "",
    cards: [
      { key: "plant", strategy: "PLANT PUSH", title: "Tengo una planta, pero no sé por dónde empezar.", body: "Descubre en qué podría convertirse.", link: "Empieza con una planta", path: "/plant-potential/" },
      { key: "need", strategy: "MARKET PULL", title: "Sé lo que necesito, pero no cómo desarrollar el bioactivo.", body: "Encuentra la planta que podría lograrlo.", link: "Empieza con una necesidad", path: "/find-your-plant/" },
    ],
  },
  pt: {
    title: "Há duas formas de fazer isso.",
    startTitle: "Quero desenvolver um novo produto natural.",
    startIntro: "Por onde começo?",
    intro: "",
    cards: [
      { key: "plant", strategy: "PLANT PUSH", title: "Tenho uma planta, mas não sei por onde começar.", body: "Descubra no que ela pode se transformar.", link: "Comece com uma planta", path: "/plant-potential/" },
      { key: "need", strategy: "MARKET PULL", title: "Sei do que preciso, mas não como desenvolver o bioativo.", body: "Encontre a planta que pode entregar isso.", link: "Comece com uma necessidade", path: "/find-your-plant/" },
    ],
  },
}[locale];
const copy = {
  en: {
    kicker: "How we work with you",
    ctaDemo: "Book a demo",
    ctaService: "Request a service",
    titleA: "Same technology,",
    titleB: "two starting points",
    bodyA: "With the platform or with a service, it all starts in one of two ways.",
    now: "PLANT PUSH",
    next: "MARKET PULL",
    nowTitle: "You have a plant. What is it hiding?",
    nextTitle: "You have a need. Which plant solves it?",
    nowItems: ["A native species, your own crop, a plant someone has always used.", "We find out what it can do.", "We take it to extract, fraction, or molecule."],
    nextItems: ["Tell us which active or benefit you are looking for.", "We search Latin American flora until we find your candidates.", "We develop them to the level you need."],
  },
  es: {
    kicker: "Cómo trabajamos contigo",
    ctaDemo: "Agendar demo",
    ctaService: "Solicitar servicio",
    titleA: "Misma tecnología,",
    titleB: "dos puntos de partida",
    bodyA: "Con la plataforma o con un servicio, todo empieza de una de dos formas.",
    now: "PLANT PUSH",
    next: "MARKET PULL",
    nowTitle: "Tienes una planta. ¿Qué esconde?",
    nextTitle: "Tienes una necesidad. ¿Qué planta la resuelve?",
    nowItems: ["Una especie nativa, un cultivo propio, una planta que alguien siempre ha usado.", "Descubrimos de qué es capaz.", "La llevamos hasta extracto, fracción o molécula."],
    nextItems: ["Dinos qué activo o beneficio buscas.", "Recorremos la flora latinoamericana hasta encontrar a tus candidatos.", "Los desarrollamos hasta el nivel que necesitas."],
  },
  pt: {
    kicker: "Como trabalhamos com você",
    ctaDemo: "Agendar demonstração",
    ctaService: "Solicitar serviço",
    titleA: "Mesma tecnologia,",
    titleB: "dois pontos de partida",
    bodyA: "Com a plataforma ou com um serviço, tudo começa de uma de duas formas.",
    now: "PLANT PUSH",
    next: "MARKET PULL",
    nowTitle: "Você tem uma planta. O que ela esconde?",
    nextTitle: "Você tem uma necessidade. Qual planta a resolve?",
    nowItems: ["Uma espécie nativa, um cultivo próprio, uma planta que alguém sempre usou.", "Descobrimos do que ela é capaz.", "Nós a levamos até extrato, fração ou molécula."],
    nextItems: ["Diga qual ativo ou benefício você busca.", "Percorremos a flora latino-americana até encontrar seus candidatos.", "Nós os desenvolvemos até o nível que você precisa."],
  },
}[locale];
---

{variant === "links" ? (
<section id={id} class="target-links relative z-10 w-full bg-transparent">
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-20 lg:py-24">
    <div class="target-links-head reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.1s;">
      <h2 class="text-[clamp(1.9rem,3.4vw,3rem)] leading-[1.05] font-semibold font-inter text-pure">{heading === "pathways" ? pathways.title : pathways.startTitle}</h2>
      {(heading === "pathways" ? pathways.intro : pathways.startIntro) && (
        <p class="mt-4 max-w-2xl text-birch/75 font-inter font-medium text-[20px] leading-relaxed">{heading === "pathways" ? pathways.intro : pathways.startIntro}</p>
      )}
    </div>

    <div class="target-links-grid">
      {pathways.cards.map((card, i) => (
        <a
          id={card.key === "plant" ? "plant-push" : "market-pull"}
          href={`${localePrefix}${card.path}`}
          class="target-link-card target-card target-card--now group reveal opacity-0 no-underline"
          data-animation="slide-up"
          data-analytics-event="journey_click"
          data-analytics-category="pathways"
          data-analytics-label={`${heading}_${card.key}`}
          style={`transition-delay: ${0.3 + i * 0.15}s;`}
        >
          <div class="target-card-header">
            <div class="target-card-icon" aria-hidden="true">
              {card.key === "plant" ? (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 28 C16 16 6 10 4 4 C12 4 22 10 16 28Z"/>
                  <path d="M16 28 C16 18 24 13 28 8 C22 8 14 14 16 28Z"/>
                  <path d="M16 14 L16 28"/>
                </svg>
              ) : (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="16" cy="16" r="11"/>
                  <circle cx="16" cy="16" r="6.5"/>
                  <circle cx="16" cy="16" r="2"/>
                </svg>
              )}
            </div>
            <div>
              <p class="target-card-phase target-card-phase--now">{card.strategy}</p>
              <h3 class="target-card-title group-hover:text-pure transition-colors duration-300">{card.title}</h3>
            </div>
          </div>
          <div class="target-card-divider target-card-divider--now"></div>
          <p class="text-birch/80 text-[17px] leading-relaxed">{card.body}</p>
          <span class="target-link-label">{card.link} <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>

  </div>
</section>
) : (
<div class="relative z-10 w-full overflow-hidden bg-transparent">
  <div class="flex flex-col lg:flex-row justify-between items-start py-24 max-w-7xl mx-auto px-6 md:px-12 gap-12 lg:gap-24">
    
    <div class="flex-1 flex flex-col justify-center">
      <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.1s;">
        <p class="font-roboto font-bold text-[13px] leading-none tracking-[0.48em] text-freshgreen uppercase mb-6">
          {copy.kicker}
        </p>
      </div>

      <div class="reveal opacity-0 pb-8 leading-tight" data-animation="slide-in" style="transition-delay: 0.3s;">
        <h2 class="text-[clamp(1.9rem,3.4vw,3rem)] leading-[1.05] font-semibold font-inter">
          <span class="text-freshgreen">{copy.titleA}</span><br/>
          <span class="text-pure">{copy.titleB}</span>
        </h2>
      </div>

      <div class="reveal opacity-0 flex flex-col gap-4" data-animation="slide-in" style="transition-delay: 0.5s;">
        <p class="text-birch/75 font-inter font-medium text-[18px] leading-relaxed xl:pr-10">
          {copy.bodyA}
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href={`${contactBase}?interest=demo`} class="moka-demo-cta" data-analytics-event="book_demo_click" data-analytics-category="cta" data-analytics-label="tech_target">{copy.ctaDemo} <span aria-hidden="true">→</span></a>
          <a href={`${contactBase}?interest=service`} class="target-service-cta" data-analytics-event="request_service_click" data-analytics-category="cta" data-analytics-label="tech_target">{copy.ctaService} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-8 flex-1 w-full">
      
      {/* Card: plant push */}
      <div
        class="reveal opacity-0 target-card target-card--now group cursor-default"
        data-animation="slide-up"
        style="transition-delay: 0.6s;"
      >
        <div class="target-card-header">
          <div class="target-card-icon">
            {/* Plant icon */}
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 28 C16 16 6 10 4 4 C12 4 22 10 16 28Z"/>
              <path d="M16 28 C16 18 24 13 28 8 C22 8 14 14 16 28Z"/>
              <path d="M16 14 L16 28"/>
            </svg>
          </div>
          <div>
            <p class="target-card-phase target-card-phase--now">{copy.now}</p>
            <h3 class="target-card-title group-hover:text-pure transition-colors duration-300">
              {copy.nowTitle}
            </h3>
          </div>
        </div>
        <div class="target-card-divider target-card-divider--now"></div>
        <ul class="space-y-4 list-none text-birch/80 text-[17px]">
          {copy.nowItems.map((item) => (
            <li class="flex items-start gap-3 transition-transform duration-300 group-hover:translate-x-2">
              <span class="target-bullet target-bullet--now">▸</span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      {/* Card: market pull */}
      <div
        class="reveal opacity-0 target-card target-card--now group cursor-default"
        data-animation="slide-up"
        style="transition-delay: 0.8s;"
      >
        <div class="target-card-header">
          <div class="target-card-icon target-card-icon--now">
            {/* Target icon: starting from a need */}
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="16" cy="16" r="11"/>
              <circle cx="16" cy="16" r="6.5"/>
              <circle cx="16" cy="16" r="2"/>
            </svg>
          </div>
          <div>
            <p class="target-card-phase target-card-phase--now">{copy.next}</p>
            <h3 class="target-card-title group-hover:text-pure transition-colors duration-300">
              {copy.nextTitle}
            </h3>
          </div>
        </div>
        <div class="target-card-divider target-card-divider--now"></div>
        <ul class="space-y-4 list-none text-birch/80 text-[17px]">
          {copy.nextItems.map((item) => (
            <li class="flex items-start gap-3 transition-transform duration-300 group-hover:translate-x-2">
              <span class="target-bullet target-bullet--now">▸</span>
              {item}
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</div>
)}

<style>
  /* Reached from the home path (#plant-push / #market-pull): clear the fixed navbar. */
  .target-link-card { scroll-margin-top: 7rem; }
  .target-links { scroll-margin-top: 5rem; }

  .target-links-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .target-link-card {
    display: flex;
    flex-direction: column;
    color: inherit;
  }

  .target-link-label {
    margin-top: auto;
    padding-top: 1.75rem;
    font-family: Inter, sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: var(--fresh-green-color);
  }

  @media (max-width: 900px) {
    .target-links-grid { grid-template-columns: 1fr; }
  }

  /* ── Target cards shared ─────────────────────── */
  .target-card {
    padding: 2rem;
    border-radius: 2rem;
    shadow: 0 24px 80px rgba(0,0,0,0.24);
    transition: transform 500ms ease, border-color 500ms ease, box-shadow 500ms ease;
  }

  .target-card:hover { transform: translateY(-6px); }

  /* NOW — verde fresco */
  .target-card--now {
    background: linear-gradient(145deg, rgba(19, 45, 37, 0.82), rgba(18, 18, 18, 0.62));
    border: 1px solid rgba(110, 191, 126, 0.30);
    box-shadow: 0 24px 80px rgba(0,0,0,0.22), 0 0 40px rgba(110,191,126,0.06);
  }

  .target-card--now:hover {
    border-color: rgba(110, 191, 126, 0.55);
    box-shadow: 0 28px 90px rgba(0,0,0,0.28), 0 0 60px rgba(110,191,126,0.12);
  }

  /* NEXT — gris neutro */
  /* ── Card header ─────────────────────────────── */
  .target-card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .target-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 0.875rem;
    background: rgba(110, 191, 126, 0.10);
    color: var(--fresh-green-color);
  }

  .target-card-icon svg {
    width: 26px;
    height: 26px;
  }

  .target-card-phase {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.44em;
    text-transform: uppercase;
    margin-bottom: 0.2rem;
  }

  .target-card-phase--now  { color: rgba(110, 191, 126, 0.75); }
  .target-card-title {
    font-family: Inter, sans-serif;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--pure-color);
  }

  /* ── Dividers ────────────────────────────────── */
  .target-card-divider {
    height: 1px;
    margin-bottom: 1.5rem;
    border-radius: 999px;
  }

  .target-card-divider--now  { background: linear-gradient(90deg, rgba(110,191,126,0.35), transparent); }
  /* ── Bullets ─────────────────────────────────── */
  .target-bullet {
    flex-shrink: 0;
    font-size: 13px;
    margin-top: 0.25rem;
  }

  .target-bullet--now  { color: var(--fresh-green-color); }
  /* ── Entrance animations ─────────────────────── */
  .animate-slide-in { animation: slideIn 0.8s ease-out forwards; }
  .animate-slide-up { animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

  @keyframes slideIn { from { opacity: 0; transform: translateX(-40px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes slideUp { from { opacity: 0; transform: translateY(50px);  } to { opacity: 1; transform: translateY(0); } }

  @media (prefers-reduced-motion: reduce) {
    .animate-slide-in,
    .animate-slide-up {
      animation-duration: 1ms;
    }
  }

  .target-service-cta {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    background: var(--pure-color);
    color: var(--charcoal-color);
    font-family: Inter, sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 280ms ease, background 280ms ease;
  }

  .target-service-cta:hover,
  .target-service-cta:focus-visible {
    transform: translateY(-2px);
    background: var(--fresh-green-color);
  }
</style>
