---
import BaseLayout from "@layouts/BaseLayout.astro";
import BotanicalScrollReveal from "@components/BotanicalScrollReveal.astro";
import TrustSection from "@components/TrustSection.astro";
import "../styles/seo-landing.css";
import { industries, industryBotanical, industryLabels, industrySlugs, journeyBullet, type IndustrySlug } from "../data/industries";
import { countries, countrySlugs } from "../data/countries";
import type { Locale } from "../data/sitePages";

interface Props {
  slug: IndustrySlug;
  locale: Locale;
}

const { slug, locale } = Astro.props;
const t = industries[slug][locale];
const l = industryLabels[locale];
const prefix = locale === "en" ? "" : `/${locale}`;
const contactBase = `${prefix}/contact-us`;
const others = industrySlugs.filter((s) => s !== slug);

const schema = [
  {
    "@type": "FAQPage",
    mainEntity: t.faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
  {
    "@type": "Service",
    name: `Moka Bio — ${t.name}`,
    serviceType: t.name,
    description: t.metaDescription,
    areaServed: "Latin America",
    provider: { "@id": "https://moka.bio/#organization" },
  },
];
---

<BaseLayout lang={locale} title={t.metaTitle} description={t.metaDescription} breadcrumb={t.name} schema={schema}>
  <div class="industry-page relative overflow-hidden">
    <BotanicalScrollReveal src={industryBotanical[slug]} tone="strong" class="tech-botanical-focus" revealStart={-0.15} />

    <!-- Hero -->
    <header class="industry-hero">
      <p class="industry-kicker reveal opacity-0" data-animation="slide-up">{l.kicker} · {t.name.toUpperCase()}</p>
      <h1 class="industry-title reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.1s;">{t.title}</h1>
      <p class="industry-lead reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.2s;">{t.lead}</p>
      <div class="industry-ctas reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.3s;">
        <a href={`${contactBase}?interest=demo`} class="moka-demo-cta" data-analytics-event="book_demo_click" data-analytics-category="cta" data-analytics-label={`industry_${slug}_hero`}>{l.demo} <span aria-hidden="true">→</span></a>
        <a href={`${contactBase}?interest=service`} class="industry-secondary" data-analytics-event="request_service_click" data-analytics-category="cta" data-analytics-label={`industry_${slug}_hero`}>{l.service} <span aria-hidden="true">→</span></a>
      </div>
    </header>

    <!-- Challenges -->
    <section class="industry-section">
      <h2 class="industry-h2 reveal opacity-0" data-animation="slide-up">{t.challengeTitle}</h2>
      <div class="industry-grid industry-grid--3">
        {t.challenges.map((c, i) => (
          <article class="industry-card reveal opacity-0" data-animation="pop-in" style={`transition-delay: ${0.1 + i * 0.1}s;`}>
            <span class="industry-index">0{i + 1}</span>
            <h3 class="industry-card-title">{c.title}</h3>
            <p class="industry-card-body">{c.body}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- What you can do -->
    <section class="industry-section">
      <h2 class="industry-h2 reveal opacity-0" data-animation="slide-up">{l.doTitle}</h2>
      <div class="industry-grid industry-grid--2">
        <article class="industry-card industry-card--accent reveal opacity-0" data-animation="pop-in">
          <p class="industry-tag">{l.platformTitle} · Moka BDE</p>
          <ul class="industry-list">
            {t.platform.map((item) => <li>{item}</li>)}
          </ul>
          <div class="industry-card-links">
            <a href={`${contactBase}?interest=demo`} class="industry-link">{l.demo} <span aria-hidden="true">→</span></a>
            <a href={`${prefix}/platform/`} class="industry-link">{l.platformLink} <span aria-hidden="true">→</span></a>
          </div>
        </article>
        <article class="industry-card reveal opacity-0" data-animation="pop-in" style="transition-delay: 0.1s;">
          <p class="industry-tag">{l.serviceTitle}</p>
          <ul class="industry-list">
            {t.service.map((item) => {
              const j = journeyBullet(item, locale);
              return <li>{j ? <><a class="industry-inline-link" href={j.href}>{j.label}</a>: {j.rest}</> : item}</li>;
            })}
          </ul>
          <div class="industry-card-links">
            <a href={`${contactBase}?interest=service`} class="industry-link">{l.service} <span aria-hidden="true">→</span></a>
            <a href={`${prefix}/services/`} class="industry-link">{l.servicesLink} <span aria-hidden="true">→</span></a>
          </div>
        </article>
      </div>
    </section>

    <!-- Questions -->
    <section class="industry-section">
      <h2 class="industry-h2 reveal opacity-0" data-animation="slide-up">{l.questionsTitle}</h2>
      <p class="industry-intro reveal opacity-0" data-animation="slide-up">{l.questionsIntro}</p>
      <ul class="industry-questions">
        {t.questions.map((q, i) => (
          <li class="industry-question reveal opacity-0" data-animation="pop-in" style={`transition-delay: ${0.1 + i * 0.08}s;`}>“{q}”</li>
        ))}
      </ul>
      {t.research && (
        <a class="industry-research reveal opacity-0" data-animation="slide-up" href={t.research.href} target={t.research.href.startsWith("http") ? "_blank" : undefined} rel={t.research.href.startsWith("http") ? "noopener noreferrer" : undefined}>
          <span class="industry-tag">{l.researchTitle}</span>
          <span class="industry-research-label">{t.research.label} <span aria-hidden="true">↗</span></span>
        </a>
      )}
    </section>

    <!-- FAQ -->
    <section class="industry-section">
      <h2 class="industry-h2 reveal opacity-0" data-animation="slide-up">{l.faqTitle}</h2>
      <div class="industry-faq">
        {t.faq.map((item) => (
          <details class="industry-faq-item" name={`faq-${slug}`}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Other industries -->
    <nav class="industry-section" aria-label={l.othersTitle}>
      <h2 class="industry-h2 industry-h2--sm">{l.othersTitle}</h2>
      <div class="industry-grid industry-grid--3">
        {others.map((s) => (
          <a class="industry-other" href={`${prefix}/industries/${s}/`}>
            <span>{industries[s][locale].name}</span>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </nav>

    <!-- By country -->
    <nav class="industry-section" aria-label={l.countriesTitle}>
      <h2 class="industry-h2 industry-h2--sm">{l.countriesTitle}</h2>
      <div class="industry-grid country-grid--4">
        {countrySlugs.map((c) => (
          <a class="industry-other" href={`${prefix}/countries/${c}/`}>
            <span>{countries[c][locale].name}</span>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </nav>

    <TrustSection locale={locale} />
  </div>
</BaseLayout>

<script>
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const type = entry.target.getAttribute("data-animation");
      entry.target.classList.add(`animate-${type}`);
      entry.target.classList.remove("opacity-0");
      revealObserver.unobserve(entry.target);
    });
  }, { threshold: 0.1, rootMargin: "0px 0px -50px 0px" });
  document.querySelectorAll(".reveal").forEach((el) => revealObserver.observe(el));
</script>
