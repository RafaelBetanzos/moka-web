---
import { Image } from "astro:assets";
import Rafa from "@assets/icons/Rafa.svg";
import LinkedIn from "@assets/LinkedIn.svg";
---

<div class="flex flex-col gap-4">
  <p
    class="text-secondary font-inter font-semibold xl:text-[18px] lg:text-[16px] md:text-[16px] leading-12 mt-12 text-center mb-16"
  >
    TEAM MEMBERS
  </p>
  <div class="flex gap-12">
    <div>
      <div>
        <Image src={Rafa} alt="Rafa" class="rounded-full" />
        <Image
          src={LinkedIn}
          alt="Linkedin"
          class="relative z-10 left-[44%] bottom-4"
        />
      </div>
      <div class="flex flex-col items-center">
        <p class="text-card font font-bold text-[20px]">CEO</p>
        <p class="text-secondary font font-bold text-[20px]">Rafael Betanzos</p>
      </div>
    </div>
