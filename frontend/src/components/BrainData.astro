---
import Brain from "@assets/Brain.svg";
import { Image } from "astro:assets";
---

<div class="flex flex-col justify-center items-center w-full max-w-5xl mx-auto px-4">
  
  {/* Imagen para móviles (se oculta en sm:block) */}
  <Image
    src={Brain}
    alt="Brain Diagram Mobile"
    class="w-48 h-auto sm:hidden mb-8"
  />

  <div class="flex h-fit w-full justify-between items-center gap-4 md:gap-8">
    
    {/* Tarjeta Izquierda: Analytical */}
    <div class="bg-white rounded-2xl shadow-xl p-4 font-inter flex flex-col items-center justify-center w-full max-w-[200px] h-72 border border-gray-100">
      <h3 class="text-lg md:text-xl text-secondary text-center font-bold leading-tight">
        Analytical thinking
      </h3>
      <div class="w-8 h-1 bg-secondary/20 my-3 rounded-full"></div>
      <p class="text-black font-semibold text-sm md:text-base text-center mb-2">
        Experimental lobe
      </p>
      <p class="text-gray-500 text-xs md:text-sm text-center leading-relaxed">
        AI model trained on In-house experimental data
      </p>
    </div>

    {/* Imagen Central (Desktop) */}
    <div class="hidden sm:flex flex-1 justify-center items-center px-4">
      <Image
        src={Brain}
        alt="Brain Diagram"
        class="w-full max-w-xs md:max-w-sm lg:max-w-md h-auto object-contain"
      />
    </div>

    {/* Tarjeta Derecha: Creative */}
    <div class="bg-white rounded-2xl shadow-xl p-4 font-inter flex flex-col items-center justify-center w-full max-w-[200px] h-72 border border-gray-100">
      <h3 class="text-lg md:text-xl text-secondary text-center font-bold leading-tight">
        Creative thinking
      </h3>
      <div class="w-8 h-1 bg-secondary/20 my-3 rounded-full"></div>
      <p class="text-black font-semibold text-sm md:text-base text-center mb-2">
        In silico lobe
      </p>
      <p class="text-gray-500 text-xs md:text-sm text-center leading-relaxed">
        AI model trained on In-silico data
      </p>
    </div>

  </div>
</div>