---
import { Image } from "astro:assets";
import Brain from "@assets/Brain.svg";
---

<div class="flex xl:gap-6 lg:gap-4 md:gap-8 h-fit">
  <div
    class="bg-white rounded-lg shadow-md p-1 mt-24 font-inter flex flex-col items-center justify-center h-fit xl:w-[152px] lg:w-[149px] md:w-[130px]"
  >
    <h1
      class="xl:text-[24px] lg:text-[18px] text-secondary font-medium text-center px-3 mt-3"
    >
      Analytical thinking
    </h1>
    <p
      class="text-black xl:text-[20px] lg:text-[16px] text-center mt-4 mb-1 lg:mb-4 lg:px-2"
    >
      Experimental lobe
    </p>
    <p
      class="text-[#989898FF] xl:text-[16px] lg:text-[16px] md:text-[13px] text-center px-[8px] mb-3"
    >
      AI model trained on In-house experimental data
    </p>
  </div>
  <Image
    src={Brain}
    alt="Brain"
    class="w-[50%] md:w-[40%] md:mt-16 object-fit"
  />
  <div
    class="bg-white rounded-lg shadow-md p-4 mt-24 font-inter flex flex-col items-center justify-center h-fit xl:w-[152px] lg:w-[150px] md:w-[130px]"
  >
    <h1
      class="xl:text-[24px] lg:text-[18px] md:text-[18px] text-secondary font-medium text-center px-3"
    >
      Creative thinking
    </h1>
    <p
      class="text-black xl:text-[20px] lg:text-[17px] whitespace-nowrap my-6 lg:my-3 lg:px-8 xl:mt-6 md:mt-2"
    >
      In silico lobe
    </p>

    <p
      class="text-[#989898FF] xl:text-[16px] lg:text-[16px] md:text-[13px] text-center lg:px-[16px] xl:mb-4 md:mb-4 lg:mb-6 xl:mt-3 lg:mt-2 md:mt-2"
    >
      AI model trained on In-silico data
    </p>
  </div>
</div>
