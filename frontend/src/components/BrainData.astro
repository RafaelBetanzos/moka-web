---
import Brain from "@assets/Brain.svg";
import { Image } from "astro:assets";
---

<div class="flex flex-col justify-center items-center">
  <Image
    src={Brain}
    alt="Brain"
    class="md:mt-16 object-fit sm:mx-8 w-64 sm:hidden mb-4"
  />
  <div class="flex h-fit w-full justify-between items-center gap-2">
    <div
      class="bg-white rounded-lg shadow-md p-1 font-inter flex flex-col items-center justify-center w-36 h-64"
    >
      <h1
        class="text-lg md:text-2xl text-secondary text-center px-3 mt-3 font-bold"
      >
        Analytical thinking
      </h1>
      <p
        class="text-black md:text-lg text-sm text-center mt-4 mb-1 lg:mb-4 lg:px-2"
      >
        Experimental lobe
      </p>
      <p class="text-[#989898FF] md:text-md text-sm text-center px-[8px] mb-3">
        AI model trained on In-house experimental data
      </p>
    </div>
    <Image
      src={Brain}
      alt="Brain"
      class="md:mt-16 object-fit sm:mx-8 w-32 hidden sm:block sm:w-48 md:w-64 lg:w-full"
    />
    <div
      class="bg-white rounded-lg shadow-md p-1 font-inter flex flex-col items-center justify-center w-36 h-64"
    >
      <h1
        class="text-lg md:text-2xl text-secondary text-center px-3 mt-3 font-bold"
      >
        Creative thinking
      </h1>
      <p
        class="text-black md:text-lg text-sm text-center mt-4 mb-1 lg:mb-4 lg:px-2"
      >
        In silico lobe
      </p>

      <p
        class="text-[#989898FF] md:text-md text-sm text-center lg:px-[16px] xl:mb-4 md:mb-4 lg:mb-6 xl:mt-3 lg:mt-2 md:mt-2"
      >
        AI model trained on In-silico data
      </p>
    </div>
  </div>
</div>
