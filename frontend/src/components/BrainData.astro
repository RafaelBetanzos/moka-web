---
import Brain from "@assets/Brain.svg";
import { Image } from "astro:assets";
---

<div class="flex flex-col justify-center items-center w-full max-w-5xl mx-auto px-6 py-12 overflow-hidden">
  
  {/* Mobile Image - Pop Animation */}
  <div class="reveal opacity-0 sm:hidden mb-8" data-animation="pop-in">
    <Image
      src={Brain}
      alt="Brain Diagram Mobile"
      class="w-48 h-auto"
    />
  </div>

  <div class="flex h-fit w-full justify-between items-center gap-4 md:gap-10">
    
    {/* Left Card: Analytical Thinking */}
    <div 
      class="reveal opacity-0 bg-white rounded-3xl shadow-xl p-6 font-inter flex flex-col items-center justify-center w-full max-w-[220px] h-64 border border-gray-50 transition-all duration-500 hover:scale-105 hover:shadow-2xl cursor-default group"
      data-animation="slide-left"
      style="transition-delay: 0.1s;"
    >
      <h3 class="text-lg md:text-xl text-secondary text-center font-bold leading-tight group-hover:text-black transition-colors duration-300">
        Analytical thinking
      </h3>
      <div class="w-10 h-1 bg-secondary/20 my-4 rounded-full transition-all duration-300 group-hover:w-16 group-hover:bg-secondary"></div>
      <p class="text-black font-semibold text-sm md:text-base text-center mb-1">
        Experimental lobe
      </p>
      <p class="text-gray-400 text-xs md:text-sm text-center leading-relaxed">
        AI model trained on In-house experimental data
      </p>
    </div>

    {/* Central Image (Desktop) */}
    <div 
      class="reveal opacity-0 hidden sm:flex flex-1 justify-center items-center px-4" 
      data-animation="pop-in" 
      style="transition-delay: 0.3s;"
    >
      <Image
        src={Brain}
        alt="Brain Diagram"
        class="w-full max-w-xs md:max-w-sm h-auto object-contain transition-transform duration-1000 hover:scale-105"
      />
    </div>

    {/* Right Card: Creative Thinking (Fixed size for perfect fit) */}
    <div 
      class="reveal opacity-0 bg-white rounded-3xl shadow-xl p-6 font-inter flex flex-col items-center justify-center w-full max-w-[220px] h-64 border border-gray-50 transition-all duration-500 hover:scale-105 hover:shadow-2xl cursor-default group"
      data-animation="slide-right"
      style="transition-delay: 0.5s;"
    >
      <h3 class="text-lg md:text-xl text-secondary text-center font-bold leading-tight group-hover:text-black transition-colors duration-300">
        Creative thinking
      </h3>
      <div class="w-10 h-1 bg-secondary/20 my-4 rounded-full transition-all duration-300 group-hover:w-16 group-hover:bg-secondary"></div>
      <p class="text-black font-semibold text-sm md:text-base text-center mb-1">
        In silico lobe
      </p>
      <p class="text-gray-400 text-xs md:text-sm text-center leading-relaxed">
        AI model trained on In-silico data
      </p>
    </div>

  </div>
</div>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const animationType = entry.target.getAttribute('data-animation');
        entry.target.classList.add(`animate-${animationType}`);
        entry.target.classList.remove('opacity-0');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>

<style>
  .animate-slide-left { animation: slideLeft 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards; }
  .animate-slide-right { animation: slideRight 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards; }
  .animate-pop-in { animation: popIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

  @keyframes slideLeft {
    from { opacity: 0; transform: translateX(-60px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes slideRight {
    from { opacity: 0; transform: translateX(60px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.85); }
    to { opacity: 1; transform: scale(1); }
  }
</style>