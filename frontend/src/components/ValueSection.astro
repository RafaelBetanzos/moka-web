---
interface Props {
  locale?: "en" | "es" | "pt";
}

const { locale = "en" } = Astro.props;

const copy = {
  en: {
    kicker: "WHY MOKA",
    title: "What you gain with Moka.",
    intro: "Fewer guesses. More advantage.",
    items: [
      { title: "Get there first", body: "Your competitors keep reformulating the same things. You start where no one has looked." },
      { title: "Products no one else has", body: "New actives, not the usual extract with a new label." },
      { title: "Stop testing blind", body: "Before you spend on the lab, you already know which plants are worth it." },
      { title: "Access you won't find elsewhere", body: "Icaros data." },
      { title: "An origin you can tell", body: "Every plant traceable together with the communities. Less risk, a better story.", accent: true },
      { title: "IP from day one", body: "Know whether you can protect it before you invest, not after." },
    ],
  },
  es: {
    kicker: "POR QUÉ MOKA",
    title: "Lo que ganas con Moka.",
    intro: "Menos suposiciones. Más ventaja.",
    items: [
      { title: "Llega primero", body: "Tu competencia sigue reformulando lo mismo. Tú empiezas donde nadie ha mirado." },
      { title: "Productos que nadie más tiene", body: "Activos nuevos, no el extracto de siempre con otra etiqueta." },
      { title: "Deja de ensayar a ciegas", body: "Antes de gastar en laboratorio, ya sabes qué plantas valen la pena." },
      { title: "Acceso que no existe en otro lado", body: "Datos de Icaros." },
      { title: "Un origen que puedes contar", body: "Cada planta trazable junto con las comunidades. Menos riesgo, mejor historia.", accent: true },
      { title: "PI desde el día uno", body: "Sabes si puedes protegerlo antes de invertir, no después." },
    ],
  },
  pt: {
    kicker: "POR QUE A MOKA",
    title: "O que você ganha com a Moka.",
    intro: "Menos suposições. Mais vantagem.",
    items: [
      { title: "Chegue primeiro", body: "Seus concorrentes continuam reformulando o mesmo. Você começa onde ninguém olhou." },
      { title: "Produtos que ninguém mais tem", body: "Ativos novos, não o extrato de sempre com outro rótulo." },
      { title: "Pare de testar às cegas", body: "Antes de gastar em laboratório, você já sabe quais plantas valem a pena." },
      { title: "Um acesso que não existe em outro lugar", body: "Dados do Icaros." },
      { title: "Uma origem que você pode contar", body: "Cada planta rastreável junto com as comunidades. Menos risco, uma história melhor.", accent: true },
      { title: "PI desde o primeiro dia", body: "Saiba se pode protegê-lo antes de investir, não depois." },
    ],
  },
}[locale];
---

<div class="value relative">
  <div class="value-shell">
    <div class="value-head reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.05s;">
      <p class="value-kicker">{copy.kicker}</p>
      <h2 class="value-title">{copy.title}</h2>
      <p class="value-intro">{copy.intro}</p>
    </div>

    <div class="value-grid">
      {copy.items.map((item, i) => (
        <article
          class={`value-card reveal opacity-0${item.accent ? " value-card--accent" : ""}`}
          data-animation="pop-in"
          style={`transition-delay: ${0.1 + i * 0.08}s;`}
        >
          <span class="value-index">0{i + 1}</span>
          <h3 class="value-card-title">{item.title}</h3>
          <p class="value-card-body">{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</div>

<style>
  .value {
    z-index: 20;
    padding: 5rem 1.25rem 3rem;
  }

  .value-shell {
    width: min(100%, 1180px);
    margin: 0 auto;
  }

  .value-head { max-width: 760px; }

  .value-kicker {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.42em;
    color: var(--fresh-green-color);
  }

  .value-title {
    margin-top: 1rem;
    font-family: Inter, sans-serif;
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    font-weight: 650;
    line-height: 1.03;
    color: var(--pure-color);
    text-wrap: balance;
  }

  .value-intro {
    margin-top: 1.1rem;
    max-width: 640px;
    font-family: Inter, sans-serif;
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.7;
    color: var(--moka-text-muted);
  }

  .value-grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .value-card {
    position: relative;
    overflow: hidden;
    padding: 1.75rem 1.6rem 1.8rem;
    border-radius: 1.5rem;
    border: 1px solid rgba(222, 222, 222, 0.1);
    background: linear-gradient(160deg, rgba(19, 45, 37, 0.55) 0%, rgba(18, 18, 18, 0.9) 70%);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transition: transform 320ms ease, border-color 320ms ease;
  }

  .value-card::before {
    content: "";
    position: absolute;
    left: 1.6rem;
    right: 1.6rem;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, rgba(110, 191, 126, 0.55), transparent);
  }

  .value-card:hover {
    transform: translateY(-4px);
    border-color: rgba(110, 191, 126, 0.3);
  }

  .value-card--accent {
    border-color: rgba(110, 191, 126, 0.35);
    background: linear-gradient(160deg, rgba(110, 191, 126, 0.16) 0%, rgba(19, 45, 37, 0.7) 45%, rgba(18, 18, 18, 0.9) 100%);
  }

  .value-index {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--fresh-green-color);
  }

  .value-card-title {
    margin-top: 1rem;
    font-family: Inter, sans-serif;
    font-size: clamp(1.2rem, 1.7vw, 1.45rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--pure-color);
    text-wrap: balance;
  }

  .value-card-body {
    margin-top: 0.75rem;
    font-family: Inter, sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(222, 222, 222, 0.74);
  }

  @media (max-width: 1000px) {
    .value-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .value { padding: 3.5rem 1rem 2rem; }
    .value-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .value-card { transition: none; }
    .value-card:hover { transform: none; }
  }
</style>
