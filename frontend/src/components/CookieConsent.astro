---
interface Props {
  locale: "en" | "es" | "pt";
}

const { locale } = Astro.props;
const privacyHref = locale === "en" ? "/privacy" : `/${locale}/privacy`;

const copy = {
  en: {
    label: "Cookie preferences",
    text: "We use Google Analytics cookies to understand how visitors use this site. They are only activated if you accept.",
    more: "Privacy Policy",
    accept: "Accept",
    reject: "Reject",
  },
  es: {
    label: "Preferencias de cookies",
    text: "Usamos cookies de Google Analytics para entender cómo se usa este sitio. Solo se activan si las aceptas.",
    more: "Política de privacidad",
    accept: "Aceptar",
    reject: "Rechazar",
  },
  pt: {
    label: "Preferências de cookies",
    text: "Usamos cookies do Google Analytics para entender como este site é usado. Eles só são ativados se você aceitar.",
    more: "Política de privacidade",
    accept: "Aceitar",
    reject: "Recusar",
  },
}[locale];
---

<div id="cookie-consent" class="cookie-consent" role="dialog" aria-live="polite" aria-label={copy.label} hidden>
  <p class="cookie-consent-text">
    {copy.text} <a href={privacyHref}>{copy.more}</a>
  </p>
  <div class="cookie-consent-actions">
    <button type="button" class="cookie-btn cookie-btn-secondary" data-consent="denied">{copy.reject}</button>
    <button type="button" class="cookie-btn cookie-btn-primary" data-consent="granted">{copy.accept}</button>
  </div>
</div>

<script is:inline>
  (() => {
    const banner = document.getElementById("cookie-consent");
    if (!banner) return;

    const show = () => { banner.hidden = false; };
    let stored = null;
    try { stored = localStorage.getItem("moka-analytics-consent"); } catch {}
    if (stored !== "granted" && stored !== "denied") show();

    banner.addEventListener("click", (event) => {
      const button = event.target instanceof Element ? event.target.closest("[data-consent]") : null;
      if (!button) return;
      const choice = button.getAttribute("data-consent");
      try { localStorage.setItem("moka-analytics-consent", choice); } catch {}
      banner.hidden = true;
      if (choice === "granted" && typeof window.mokaLoadAnalytics === "function") window.mokaLoadAnalytics();
      if (choice === "denied" && typeof window.mokaDisableAnalytics === "function") window.mokaDisableAnalytics();
    });

    document.addEventListener("click", (event) => {
      const trigger = event.target instanceof Element ? event.target.closest("[data-cookie-settings]") : null;
      if (!trigger) return;
      event.preventDefault();
      show();
    });
  })();
</script>

<style>
  .cookie-consent {
    position: fixed;
    z-index: 60;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    max-width: 34rem;
    margin-left: auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-radius: 1.25rem;
    border: 1px solid rgba(110, 191, 126, 0.3);
    background: rgba(19, 45, 37, 0.94);
    backdrop-filter: blur(14px);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
  }

  .cookie-consent[hidden] { display: none; }

  .cookie-consent-text {
    font-family: Inter, sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(222, 222, 222, 0.85);
  }

  .cookie-consent-text a {
    color: var(--fresh-green-color);
    border-bottom: 1px solid rgba(110, 191, 126, 0.35);
  }

  .cookie-consent-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .cookie-btn {
    min-height: 44px;
    padding: 0 1.4rem;
    border-radius: 9999px;
    font-family: Roboto, sans-serif;
    font-size: 14px;
    font-weight: 700;
    transition: background-color 200ms, color 200ms, border-color 200ms;
  }

  .cookie-btn-primary {
    background: var(--fresh-green-color);
    color: var(--charcoal-color);
  }

  .cookie-btn-primary:hover { background: var(--pure-color); }

  .cookie-btn-secondary {
    border: 1px solid rgba(222, 222, 222, 0.3);
    color: var(--birch-color);
  }

  .cookie-btn-secondary:hover { border-color: var(--pure-color); color: var(--pure-color); }
</style>
