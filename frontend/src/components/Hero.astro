---
import { MarqueeComponent } from "@components/Marquee/MarqueeComponent";
---

<section class="hero-xray relative w-full overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-r from-charcoal/98 via-charcoal/58 to-charcoal/86"></div>
  <div class="absolute inset-0 bg-deepforest/20 mix-blend-multiply"></div>
  <div class="absolute inset-0 bg-freshgreen/5"></div>
  <div class="absolute inset-0 hero-scan opacity-20"></div>
  <!-- fade inferior para que fluya con las secciones de abajo -->
  <div class="absolute inset-x-0 bottom-0 h-64 bg-gradient-to-b from-transparent to-black/30"></div>

  <div class="hero-botanical botanical-line-a" aria-hidden="true"></div>
  <div class="hero-botanical botanical-line-b" aria-hidden="true"></div>

  <!-- Efectos decorativos sobre el fondo -->
  <div class="hero-fx" aria-hidden="true">
    <div class="hero-fx-glow"></div>
    <div class="hero-fx-orbit"></div>
    <div class="hero-node hero-node--a"></div>
    <div class="hero-node hero-node--b"></div>
    <div class="hero-node hero-node--c"></div>
  </div>

  <div class="relative z-10 flex flex-col min-h-screen">
    <!-- Copy + Marquee juntos en el bloque superior -->
    <div class="px-8 pt-10 pb-8 sm:px-12 sm:pt-14 lg:px-16 lg:pt-16">
      <div class="hero-copy max-w-3xl animate-moka-reveal">
        <p class="font-roboto text-[12px] font-semibold uppercase tracking-[0.48em] text-freshgreen">
          MOKA BIO
        </p>
        <h1 class="mt-5 font-inter text-[44px] font-semibold leading-[0.98] text-pure drop-shadow-2xl sm:text-[72px] lg:text-[92px]">
          The operating system for <span class="text-freshgreen">natural</span> product discovery
        </h1>
        <p class="mt-7 max-w-2xl font-inter text-[17px] leading-relaxed text-birch/78 sm:text-[20px]">
          Moka turns natural knowledge into programmable bioactive intelligence for molecular innovation.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href="/our-technology" class="hero-primary-cta no-underline">Explore the platform</a>
          <a
            href="/contact-us"
            class="hero-demo-cta no-underline"
            data-analytics-event="book_demo_click"
            data-analytics-category="cta"
            data-analytics-label="Hero Book a Demo"
          >
            Book a Demo
          </a>
        </div>
      </div>

      <!-- Marquee justo debajo de los botones -->
      <div class="mt-10 sm:mt-12">
        <div class="flex items-center gap-6 mb-5">
          <span class="hero-partners-label">BACKED BY</span>
          <div class="flex-1 h-px bg-gradient-to-r from-birch/15 to-transparent"></div>
        </div>
        <MarqueeComponent client:only="react" />
      </div>
    </div>

    <!-- Espacio restante para llenar la pantalla -->
    <div class="flex-1"></div>
  </div>
</section>

<style>
  .hero-xray::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("/hero.png");
    background-position: center;
    background-size: cover;
    filter: grayscale(1) contrast(1.24) brightness(0.74) invert(0.03) saturate(0.9);
    opacity: 0.82;
    transform: scale(1.02);
    animation: heroDrift 24s ease-in-out infinite alternate;
  }

  @keyframes heroDrift {
    from { transform: scale(1.02) translate3d(0, 0, 0); }
    to   { transform: scale(1.06) translate3d(-1.2%, 0.8%, 0); }
  }

  .hero-xray::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 68% 38%, rgba(110, 191, 126, 0.1), transparent 30%),
      radial-gradient(circle at 42% 62%, rgba(86, 114, 99, 0.12), transparent 30%),
      linear-gradient(90deg, rgba(18, 18, 18, 0.96), rgba(18, 18, 18, 0.62) 54%, rgba(18, 18, 18, 0.92));
    mix-blend-mode: normal;
    opacity: 0.88;
  }

  .hero-scan {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(110, 191, 126, 0.055) 1px, transparent 1px);
    background-size: 100% 8px, 56px 100%;
  }

  .hero-copy {
    text-wrap: balance;
  }

  .hero-primary-cta,
  .hero-secondary-cta {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.85rem 1.35rem;
    font-family: Inter, sans-serif;
    font-size: 15px;
    font-weight: 700;
    transition: transform 280ms ease, border-color 280ms ease, background 280ms ease, color 280ms ease, box-shadow 280ms ease;
  }

  .hero-primary-cta {
    background: var(--pure-color);
    color: var(--charcoal-color);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.28);
  }

  .hero-demo-cta {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--fresh-green-color);
    color: var(--charcoal-color);
    padding: 0.85rem 1.35rem;
    font-family: Inter, sans-serif;
    font-size: 15px;
    font-weight: 700;
    box-shadow: 0 18px 60px rgba(110, 191, 126, 0.16);
    transition: transform 280ms ease, background 280ms ease, color 280ms ease, box-shadow 280ms ease;
  }

  .hero-primary-cta:hover {
    transform: translateY(-2px);
    background: var(--fresh-green-color);
    color: var(--charcoal-color);
    box-shadow: 0 18px 60px rgba(110, 191, 126, 0.22);
  }

  .hero-demo-cta:hover {
    transform: translateY(-2px);
    background: var(--pure-color);
    color: var(--charcoal-color);
    box-shadow: 0 18px 60px rgba(110, 191, 126, 0.22);
  }

  .hero-botanical {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    background-repeat: no-repeat;
    background-size: contain;
    filter: invert(1);
    opacity: 0.08;
  }

  .botanical-line-a {
    left: -3rem;
    bottom: 5rem;
    width: min(34vw, 420px);
    height: min(45vw, 560px);
    background-image: url("/assets/about-botanicals/botanical-line-01.png");
    animation: botanicalFloat 18s ease-in-out infinite;
  }

  .botanical-line-b {
    right: -5rem;
    top: 5rem;
    width: min(30vw, 380px);
    height: min(42vw, 520px);
    background-image: url("/assets/about-botanicals/botanical-line-05.png");
    transform: rotate(8deg);
    animation: botanicalFloat 22s ease-in-out infinite reverse;
  }

  /* ── Hero copy reveal ───────────────────────── */
  .animate-moka-reveal {
    animation: mokaReveal 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
    will-change: transform, opacity;
  }

  @keyframes mokaReveal {
    from { opacity: 0; transform: translateX(40px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  /* ── Efectos decorativos sobre hero.png ─────── */
  .hero-partners-label {
    font-family: Roboto, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.44em;
    text-transform: uppercase;
    color: rgba(222, 222, 222, 0.35);
    white-space: nowrap;
  }

  .hero-fx {
    position: absolute;
    top: 50%;
    right: -6%;
    transform: translateY(-50%);
    width: 1260px;
    height: 1260px;
    pointer-events: none;
    z-index: 3;
  }

  .hero-fx-glow {
    position: absolute;
    inset: -10%;
    border-radius: 999px;
    background: radial-gradient(circle,
      rgba(110, 191, 126, 0.18) 0%,
      rgba(19,  45,  37, 0.12) 45%,
      transparent 70%
    );
    filter: blur(40px);
    animation: glowPulse 5s ease-in-out infinite;
  }

  .hero-fx-orbit {
    position: absolute;
    inset: 6%;
    border-radius: 999px;
    border: 1px solid rgba(110, 191, 126, 0.18);
    animation: orbitSpin 32s linear infinite;
  }

  .hero-node {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--fresh-green-color);
    box-shadow: 0 0 20px rgba(110, 191, 126, 0.7);
    animation: nodePulse 3s ease-in-out infinite;
  }

  .hero-node--a { top: 18%;    left: 12%;  animation-delay: 0s;   }
  .hero-node--b { top: 55%;    right: 8%;  animation-delay: 0.9s; }
  .hero-node--c { bottom: 20%; left: 40%;  animation-delay: 1.8s; }

  @keyframes glowPulse {
    0%, 100% { opacity: 0.7; transform: scale(1);    }
    50%       { opacity: 1;   transform: scale(1.08); }
  }

  @keyframes orbitSpin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  @keyframes nodePulse {
    0%, 100% { transform: scale(1);   opacity: 0.6; }
    50%       { transform: scale(1.7); opacity: 1;   }
  }


  @keyframes botanicalFloat {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
    50% { transform: translate3d(0, -18px, 0) rotate(2deg); }
  }

  @media (max-width: 767px) {
    .hero-xray::after {
      background:
        radial-gradient(circle at 68% 38%, rgba(110, 191, 126, 0.1), transparent 36%),
        linear-gradient(90deg, rgba(18, 18, 18, 0.96), rgba(18, 18, 18, 0.74));
    }

    .botanical-line-a {
      width: 260px;
      height: 340px;
      opacity: 0.07;
    }

    .botanical-line-b {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-xray::before,
    .botanical-line-a,
    .botanical-line-b,
    .animate-moka-reveal,
    .hero-fx-glow,
    .hero-fx-orbit,
    .hero-node {
      animation: none !important;
      opacity: 1;
    }
  }
</style>
