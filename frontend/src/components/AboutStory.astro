---
// About page: "Why Moka exists" and "Why now", after the mission and vision.
// The question and the key lines are large statements; the story itself stays short and grey.
// "Why now" splits into the three things that changed, then closes with one line.
interface Props {
  locale?: "en" | "es" | "pt";
}

const { locale = "en" } = Astro.props;

const copy = {
  en: {
    storyTitle: "Why Moka exists",
    question: "Why aren't more bioactives coming from one of the most biodiverse regions on Earth?",
    opening: "That question led us to a deeper problem. Latin America holds an extraordinary biological library, yet much of it remains unexplored.",
    known: ["What is not known is not valued.", "And what is not valued is lost."],
    history: "For decades, biological resources and traditional knowledge from the region have helped create discoveries and products elsewhere, while much of the value they generate has not remained connected to the ecosystems and communities they came from.",
    path: ["We believe there is another path:", " turn biodiversity into knowledge, and knowledge into value, before it disappears."],
    end: ["That is why Moka exists:", " to open the door to innovators who want to give Latin America's plants the value they deserve."],
    nowTitle: "Why now",
    nowLead: "For the first time, the pieces are coming together.",
    now: [
      { title: "AI and biological data", body: "Advances in AI and biological data make it possible to explore biodiversity at a scale that was previously impractical." },
      { title: "Access and benefit sharing", body: "New frameworks for access and benefit sharing are changing how biological resources can be discovered and developed." },
      { title: "A market that is looking", body: "The market is actively looking for new, traceable and scientifically supported bioactives." },
    ],
    nowEnd: ["The biodiversity was always here.", " What changed is our ability to discover its value responsibly."],
  },
  es: {
    storyTitle: "Por qué existe Moka",
    question: "¿Por qué no surgen más bioactivos de una de las regiones con mayor biodiversidad del planeta?",
    opening: "Esa pregunta nos llevó a un problema más profundo. América Latina guarda una biblioteca biológica extraordinaria, pero gran parte sigue sin explorarse.",
    known: ["Lo que no se conoce no se valora.", "Y lo que no se valora se pierde."],
    history: "Durante décadas, los recursos biológicos y el conocimiento tradicional de la región han ayudado a crear descubrimientos y productos en otras partes, mientras que gran parte del valor que generan no ha permanecido conectado con los ecosistemas y las comunidades de donde vienen.",
    path: ["Creemos que hay otro camino:", " convertir la biodiversidad en conocimiento, y el conocimiento en valor, antes de que desaparezca."],
    end: ["Por eso existe Moka:", " para abrirles la puerta a los innovadores que quieren revalorizar las plantas de América Latina."],
    nowTitle: "Por qué ahora",
    nowLead: "Por primera vez, las piezas están encajando.",
    now: [
      { title: "IA y datos biológicos", body: "Los avances en IA y en datos biológicos permiten explorar la biodiversidad a una escala que antes no era viable." },
      { title: "Acceso y distribución de beneficios", body: "Los nuevos marcos de acceso y distribución de beneficios están cambiando la forma en que se descubren y desarrollan los recursos biológicos." },
      { title: "Un mercado que está buscando", body: "El mercado busca activamente bioactivos nuevos, trazables y con respaldo científico." },
    ],
    nowEnd: ["La biodiversidad siempre estuvo aquí.", " Lo que cambió es nuestra capacidad de descubrir su valor de forma responsable."],
  },
  pt: {
    storyTitle: "Por que a Moka existe",
    question: "Por que não surgem mais bioativos de uma das regiões mais biodiversas do planeta?",
    opening: "Essa pergunta nos levou a um problema mais profundo. A América Latina guarda uma biblioteca biológica extraordinária, mas grande parte dela continua inexplorada.",
    known: ["O que não se conhece não se valoriza.", "E o que não se valoriza se perde."],
    history: "Durante décadas, os recursos biológicos e o conhecimento tradicional da região ajudaram a criar descobertas e produtos em outros lugares, enquanto grande parte do valor que geram não permaneceu conectada aos ecossistemas e às comunidades de onde vieram.",
    path: ["Acreditamos que existe outro caminho:", " transformar a biodiversidade em conhecimento, e o conhecimento em valor, antes que ela desapareça."],
    end: ["É por isso que a Moka existe:", " para abrir a porta aos inovadores que querem revalorizar as plantas da América Latina."],
    nowTitle: "Por que agora",
    nowLead: "Pela primeira vez, as peças estão se encaixando.",
    now: [
      { title: "IA e dados biológicos", body: "Os avanços em IA e em dados biológicos permitem explorar a biodiversidade em uma escala antes inviável." },
      { title: "Acesso e repartição de benefícios", body: "Novos marcos de acesso e repartição de benefícios estão mudando a forma como os recursos biológicos são descobertos e desenvolvidos." },
      { title: "Um mercado que está buscando", body: "O mercado busca ativamente bioativos novos, rastreáveis e com respaldo científico." },
    ],
    nowEnd: ["A biodiversidade sempre esteve aqui.", " O que mudou foi a nossa capacidade de descobrir seu valor de forma responsável."],
  },
}[locale];
---

<section class="story" aria-labelledby="story-title">
  <h2 id="story-title" class="story-title reveal opacity-0" data-animation="slide-up">{copy.storyTitle}</h2>
  <p class="story-question reveal opacity-0" data-animation="slide-up">{copy.question}</p>

  <div class="story-cols">
    <p class="story-body reveal opacity-0" data-animation="slide-up">{copy.opening}</p>
    <p class="story-body reveal opacity-0" data-animation="slide-up">{copy.history}</p>
  </div>

  <p class="story-big reveal opacity-0" data-animation="slide-up">
    <span class="story-white">{copy.known[0]}</span><br />
    <span class="story-green">{copy.known[1]}</span>
  </p>

  <p class="story-body story-path reveal opacity-0" data-animation="slide-up"><strong class="story-white">{copy.path[0]}</strong>{copy.path[1]}</p>

  <p class="story-end reveal opacity-0" data-animation="slide-up"><span class="story-green">{copy.end[0]}</span>{copy.end[1]}</p>
</section>

<section class="story story--now" aria-labelledby="now-title">
  <h2 id="now-title" class="story-title reveal opacity-0" data-animation="slide-up">{copy.nowTitle}</h2>
  <p class="story-lead reveal opacity-0" data-animation="slide-up">{copy.nowLead}</p>

  <ol class="story-now">
    {copy.now.map((item, i) => (
      <li class="story-now-item reveal opacity-0" data-animation="slide-up" style={`transition-delay: ${0.1 + i * 0.12}s;`}>
        <span class="story-now-num">0{i + 1}</span>
        <h3 class="story-now-title">{item.title}</h3>
        <p class="story-now-body">{item.body}</p>
      </li>
    ))}
  </ol>

  <p class="story-big story-big--end reveal opacity-0" data-animation="slide-up">
    <span class="story-white">{copy.nowEnd[0]}</span>
    <span class="story-green">{copy.nowEnd[1]}</span>
  </p>
</section>

<style>
  .story {
    position: relative;
    z-index: 10;
    width: min(100% - 2.5rem, 1100px);
    margin: 0 auto;
    padding: 5rem 0 3rem;
    /* Readable over the fixed botanical drawing on the right. */
    isolation: isolate;
  }

  .story::before {
    content: "";
    position: absolute;
    inset: 0 -2.5rem;
    z-index: -1;
    background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(18, 18, 18, 0.9), rgba(18, 18, 18, 0.6) 70%, transparent);
  }

  .story--now { padding-top: 4rem; padding-bottom: 6rem; }

  .story-white { color: var(--pure-color); }
  .story-green { color: var(--fresh-green-color); }

  .story-title {
    font-family: Roboto, sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--fresh-green-color);
  }

  /* The question that started it: the headline of the section. */
  .story-question {
    margin-top: 1.25rem;
    max-width: 960px;
    font-family: Inter, sans-serif;
    font-size: clamp(2rem, 4.2vw, 3.6rem);
    font-weight: 700;
    line-height: 1.08;
    color: var(--pure-color);
    text-wrap: balance;
  }

  .story-lead {
    margin-top: 1.25rem;
    font-family: Inter, sans-serif;
    font-size: clamp(2rem, 4.2vw, 3.6rem);
    font-weight: 700;
    line-height: 1.08;
    color: var(--pure-color);
    text-wrap: balance;
  }

  .story-cols {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }

  .story-body {
    font-family: Inter, sans-serif;
    font-size: 20px;
    line-height: 1.7;
    color: var(--moka-text-muted);
  }

  .story-big {
    margin-top: 4rem;
    font-family: Inter, sans-serif;
    font-size: clamp(2rem, 4.6vw, 4rem);
    font-weight: 700;
    line-height: 1.08;
  }

  .story-path { margin-top: 3rem; max-width: 760px; }

  .story-end {
    margin-top: 2.5rem;
    max-width: 900px;
    font-family: Inter, sans-serif;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 650;
    line-height: 1.25;
    color: var(--pure-color);
  }

  /* ── Why now: the three things that changed ── */
  .story-now {
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .story-now-item {
    padding: 1.75rem;
    border-radius: 1.5rem;
    border: 1px solid rgba(110, 191, 126, 0.22);
    background: linear-gradient(160deg, rgb(19, 38, 32) 0%, rgb(18, 18, 18) 70%);
  }

  .story-now-num {
    font-family: Roboto, sans-serif;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--fresh-green-color);
  }

  .story-now-title {
    margin-top: 0.9rem;
    font-family: Inter, sans-serif;
    font-size: 1.3rem;
    font-weight: 650;
    line-height: 1.25;
    color: var(--pure-color);
  }

  .story-now-body {
    margin-top: 0.7rem;
    font-family: Inter, sans-serif;
    font-size: 17px;
    line-height: 1.6;
    color: var(--moka-text-muted);
  }

  .story-big--end { margin-top: 4rem; max-width: 1000px; }

  @media (max-width: 900px) {
    .story-cols, .story-now { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .story { padding: 3.5rem 0 2rem; }
    .story-body { font-size: 18px; }
    .story-big { margin-top: 3rem; }
  }
</style>
