---
interface Props {
  locale?: "en" | "es" | "pt";
  /** Pages with their own closing CTA (or first-person copy) hide the built-in one. */
  showCta?: boolean;
  /** "service": terms of an R&D project (by contract). "platform": questions about Moka BDE, answered by its terms of use. */
  variant?: "service" | "platform" | "project";
}

const { locale = "en", showCta = true, variant = "service" } = Astro.props;
const contactBase = locale === "en" ? "/contact-us" : `/${locale}/contact-us`;
const termsHref = locale === "en" ? "/terms/" : `/${locale}/terms/`;

// Moka BDE: first-person questions (as people search them); the IP and data answers come
// from the platform's terms of use.
const platform = {
  en: {
    title: "Clear terms, in writing.",
    terms: "Read the terms of use",
    items: [
      { id: "platform-ip", title: "What happens to my IP if I use Moka BDE?", body: "It stays private. Your work in Moka BDE is covered by the platform's terms of use.", terms: true },
      { id: "platform-data", title: "Is my data private?", body: "Your data is yours, and it stays private, as set out in the terms of use.", terms: true },
      { id: "traceable-origin", title: "How do I avoid legal problems when I use native plants?", body: "If a native plant is in Icaros, it's tracked: you'll know its origin and its conditions of use.", terms: false },
    ],
  },
  es: {
    title: "Condiciones claras, por escrito.",
    terms: "Leer los términos de uso",
    items: [
      { id: "platform-ip", title: "¿Qué pasa con mi PI si uso Moka BDE?", body: "Se mantiene privada. Tu trabajo en Moka BDE está cubierto por los términos de uso de la plataforma.", terms: true },
      { id: "platform-data", title: "¿Mis datos son privados?", body: "Tus datos son tuyos y se mantienen privados, como lo establecen los términos de uso.", terms: true },
      { id: "traceable-origin", title: "¿Cómo evito problemas legales al usar plantas nativas?", body: "Si una planta nativa está en Icaros, está rastreada: sabrás su origen y sus condiciones de uso.", terms: false },
    ],
  },
  pt: {
    title: "Condições claras, por escrito.",
    terms: "Ler os termos de uso",
    items: [
      { id: "platform-ip", title: "O que acontece com a minha PI se eu usar o Moka BDE?", body: "Ela continua privada. Seu trabalho no Moka BDE está coberto pelos termos de uso da plataforma.", terms: true },
      { id: "platform-data", title: "Meus dados são privados?", body: "Seus dados são seus e continuam privados, conforme os termos de uso.", terms: true },
      { id: "traceable-origin", title: "Como evito problemas legais ao usar plantas nativas?", body: "Se uma planta nativa está no Icaros, ela é rastreada: você saberá sua origem e suas condições de uso.", terms: false },
    ],
  },
}[locale];
// Services page: the same two terms as "service", asked as first-person questions.
const project = {
  en: {
    title: "How does Moka manage IP?",
    terms: "",
    items: [
      { id: "by-contract", title: "What happens to my IP in a project with Moka?", body: "Data, results and IP are governed by a written agreement for each project.", terms: false },
      { id: "traceable-origin", title: "Where does the plant come from?", body: "Every plant is traceable, together with the communities.", terms: false },
    ],
  },
  es: {
    title: "¿Cómo maneja Moka la PI?",
    terms: "",
    items: [
      { id: "by-contract", title: "¿Qué pasa con mi PI en un proyecto con Moka?", body: "Los datos, los resultados y la PI se rigen por un acuerdo escrito para cada proyecto.", terms: false },
      { id: "traceable-origin", title: "¿De dónde viene la planta?", body: "Cada planta es trazable, junto con las comunidades.", terms: false },
    ],
  },
  pt: {
    title: "Como a Moka gerencia a PI?",
    terms: "",
    items: [
      { id: "by-contract", title: "O que acontece com a minha PI em um projeto com a Moka?", body: "Dados, resultados e PI são regidos por um acordo escrito para cada projeto.", terms: false },
      { id: "traceable-origin", title: "De onde vem a planta?", body: "Cada planta é rastreável, junto com as comunidades.", terms: false },
    ],
  },
}[locale];
const questions = variant === "platform" ? platform : variant === "project" ? project : null;

const copy = {
  en: {
    kicker: "TRUST",
    title: "Clear terms, in writing.",
    items: [
      { title: "By contract", body: "Data, results and IP are governed by a written agreement for each project." },
      { title: "Traceable origin", body: "Every plant traceable together with the communities." },
    ],
    ctaTitle: "Your next plant is waiting.",
    cta: "Book a demo",
    secondary: "Request a service",
  },
  es: {
    kicker: "CONFIANZA",
    title: "Condiciones claras, por escrito.",
    items: [
      { title: "Por contrato", body: "Los datos, los resultados y la PI se rigen por un acuerdo escrito para cada proyecto." },
      { title: "Origen trazable", body: "Cada planta trazable junto con las comunidades." },
    ],
    ctaTitle: "Tu próxima planta te está esperando.",
    cta: "Agendar demo",
    secondary: "Solicitar servicio",
  },
  pt: {
    kicker: "CONFIANÇA",
    title: "Condições claras, por escrito.",
    items: [
      { title: "Por contrato", body: "Dados, resultados e PI são regidos por um acordo escrito para cada projeto." },
      { title: "Origem rastreável", body: "Cada planta rastreável junto com as comunidades." },
    ],
    ctaTitle: "Sua próxima planta está esperando.",
    cta: "Agendar demonstração",
    secondary: "Solicitar serviço",
  },
}[locale];
---

<section class="trust relative" aria-labelledby="trust-title">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/18 to-transparent"></div>
  <div class="trust-shell">
    <div class="trust-head reveal opacity-0" data-animation="slide-up">
      <h2 id="trust-title" class="trust-title">{questions ? questions.title : copy.title}</h2>
    </div>

    {questions ? (
    <div class:list={["trust-grid", questions.items.length === 3 && "trust-grid--3"]}>
      {questions.items.map((item, i) => (
        <article id={item.id} class="trust-card reveal opacity-0" data-animation="pop-in" style={`transition-delay: ${0.1 + i * 0.1}s;`}>
          <span class="trust-dot" aria-hidden="true"></span>
          <h3 class="trust-card-title">{item.title}</h3>
          <p class="trust-card-body">{item.body}</p>
          {item.terms && <a class="trust-terms" href={termsHref}>{questions.terms} <span aria-hidden="true">→</span></a>}
        </article>
      ))}
    </div>
    ) : (
    <div class="trust-grid">
      {copy.items.map((item, i) => (
        <article id={["by-contract", "traceable-origin"][i]} class="trust-card reveal opacity-0" data-animation="pop-in" style={`transition-delay: ${0.1 + i * 0.1}s;`}>
          <span class="trust-dot" aria-hidden="true"></span>
          <h3 class="trust-card-title">{item.title}</h3>
          <p class="trust-card-body">{item.body}</p>
        </article>
      ))}
    </div>
    )}

    {showCta && (
    <div class="trust-cta reveal opacity-0" data-animation="slide-up">
      <p class="trust-cta-title">{copy.ctaTitle}</p>
      <div class="trust-cta-actions">
        <a href={`${contactBase}?interest=demo`} class="moka-demo-cta" data-analytics-event="book_demo_click" data-analytics-category="cta" data-analytics-label="trust_final">{copy.cta} <span aria-hidden="true">→</span></a>
        <a href={`${contactBase}?interest=service`} class="trust-secondary" data-analytics-event="request_service_click" data-analytics-category="cta" data-analytics-label="trust_final">{copy.secondary} <span aria-hidden="true">→</span></a>
      </div>
    </div>
    )}
  </div>
</section>

<style>
  .trust {
    z-index: 10;
    padding: 5rem 1.25rem 6rem;
  }

  .trust-shell {
    width: min(100%, 1180px);
    margin: 0 auto;
  }

  .trust-head {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .trust-kicker {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.42em;
    color: var(--fresh-green-color);
  }

  .trust-title {
    margin-top: 1rem;
    font-family: Inter, sans-serif;
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    font-weight: 650;
    line-height: 1.08;
    color: var(--pure-color);
    text-wrap: balance;
  }

  .trust-grid {
    margin-top: 2.75rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .trust-card {
    scroll-margin-top: 7rem;
    padding: 1.6rem 1.5rem 1.7rem;
    border-radius: 1.5rem;
    border: 1px solid rgba(222, 222, 222, 0.1);
    background: linear-gradient(160deg, rgba(19, 45, 37, 0.55) 0%, rgba(18, 18, 18, 0.9) 70%);
  }

  .trust-dot {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--fresh-green-color);
    box-shadow: 0 0 14px rgba(110, 191, 126, 0.55);
  }

  .trust-card-title {
    margin-top: 1rem;
    font-family: Inter, sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--pure-color);
  }

  .trust-card-body {
    margin-top: 0.6rem;
    font-family: Inter, sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(222, 222, 222, 0.74);
  }

  .trust-cta {
    margin-top: 4rem;
    padding: 2.5rem 2rem;
    border-radius: 2rem;
    border: 1px solid rgba(110, 191, 126, 0.3);
    background: radial-gradient(circle at 50% 0%, rgba(110, 191, 126, 0.16), transparent 60%), rgba(19, 45, 37, 0.6);
    text-align: center;
  }

  .trust-cta-title {
    max-width: 680px;
    margin: 0 auto;
    font-family: Inter, sans-serif;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 650;
    line-height: 1.2;
    color: var(--pure-color);
    text-wrap: balance;
  }

  .trust-cta-actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .trust-secondary {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    border: 1px solid rgba(222, 222, 222, 0.3);
    color: var(--pure-color);
    font-family: Inter, sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: border-color 200ms ease, background 200ms ease;
  }

  .trust-secondary:hover,
  .trust-secondary:focus-visible {
    border-color: var(--fresh-green-color);
    background: rgba(110, 191, 126, 0.12);
  }

  @media (max-width: 900px) {
    .trust-grid { grid-template-columns: 1fr; }
  }

  .trust-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .trust-terms {
    display: inline-block;
    margin-top: 0.9rem;
    font-family: Roboto, sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: var(--fresh-green-color);
    text-decoration: none;
  }

  .trust-terms:hover { text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 900px) {
    .trust-grid--3 { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .trust { padding: 3.5rem 1rem 4rem; }
    .trust-cta { padding: 2rem 1.25rem; }
  }
</style>
