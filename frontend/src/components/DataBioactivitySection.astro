---
import ArrowRight from "@assets/icons/ArrowRight.svg";
import { Image } from "astro:assets";

const dataCopy = {
  en: {
    kicker: "THE PROBLEM",
    subheadline: "Most Latin American plants have never been studied.",
    hook: "That is where your next ingredient is.",
    intro: "While the industry recycles the same extracts, one of the most biodiverse regions on Earth remains almost unexplored.",
    pills: ["Bioactivity prioritization", "Molecular indexing", "IP intelligence"],
    cta: "Our Technology",
    global: "Flora of the Americas",
    globalStat: "33%",
    globalBadge: "124,993 SPECIES",
    globalDesc: "Of the world's known vascular plant species grow in the Americas.",
    globalNote: "Plant library",
    globalSource: "Source: Ulloa Ulloa et al., Science (2017)",
    natural: "Studied Plants",
    naturalStat: "6%",
    naturalBadge: "UNEXPLORED",
    naturalDesc: "Of described plants have been studied pharmacologically, and only 15% chemically. The rest are still waiting.",
    naturalNote: "Understudied opportunity",
    naturalSource: "Source: Atanasov et al., Biotechnology Advances (2015)",
    unexplored: "Latin American Biodiversity",
    unexploredStat: "40%+",
    unexploredBadge: "GLOBAL BIODIVERSITY",
    unexploredDesc: "Of Earth's biodiversity is found in South America alone.",
    unexploredNote: "Biodiversity hotspot",
    unexploredSource: "Source: UNDP, Latin America and the Caribbean: A Biodiversity Superpower (2010)",
  },
  es: {
    kicker: "EL PROBLEMA",
    subheadline: "La mayoría de las plantas latinoamericanas nunca se ha estudiado.",
    hook: "Ahí está tu próximo ingrediente.",
    intro: "Mientras la industria recicla los mismos extractos, una de las regiones más biodiversas del planeta sigue casi sin explorar.",
    pills: ["Priorización de bioactividad", "Indexación molecular", "Inteligencia de PI"],
    cta: "Nuestra tecnología",
    global: "Flora de las Américas",
    globalStat: "33%",
    globalBadge: "124,993 ESPECIES",
    globalDesc: "De las especies de plantas vasculares conocidas en el mundo crecen en las Américas.",
    globalNote: "Biblioteca vegetal",
    globalSource: "Fuente: Ulloa Ulloa et al., Science (2017)",
    natural: "Plantas estudiadas",
    naturalStat: "6%",
    naturalBadge: "SIN EXPLORAR",
    naturalDesc: "De las plantas descritas se ha estudiado farmacológicamente, y solo el 15% químicamente. El resto sigue esperando.",
    naturalNote: "Oportunidad poco estudiada",
    naturalSource: "Fuente: Atanasov et al., Biotechnology Advances (2015)",
    unexplored: "Biodiversidad latinoamericana",
    unexploredStat: "40%+",
    unexploredBadge: "BIODIVERSIDAD GLOBAL",
    unexploredDesc: "De la biodiversidad del planeta se encuentra solo en Sudamérica.",
    unexploredNote: "Hotspot de biodiversidad",
    unexploredSource: "Fuente: PNUD, América Latina y el Caribe: una superpotencia de biodiversidad (2010)",
  },
  pt: {
    kicker: "O PROBLEMA",
    subheadline: "A maioria das plantas latino-americanas nunca foi estudada.",
    hook: "É ali que está seu próximo ingrediente.",
    intro: "Enquanto a indústria recicla os mesmos extratos, uma das regiões mais biodiversas do planeta segue quase inexplorada.",
    pills: ["Priorização de bioatividade", "Indexação molecular", "Inteligência de PI"],
    cta: "Nossa tecnologia",
    global: "Flora das Américas",
    globalStat: "33%",
    globalBadge: "124.993 ESPÉCIES",
    globalDesc: "Das espécies de plantas vasculares conhecidas no mundo crescem nas Américas.",
    globalNote: "Biblioteca vegetal",
    globalSource: "Fonte: Ulloa Ulloa et al., Science (2017)",
    natural: "Plantas estudadas",
    naturalStat: "6%",
    naturalBadge: "INEXPLORADO",
    naturalDesc: "Das plantas descritas foram estudadas farmacologicamente, e só 15% quimicamente. O restante segue esperando.",
    naturalNote: "Oportunidade pouco estudada",
    naturalSource: "Fonte: Atanasov et al., Biotechnology Advances (2015)",
    unexplored: "Biodiversidade latino-americana",
    unexploredStat: "40%+",
    unexploredBadge: "BIODIVERSIDADE GLOBAL",
    unexploredDesc: "Da biodiversidade do planeta está só na América do Sul.",
    unexploredNote: "Hotspot de biodiversidade",
    unexploredSource: "Fonte: PNUD, América Latina e Caribe: uma superpotência de biodiversidade (2010)",
  },
};

interface Props {
  locale?: "en" | "es" | "pt";
}

const { locale = "en" } = Astro.props;
const t = dataCopy[locale] ?? dataCopy.en;
const localePrefix = locale === "en" ? "" : `/${locale}`;
---

<section class="home-data-section relative -mt-1 overflow-hidden px-5 py-20 sm:px-8 lg:py-28">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/24 to-transparent"></div>
  <div class="data-botanical data-botanical-left" aria-hidden="true"></div>
  <div class="data-botanical data-botanical-right" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
    <div class="flex flex-col">
      <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.1s;">
        <p class="font-roboto text-[13px] font-medium leading-none tracking-[0.45em] text-freshgreen uppercase">
          {t.kicker}
        </p>
        <div class="mt-5">
          <h2 class="font-inter text-[clamp(1.9rem,3.4vw,3rem)] font-semibold leading-[1.05] text-pure">{t.subheadline}</h2>
          <p class="mt-4 font-inter text-[22px] font-semibold leading-snug text-freshgreen sm:text-[28px]">{t.hook}</p>
        </div>
      </div>

      <div class="reveal opacity-0 font-inter mt-4" data-animation="slide-in" style="transition-delay: 0.3s;">
        <p class="max-w-xl text-[18px] leading-relaxed text-birch/72 sm:text-[20px]">
          {t.intro}
        </p>
      </div>

      <div class="reveal opacity-0 mt-8 flex flex-wrap gap-3" data-animation="slide-in" style="transition-delay: 0.45s;">
        {t.pills.map((pill: string) => (
          <span class="rounded-full border border-birch/10 bg-charcoal/40 px-4 py-2 text-sm font-medium text-birch/82 shadow-sm shadow-black/20 backdrop-blur-md">{pill}</span>
        ))}
      </div>

      <a 
        href={`${localePrefix}/our-technology`} 
        class="reveal opacity-0 mt-10 flex w-fit items-center gap-3 rounded-full bg-pure py-2 pl-6 pr-2 font-inter text-[16px] font-semibold text-charcoal shadow-lg shadow-black/20 ring-1 ring-pure/10 transition-all duration-300 hover:bg-freshgreen hover:shadow-freshgreen/20 active:scale-95 no-underline"
        data-analytics-event="click_view_technology"
        data-analytics-category="cta"
        data-analytics-label="data_bioactivity_cta"
        data-animation="bounce-in"
        style="transition-delay: 0.75s;"
      >
        <span>{t.cta}</span>
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-charcoal">
          <Image src={ArrowRight} alt="arrow-right" class="h-5 w-5" />
        </span>
      </a>
    </div>

    <div class="grid gap-4 font-inter">
      <div class="grid gap-4 sm:grid-cols-2">
        <article class="data-card reveal opacity-0 rounded-[1.5rem] border border-freshgreen/24 bg-gradient-to-br from-deepforest/88 via-charcoal/72 to-charcoal/88 p-6 shadow-2xl shadow-black/25 backdrop-blur-xl sm:col-span-2" data-animation="pop-in" style="transition-delay: 0.18s;">
          <p class="text-[13px] font-semibold uppercase tracking-[0.32em] text-birch/70">{t.natural}</p>
          <div class="mt-6 flex flex-wrap items-end gap-3">
            <p class="text-[72px] font-semibold leading-none text-freshgreen sm:text-[96px]">{t.naturalStat}</p>
            <span class="mb-2 rounded-full border border-freshgreen/30 px-3 py-1 text-[13px] font-semibold text-freshgreen">{t.naturalBadge}</span>
          </div>
          <p class="mt-5 text-[15px] leading-relaxed text-birch/74">
            {t.naturalDesc}
          </p>
          <p class="mt-6 text-[13px] font-semibold uppercase tracking-[0.28em] text-sage/90">{t.naturalNote}</p>
          <p class="data-card-source mt-3 text-[13px] leading-snug text-birch/50">{t.naturalSource}</p>
        </article>

        <article class="data-card reveal opacity-0 rounded-[1.5rem] border border-birch/10 bg-charcoal/52 p-6 shadow-2xl shadow-black/25 backdrop-blur-xl" data-animation="pop-in" style="transition-delay: 0.25s;">
          <p class="text-[13px] font-semibold uppercase tracking-[0.32em] text-birch/70">{t.global}</p>
          <div class="mt-6 flex flex-wrap items-end gap-3">
            <p class="text-[56px] font-semibold leading-none text-freshgreen sm:text-[64px]">{t.globalStat}</p>
            <span class="mb-2 rounded-full border border-freshgreen/30 px-3 py-1 text-[13px] font-semibold text-freshgreen">{t.globalBadge}</span>
          </div>
          <p class="mt-5 text-[15px] leading-relaxed text-birch/74">
            {t.globalDesc}
          </p>
          <p class="mt-6 text-[13px] font-semibold uppercase tracking-[0.28em] text-sage/90">{t.globalNote}</p>
          <p class="data-card-source mt-3 text-[13px] leading-snug text-birch/50">{t.globalSource}</p>
        </article>

        <article class="data-card reveal opacity-0 rounded-[1.5rem] border border-freshgreen/18 bg-deepforest/62 p-6 shadow-2xl shadow-black/25 backdrop-blur-xl" data-animation="pop-in" style="transition-delay: 0.4s;">
          <p class="text-[13px] font-semibold uppercase tracking-[0.32em] text-birch/70">{t.unexplored}</p>
          <div class="mt-6 flex flex-wrap items-end gap-3">
            <p class="text-[56px] font-semibold leading-none text-freshgreen sm:text-[64px]">{t.unexploredStat}</p>
            <span class="mb-2 rounded-full border border-freshgreen/30 px-3 py-1 text-[13px] font-semibold text-freshgreen">{t.unexploredBadge}</span>
          </div>
          <p class="mt-5 text-[15px] leading-relaxed text-birch/74">
            {t.unexploredDesc}
          </p>
          <p class="mt-6 text-[13px] font-semibold uppercase tracking-[0.28em] text-sage/90">{t.unexploredNote}</p>
          <p class="data-card-source mt-3 text-[13px] leading-snug text-birch/50">{t.unexploredSource}</p>
        </article>
      </div>
    </div>
  </div>
</section>


<style>
  .home-data-section {
    background: transparent;
  }

  .data-botanical {
    position: absolute;
    pointer-events: none;
    background-repeat: no-repeat;
    background-size: contain;
    filter: invert(1);
    opacity: 0.06;
  }

  .data-botanical-left {
    left: -5rem;
    top: 16%;
    width: min(30vw, 360px);
    height: min(42vw, 520px);
    background-image: url("/assets/about-botanicals/botanical-line-02.png");
  }

  .data-botanical-right {
    right: -5rem;
    bottom: 3%;
    width: min(32vw, 400px);
    height: min(42vw, 520px);
    background-image: url("/assets/about-botanicals/botanical-line-04.png");
    transform: rotate(8deg);
  }

  .data-card {
    position: relative;
    overflow: hidden;
    transition: transform 320ms ease, border-color 320ms ease, background 320ms ease;
  }

  .data-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 24% 0%, rgba(110, 191, 126, 0.12), transparent 36%);
    opacity: 0;
    transition: opacity 320ms ease;
    pointer-events: none;
  }

  .data-card:hover {
    transform: translateY(-4px);
    border-color: rgba(110, 191, 126, 0.34);
  }

  .data-card:hover::after {
    opacity: 1;
  }

  /* Entrance Animations */
  .animate-slide-in { animation: slideIn 0.8s ease-out forwards; }
  .animate-slide-in-right { animation: slideInRight 0.8s ease-out forwards; }
  .animate-pop-in { animation: popIn 0.7s ease-out forwards; }
  .animate-bounce-in { animation: bounceIn 0.7s ease-out forwards; }

  @keyframes slideIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(40px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.96) translateY(16px); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes bounceIn {
    0% { opacity: 0; transform: translateY(20px); }
    100% { opacity: 1; transform: scale(1); }
  }

  @media (max-width: 767px) {
    .data-botanical-right {
      display: none;
    }

    .data-botanical-left {
      width: 240px;
      height: 340px;
      opacity: 0.045;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-slide-in,
    .animate-slide-in-right,
    .animate-pop-in,
    .animate-bounce-in {
      animation-duration: 1ms;
    }
  }
</style>
