---
import ArrowRight from "@assets/icons/ArrowRight.svg";
import { Image } from "astro:assets";

type Stat = { label: string; value: string; desc: string; source: string; href: string; badge?: string; note?: string };

const dataCopy: Record<"en" | "es" | "pt", { subheadline: string; intro: string; hook: string; cta: string; stats: Stat[] }> = {
  en: {
    subheadline: "What is not known is not valued. And what is not valued is lost.",
    intro: "Valuable bioactives, ingredients and discoveries can vanish before we ever understand what they could do.",
    hook: "Where is the next bioactive breakthrough?",
    cta: "See how we do it",
    stats: [
      { label: "Unstudied plants", value: "~85%", desc: "of plant species have never been systematically investigated phytochemically.", source: "Atanasov et al., 2015", href: "https://doi.org/10.1016/j.biotechadv.2015.08.001" },
      { label: "Forest loss", value: "4.1M+", desc: "hectares of forest are lost every year in Latin America.", source: "FAO, 2025", href: "https://openknowledge.fao.org/server/api/core/bitstreams/2dee6e93-1988-4659-aa89-30dd20b43b15/content/FRA-2025/forest-extent-and-change.html" },
    ],
  },
  es: {
    subheadline: "Lo que no se conoce no se valora. Y lo que no se valora se pierde.",
    intro: "Bioactivos, ingredientes y descubrimientos valiosos pueden desaparecer antes de que lleguemos a entender lo que podrían hacer.",
    hook: "¿Dónde está el próximo gran bioactivo?",
    cta: "Ver cómo lo hacemos",
    stats: [
      { label: "Plantas sin estudiar", value: "~85%", desc: "de las especies de plantas nunca se han investigado de forma sistemática en lo fitoquímico.", source: "Atanasov et al., 2015", href: "https://doi.org/10.1016/j.biotechadv.2015.08.001" },
      { label: "Pérdida de bosque", value: "4.1M+", desc: "hectáreas de bosque se pierden cada año en América Latina.", source: "FAO, 2025", href: "https://openknowledge.fao.org/server/api/core/bitstreams/2dee6e93-1988-4659-aa89-30dd20b43b15/content/FRA-2025/forest-extent-and-change.html" },
    ],
  },
  pt: {
    subheadline: "O que não se conhece não se valoriza. E o que não se valoriza se perde.",
    intro: "Bioativos, ingredientes e descobertas valiosos podem desaparecer antes que entendamos o que poderiam fazer.",
    hook: "Onde está o próximo grande bioativo?",
    cta: "Ver como fazemos",
    stats: [
      { label: "Plantas não estudadas", value: "~85%", desc: "das espécies de plantas nunca foram investigadas de forma sistemática do ponto de vista fitoquímico.", source: "Atanasov et al., 2015", href: "https://doi.org/10.1016/j.biotechadv.2015.08.001" },
      { label: "Perda de floresta", value: "4.1M+", desc: "hectares de floresta são perdidos a cada ano na América Latina.", source: "FAO, 2025", href: "https://openknowledge.fao.org/server/api/core/bitstreams/2dee6e93-1988-4659-aa89-30dd20b43b15/content/FRA-2025/forest-extent-and-change.html" },
    ],
  },
};

interface Props {
  locale?: "en" | "es" | "pt";
}

const { locale = "en" } = Astro.props;
const localePrefix = locale === "en" ? "" : `/${locale}`;
const t = dataCopy[locale] ?? dataCopy.en;
---

<section class="home-data-section relative -mt-1 overflow-hidden px-5 py-20 sm:px-8 lg:py-28">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/24 to-transparent"></div>
  <div class="data-botanical data-botanical-left" aria-hidden="true"></div>
  <div class="data-botanical data-botanical-right" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
    <div class="flex flex-col">
      <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.1s;">
        <div>
          <h2 class="font-inter text-[clamp(1.9rem,3.4vw,3rem)] font-semibold leading-[1.05] text-pure">{t.subheadline}</h2>
        </div>
      </div>

      <div class="reveal opacity-0 font-inter mt-4" data-animation="slide-in" style="transition-delay: 0.3s;">
        <p class="max-w-xl text-[18px] leading-relaxed text-birch/72 sm:text-[20px]">
          {t.intro}
        </p>
        <p class="mt-5 max-w-xl font-inter text-[20px] font-semibold leading-snug text-freshgreen sm:text-[24px]">{t.hook}</p>
      </div>

      <a 
        href={`${localePrefix}/our-technology/`}
        class="reveal opacity-0 mt-10 flex w-fit items-center gap-3 rounded-full bg-pure py-2 pl-6 pr-2 font-inter text-[16px] font-semibold text-charcoal shadow-lg shadow-black/20 ring-1 ring-pure/10 transition-all duration-300 hover:bg-freshgreen hover:shadow-freshgreen/20 active:scale-95 no-underline"
        data-analytics-event="click_view_technology"
        data-analytics-category="cta"
        data-analytics-label="data_bioactivity_cta"
        data-animation="bounce-in"
        style="transition-delay: 0.75s;"
      >
        <span>{t.cta}</span>
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-charcoal">
          <Image src={ArrowRight} alt="arrow-right" class="h-5 w-5" />
        </span>
      </a>
    </div>

    <div class="grid gap-4 font-inter">
      <div class="grid gap-4">
        {t.stats.map((stat, i) => (
          <article
            class:list={[
              "data-card reveal opacity-0 rounded-[1.5rem] p-6 shadow-2xl shadow-black/25 backdrop-blur-xl",
              i === 0 ? "border border-freshgreen/24 bg-gradient-to-br from-deepforest/88 via-charcoal/72 to-charcoal/88" : "border border-freshgreen/18 bg-deepforest/62",
            ]}
            data-animation="pop-in"
            style={`transition-delay: ${[0.18, 0.3][i]}s;`}
          >
            <p class="text-[13px] font-semibold uppercase tracking-[0.32em] text-birch/70">{stat.label}</p>
            <div class="mt-6 flex flex-wrap items-end gap-x-3 gap-y-1">
              <p class:list={["font-semibold leading-none text-freshgreen", i === 0 ? "text-[44px] sm:text-[80px]" : stat.value.length > 6 ? "text-[40px] sm:text-[44px]" : "text-[56px] sm:text-[64px]"]}>{stat.value}</p>
              {stat.badge && <span class="mb-2 rounded-full border border-freshgreen/30 px-3 py-1 text-[13px] font-semibold text-freshgreen">{stat.badge}</span>}
            </div>
            <p class="mt-5 text-[15px] leading-relaxed text-birch/74">{stat.desc}</p>
            {stat.note && <p class="mt-6 text-[13px] font-semibold uppercase tracking-[0.28em] text-sage/90">{stat.note}</p>}
            <a class="data-card-source mt-6 inline-block text-[13px] leading-snug text-birch/60 underline decoration-birch/25 underline-offset-4 transition-colors hover:text-freshgreen" href={stat.href} target="_blank" rel="noopener">{stat.source} <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>


<style>
  .home-data-section {
    background: transparent;
  }

  .data-botanical {
    position: absolute;
    pointer-events: none;
    background-repeat: no-repeat;
    background-size: contain;
    filter: invert(1);
    opacity: 0.06;
  }

  .data-botanical-left {
    left: -5rem;
    top: 16%;
    width: min(30vw, 360px);
    height: min(42vw, 520px);
    background-image: url("/assets/about-botanicals/botanical-line-02.png");
  }

  .data-botanical-right {
    right: -5rem;
    bottom: 3%;
    width: min(32vw, 400px);
    height: min(42vw, 520px);
    background-image: url("/assets/about-botanicals/botanical-line-04.png");
    transform: rotate(8deg);
  }

  .data-card {
    position: relative;
    overflow: hidden;
    transition: transform 320ms ease, border-color 320ms ease, background 320ms ease;
  }

  .data-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 24% 0%, rgba(110, 191, 126, 0.12), transparent 36%);
    opacity: 0;
    transition: opacity 320ms ease;
    pointer-events: none;
  }

  .data-card:hover {
    transform: translateY(-4px);
    border-color: rgba(110, 191, 126, 0.34);
  }

  .data-card:hover::after {
    opacity: 1;
  }

  /* Entrance Animations */
  .animate-slide-in { animation: slideIn 0.8s ease-out forwards; }
  .animate-slide-in-right { animation: slideInRight 0.8s ease-out forwards; }
  .animate-pop-in { animation: popIn 0.7s ease-out forwards; }
  .animate-bounce-in { animation: bounceIn 0.7s ease-out forwards; }

  @keyframes slideIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(40px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.96) translateY(16px); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes bounceIn {
    0% { opacity: 0; transform: translateY(20px); }
    100% { opacity: 1; transform: scale(1); }
  }

  @media (max-width: 767px) {
    .data-botanical-right {
      display: none;
    }

    .data-botanical-left {
      width: 240px;
      height: 340px;
      opacity: 0.045;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-slide-in,
    .animate-slide-in-right,
    .animate-pop-in,
    .animate-bounce-in {
      animation-duration: 1ms;
    }
  }
</style>
