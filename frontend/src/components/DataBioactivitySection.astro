---
import ArrowRight from "@assets/icons/ArrowRight.svg";
import { Image } from "astro:assets";

const dataCopy = {
  en: {
    kicker: "THE PROBLEM",
    subheadline: "What is not known is not valued. And what is not valued is lost.",
    intro: "Only a small share of the world's plant species has ever been systematically studied for its chemistry or pharmacology. Without that knowledge, a plant has no recognized value, and it can disappear before anyone learns what it could do.",
    hook: "Moka exists to change that, starting with Latin American plants.",
    pills: ["Bioactivity prioritization", "Molecular indexing", "IP intelligence"],
    cta: "Our Technology",
    stats: [
      { label: "Studied plants", value: "~6% · ~15%", desc: "of plant species estimated to have been systematically investigated pharmacologically (~6%) and phytochemically (~15%). A global estimate.", source: "Source: Atanasov et al., Biotechnology Advances (2015)", href: "https://doi.org/10.1016/j.biotechadv.2015.08.001" },
      { label: "Flora of the Americas", prefix: "About", value: "1 in 3", desc: "of the world's known vascular plant species are native to the Americas.", source: "Source: Ulloa Ulloa et al., Science (2017)", href: "https://doi.org/10.1126/science.aao0398" },
      { label: "Extinction risk", value: "~45%", desc: "of flowering plant species may be threatened with extinction, according to a global model estimate.", source: "Source: Bachman et al., New Phytologist (2024)", href: "https://doi.org/10.1111/nph.19592" },
    ],
  },
  es: {
    kicker: "EL PROBLEMA",
    subheadline: "Lo que no se conoce no se valora. Y lo que no se valora se pierde.",
    intro: "Solo una pequeña parte de las especies de plantas del mundo se ha estudiado de forma sistemática por su química o su farmacología. Sin ese conocimiento, una planta no tiene un valor reconocido, y puede desaparecer antes de que alguien sepa lo que podría hacer.",
    hook: "Moka existe para cambiar eso, empezando por las plantas latinoamericanas.",
    pills: ["Priorización de bioactividad", "Indexación molecular", "Inteligencia de PI"],
    cta: "Nuestra tecnología",
    stats: [
      { label: "Plantas estudiadas", value: "~6% · ~15%", desc: "de las especies de plantas, según estimaciones, se han investigado de forma sistemática en lo farmacológico (~6%) y en lo fitoquímico (~15%). Una estimación global.", source: "Fuente: Atanasov et al., Biotechnology Advances (2015)", href: "https://doi.org/10.1016/j.biotechadv.2015.08.001" },
      { label: "Flora de las Américas", prefix: "Cerca de", value: "1 de cada 3", desc: "especies de plantas vasculares conocidas en el mundo es nativa de las Américas.", source: "Fuente: Ulloa Ulloa et al., Science (2017)", href: "https://doi.org/10.1126/science.aao0398" },
      { label: "Riesgo de extinción", value: "~45%", desc: "de las especies de plantas con flor podrían estar amenazadas de extinción, según una estimación global basada en modelos.", source: "Fuente: Bachman et al., New Phytologist (2024)", href: "https://doi.org/10.1111/nph.19592" },
    ],
  },
  pt: {
    kicker: "O PROBLEMA",
    subheadline: "O que não se conhece não se valoriza. E o que não se valoriza se perde.",
    intro: "Só uma pequena parte das espécies de plantas do mundo foi estudada de forma sistemática quanto à sua química ou farmacologia. Sem esse conhecimento, uma planta não tem valor reconhecido, e pode desaparecer antes que alguém descubra o que ela poderia fazer.",
    hook: "A Moka existe para mudar isso, começando pelas plantas da América Latina.",
    pills: ["Priorização de bioatividade", "Indexação molecular", "Inteligência de PI"],
    cta: "Nossa tecnologia",
    stats: [
      { label: "Plantas estudadas", value: "~6% · ~15%", desc: "das espécies de plantas, segundo estimativas, foram investigadas de forma sistemática do ponto de vista farmacológico (~6%) e fitoquímico (~15%). Uma estimativa global.", source: "Fonte: Atanasov et al., Biotechnology Advances (2015)", href: "https://doi.org/10.1016/j.biotechadv.2015.08.001" },
      { label: "Flora das Américas", prefix: "Cerca de", value: "1 em cada 3", desc: "espécies de plantas vasculares conhecidas no mundo é nativa das Américas.", source: "Fonte: Ulloa Ulloa et al., Science (2017)", href: "https://doi.org/10.1126/science.aao0398" },
      { label: "Risco de extinção", value: "~45%", desc: "das espécies de plantas com flor podem estar ameaçadas de extinção, segundo uma estimativa global baseada em modelos.", source: "Fonte: Bachman et al., New Phytologist (2024)", href: "https://doi.org/10.1111/nph.19592" },
    ],
  },
};

interface Props {
  locale?: "en" | "es" | "pt";
}

const { locale = "en" } = Astro.props;
const t = dataCopy[locale] ?? dataCopy.en;
const localePrefix = locale === "en" ? "" : `/${locale}`;
---

<section class="home-data-section relative -mt-1 overflow-hidden px-5 py-20 sm:px-8 lg:py-28">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/24 to-transparent"></div>
  <div class="data-botanical data-botanical-left" aria-hidden="true"></div>
  <div class="data-botanical data-botanical-right" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
    <div class="flex flex-col">
      <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.1s;">
        <p class="font-roboto text-[13px] font-medium leading-none tracking-[0.45em] text-freshgreen uppercase">
          {t.kicker}
        </p>
        <div class="mt-5">
          <h2 class="font-inter text-[clamp(1.9rem,3.4vw,3rem)] font-semibold leading-[1.05] text-pure">{t.subheadline}</h2>
        </div>
      </div>

      <div class="reveal opacity-0 font-inter mt-4" data-animation="slide-in" style="transition-delay: 0.3s;">
        <p class="max-w-xl text-[18px] leading-relaxed text-birch/72 sm:text-[20px]">
          {t.intro}
        </p>
        <p class="mt-5 max-w-xl font-inter text-[20px] font-semibold leading-snug text-freshgreen sm:text-[24px]">{t.hook}</p>
      </div>

      <div class="reveal opacity-0 mt-8 flex flex-wrap gap-3" data-animation="slide-in" style="transition-delay: 0.45s;">
        {t.pills.map((pill: string) => (
          <span class="rounded-full border border-birch/10 bg-charcoal/40 px-4 py-2 text-sm font-medium text-birch/82 shadow-sm shadow-black/20 backdrop-blur-md">{pill}</span>
        ))}
      </div>

      <a 
        href={`${localePrefix}/our-technology`} 
        class="reveal opacity-0 mt-10 flex w-fit items-center gap-3 rounded-full bg-pure py-2 pl-6 pr-2 font-inter text-[16px] font-semibold text-charcoal shadow-lg shadow-black/20 ring-1 ring-pure/10 transition-all duration-300 hover:bg-freshgreen hover:shadow-freshgreen/20 active:scale-95 no-underline"
        data-analytics-event="click_view_technology"
        data-analytics-category="cta"
        data-analytics-label="data_bioactivity_cta"
        data-animation="bounce-in"
        style="transition-delay: 0.75s;"
      >
        <span>{t.cta}</span>
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-charcoal">
          <Image src={ArrowRight} alt="arrow-right" class="h-5 w-5" />
        </span>
      </a>
    </div>

    <div class="grid gap-4 font-inter">
      <div class="grid gap-4 sm:grid-cols-2">
        {t.stats.map((stat, i) => (
          <article
            class:list={[
              "data-card reveal opacity-0 rounded-[1.5rem] p-6 shadow-2xl shadow-black/25 backdrop-blur-xl",
              i === 0 ? "border border-freshgreen/24 bg-gradient-to-br from-deepforest/88 via-charcoal/72 to-charcoal/88 sm:col-span-2" : i === 1 ? "border border-birch/10 bg-charcoal/52" : "border border-freshgreen/18 bg-deepforest/62",
            ]}
            data-animation="pop-in"
            style={`transition-delay: ${[0.18, 0.25, 0.4][i]}s;`}
          >
            <p class="text-[13px] font-semibold uppercase tracking-[0.32em] text-birch/70">{stat.label}</p>
            <div class="mt-6 flex flex-wrap items-end gap-x-3 gap-y-1">
              {stat.prefix && <span class="mb-1 text-[20px] font-semibold leading-none text-freshgreen/80">{stat.prefix}</span>}
              <p class:list={["font-semibold leading-none text-freshgreen", i === 0 ? "text-[44px] sm:text-[80px]" : stat.value.length > 6 ? "text-[40px] sm:text-[44px]" : "text-[56px] sm:text-[64px]"]}>{stat.value}</p>
            </div>
            <p class="mt-5 text-[15px] leading-relaxed text-birch/74">{stat.desc}</p>
            <a class="data-card-source mt-6 inline-block text-[13px] leading-snug text-birch/60 underline decoration-birch/25 underline-offset-4 transition-colors hover:text-freshgreen" href={stat.href} target="_blank" rel="noopener">{stat.source} <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>


<style>
  .home-data-section {
    background: transparent;
  }

  .data-botanical {
    position: absolute;
    pointer-events: none;
    background-repeat: no-repeat;
    background-size: contain;
    filter: invert(1);
    opacity: 0.06;
  }

  .data-botanical-left {
    left: -5rem;
    top: 16%;
    width: min(30vw, 360px);
    height: min(42vw, 520px);
    background-image: url("/assets/about-botanicals/botanical-line-02.png");
  }

  .data-botanical-right {
    right: -5rem;
    bottom: 3%;
    width: min(32vw, 400px);
    height: min(42vw, 520px);
    background-image: url("/assets/about-botanicals/botanical-line-04.png");
    transform: rotate(8deg);
  }

  .data-card {
    position: relative;
    overflow: hidden;
    transition: transform 320ms ease, border-color 320ms ease, background 320ms ease;
  }

  .data-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 24% 0%, rgba(110, 191, 126, 0.12), transparent 36%);
    opacity: 0;
    transition: opacity 320ms ease;
    pointer-events: none;
  }

  .data-card:hover {
    transform: translateY(-4px);
    border-color: rgba(110, 191, 126, 0.34);
  }

  .data-card:hover::after {
    opacity: 1;
  }

  /* Entrance Animations */
  .animate-slide-in { animation: slideIn 0.8s ease-out forwards; }
  .animate-slide-in-right { animation: slideInRight 0.8s ease-out forwards; }
  .animate-pop-in { animation: popIn 0.7s ease-out forwards; }
  .animate-bounce-in { animation: bounceIn 0.7s ease-out forwards; }

  @keyframes slideIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(40px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.96) translateY(16px); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes bounceIn {
    0% { opacity: 0; transform: translateY(20px); }
    100% { opacity: 1; transform: scale(1); }
  }

  @media (max-width: 767px) {
    .data-botanical-right {
      display: none;
    }

    .data-botanical-left {
      width: 240px;
      height: 340px;
      opacity: 0.045;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-slide-in,
    .animate-slide-in-right,
    .animate-pop-in,
    .animate-bounce-in {
      animation-duration: 1ms;
    }
  }
</style>
