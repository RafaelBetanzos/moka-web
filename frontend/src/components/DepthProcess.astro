---
// Services: how deep a project goes. The section stays on screen while you scroll through it:
// a horizontal bar advances through the steps, the text and the picture change with each one,
// and the depth levels (extract, fraction, molecule) light up as they are reached. Clicking a
// step jumps to it. On phones (and with reduced motion) the steps are a simple list.
interface Step {
  /** Depth tag shown on the bar, e.g. "Extract". */
  depth: string;
  title: string;
  body: string;
  image: string;
  imageAlt: string;
  /** Photo with its own background: fills the circle. Otherwise (transparent cut-out) it sits inside it. */
  fill?: boolean;
}

interface Props {
  id?: string;
  title: string;
  intro: string;
  steps: Step[];
}

const { id, title, intro, steps } = Astro.props;
---

<section id={id} class="dp" style={`--dp-steps: ${steps.length};`} data-dp>
  <div class="dp-sticky">
    <div class="dp-head">
      <h2 class="dp-title">{title}</h2>
      <p class="dp-intro">{intro}</p>
    </div>

    <div class="dp-stage">
      <div class="dp-texts">
        {steps.map((s, i) => (
          <div class:list={["dp-text", i === 0 && "is-active"]} style={`order: ${i * 2};`} data-dp-text>
            <span class="dp-num">0{i + 1}</span>
            <h3 class="dp-step-title">{s.title}</h3>
            <p class="dp-step-body">{s.body}</p>
          </div>
        ))}
      </div>
      <div class="dp-images">
        {steps.map((s, i) => (
          <img class:list={["dp-image", i === 0 && "is-active", s.fill && "dp-image--fill"]} style={`order: ${i * 2 + 1};`} src={s.image} alt={s.imageAlt} loading="lazy" decoding="async" data-dp-image />
        ))}
      </div>
    </div>

    <ol class="dp-bar">
      <span class="dp-bar-line" aria-hidden="true"><span class="dp-bar-fill"></span></span>
      {steps.map((s, i) => (
        <li class:list={["dp-stop", i === 0 && "is-on"]} data-dp-stop>
          <button type="button" class="dp-stop-btn" data-dp-go={i}>
            <span class="dp-dot" aria-hidden="true"></span>
            <span class="dp-depth">{s.depth}</span>
          </button>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  // Scroll position inside the (tall) section → active step and bar fill.
  document.querySelectorAll<HTMLElement>("[data-dp]").forEach((el) => {
    const texts = [...el.querySelectorAll<HTMLElement>("[data-dp-text]")];
    const images = [...el.querySelectorAll<HTMLElement>("[data-dp-image]")];
    const stops = [...el.querySelectorAll<HTMLElement>("[data-dp-stop]")];
    const n = texts.length;
    const sticky = () => window.matchMedia("(min-width: 768px) and (prefers-reduced-motion: no-preference)").matches;
    let active = -1;
    let ticking = false;

    const progressOf = () => {
      const r = el.getBoundingClientRect();
      const run = r.height - window.innerHeight;
      return run <= 0 ? 1 : Math.min(1, Math.max(0, -r.top / run));
    };

    const update = () => {
      ticking = false;
      if (!sticky()) {
        el.style.setProperty("--dp-progress", "1");
        return;
      }
      const p = progressOf();
      const idx = Math.min(n - 1, Math.floor(p * n));
      el.style.setProperty("--dp-progress", (idx / (n - 1)).toFixed(4));
      if (idx === active) return;
      active = idx;
      texts.forEach((t, i) => t.classList.toggle("is-active", i === idx));
      images.forEach((t, i) => t.classList.toggle("is-active", i === idx));
      stops.forEach((t, i) => t.classList.toggle("is-on", i <= idx));
    };

    el.querySelectorAll<HTMLButtonElement>("[data-dp-go]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const i = Number(btn.dataset.dpGo);
        const run = el.offsetHeight - window.innerHeight;
        const top = el.getBoundingClientRect().top + window.scrollY + run * ((i + 0.5) / n);
        window.scrollTo({ top, behavior: "smooth" });
      });
    });

    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  });
</script>

<style>
  /* Tall section: each step gets roughly 70% of a screen of scrolling. */
  .dp {
    --dp-progress: 0;
    position: relative;
    z-index: 10;
    height: calc(var(--dp-steps) * 70vh + 100vh);
    scroll-margin-top: 5rem;
  }

  .dp-sticky {
    position: sticky;
    top: 5rem;
    height: calc(100vh - 5rem);
    width: min(100% - 2.5rem, 1180px);
    margin: 0 auto;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1.5rem;
    padding: 2rem 0 2.5rem;
  }

  .dp-head { text-align: center; max-width: 780px; margin: 0 auto; }

  .dp-title {
    font-family: Inter, sans-serif;
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    font-weight: 650;
    line-height: 1.05;
    color: var(--pure-color);
    text-wrap: balance;
  }

  .dp-intro {
    margin-top: 0.9rem;
    font-family: Inter, sans-serif;
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    line-height: 1.65;
    color: var(--moka-text-muted);
  }

  /* ── Stage: current step text + picture ── */
  .dp-stage {
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 3rem;
    align-items: center;
  }

  .dp-texts, .dp-images { position: relative; height: 100%; min-height: 0; }

  .dp-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    transform: translateY(1.5rem);
    transition: opacity 500ms ease, transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .dp-text.is-active { opacity: 1; transform: none; pointer-events: auto; }

  .dp-num {
    font-family: Roboto, sans-serif;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--fresh-green-color);
  }

  .dp-step-title {
    margin-top: 0.75rem;
    font-family: Inter, sans-serif;
    font-size: clamp(1.6rem, 2.6vw, 2.3rem);
    font-weight: 650;
    line-height: 1.1;
    color: var(--pure-color);
  }

  .dp-step-body {
    margin-top: 0.9rem;
    max-width: 30rem;
    font-family: Inter, sans-serif;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.7;
    color: var(--moka-text-muted);
  }

  .dp-image {
    position: absolute;
    inset: 0;
    margin: auto;
    height: min(100%, 440px);
    width: auto;
    aspect-ratio: 1;
    border-radius: 999px;
    border: 1px solid rgba(110, 191, 126, 0.3);
    background: radial-gradient(circle at 50% 40%, rgba(19, 45, 37, 0.9), rgba(18, 18, 18, 0.95) 70%);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    padding: 11%;
    object-fit: contain;
    opacity: 0;
    transform: scale(0.96);
    transition: opacity 600ms ease, transform 800ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Round frame: cut-outs sit inside it, photos fill it. */
  .dp-image--fill { object-fit: cover; padding: 0; clip-path: circle(50%); }

  .dp-image.is-active { opacity: 1; transform: none; }

  /* ── Bar with the depth levels ── */
  .dp-bar {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--dp-steps), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dp-bar-line {
    position: absolute;
    top: 7px;
    left: calc(50% / var(--dp-steps));
    right: calc(50% / var(--dp-steps));
    height: 3px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.18);
    overflow: hidden;
  }

  .dp-bar-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(110, 191, 126, 0.35), var(--fresh-green-color));
    transform-origin: left center;
    transform: scaleX(var(--dp-progress));
    transition: transform 500ms cubic-bezier(0.45, 0, 0.25, 1);
  }

  .dp-stop { position: relative; display: flex; justify-content: center; }

  .dp-stop-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: inherit;
  }

  .dp-dot {
    width: 16px;
    height: 16px;
    border-radius: 999px;
    background: rgba(222, 222, 222, 0.35);
    box-shadow: 0 0 0 6px rgba(18, 18, 18, 1);
    transition: background 400ms ease, transform 400ms ease;
  }

  .dp-depth {
    font-family: Roboto, sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(222, 222, 222, 0.5);
    transition: color 400ms ease;
    text-align: center;
  }

  .dp-stop.is-on .dp-dot { background: var(--fresh-green-color); }
  .dp-stop.is-on .dp-depth { color: var(--pure-color); }
  .dp-stop-btn:hover .dp-dot, .dp-stop-btn:focus-visible .dp-dot { transform: scale(1.25); }
  .dp-stop-btn:focus-visible { outline: 2px solid var(--fresh-green-color); outline-offset: 6px; border-radius: 0.5rem; }

  /* ── Phones and reduced motion: a plain list, every step visible ── */
  @media (max-width: 767px), (prefers-reduced-motion: reduce) {
    .dp { height: auto; }

    .dp-sticky {
      position: static;
      height: auto;
      display: block;
      padding: 4rem 0 3rem;
    }

    /* Each step: its text, then its picture (inline `order` interleaves them). */
    .dp-texts, .dp-images { display: contents; }

    .dp-text, .dp-image {
      position: static;
      opacity: 1;
      transform: none;
      transition: none;
    }

    .dp-stage { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 2.5rem; }

    .dp-text { margin-top: 1.5rem; }
    .dp-image { height: auto; width: min(100%, 260px); margin: 0 auto; }

    .dp-bar { display: none; }
  }
</style>
