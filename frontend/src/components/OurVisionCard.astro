---
import ArrowRight from "@assets/icons/ArrowRight.svg";
import { Image } from "astro:assets";
const { isButtonOn } = Astro.props;
---

<div
  class="bg-secondcard shadow-md rounded-3xl flex flex-col items-center text-secondary max-w-4xl py-12 px-12 md:px-24 reveal-card transition-all duration-700 hover:shadow-2xl"
>
  <h1 class="text-4xl font-bold font-roboto pb-12 opacity-0 reveal-item-1">OUR VISION</h1>
  <div class="flex flex-col items-center">
    <p class="text-xl sm:text-4xl font-inter text-center sm:leading-[46px] opacity-0 reveal-item-2">
      Moka Bio envisions a future where <strong>natural products</strong>, 
      rigorously evaluated for safety and efficacy, become a trusted
      cornerstone of human health.
    </p>
    {
      isButtonOn && (
        <div class="mt-8 opacity-0 reveal-item-3">
          <button class="group flex gap-6 items-center justify-center bg-white text-navbar font-inter font-medium text-[22px] rounded-full max-w-fit p-1 transition-all duration-300 hover:pr-4 hover:bg-opacity-90">
            <a class="text-center text-[20px] ml-4" href="/about-us">
              About us
            </a>
            <div class="flex items-center justify-center bg-secondary rounded-full w-10 h-10 transition-transform duration-300 group-hover:rotate-[-45deg] group-hover:scale-110">
              <Image src={ArrowRight} alt="arrow-right" class="w-5 h-5" />
            </div>
          </button>
        </div>
      )
    }
  </div>
</div>

<style>
  /* Animación de entrada al cargar la página */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .reveal-item-1 {
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 0.2s;
  }

  .reveal-item-2 {
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 0.4s;
  }

  .reveal-item-3 {
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 0.6s;
  }

  /* Efecto de pulso sutil para la tarjeta */
  .reveal-card {
    border: 1px solid rgba(var(--secondary-rgb), 0.1);
  }
</style>