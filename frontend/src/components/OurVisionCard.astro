---
import ArrowRight from "@assets/icons/ArrowRight.svg";
import { Image } from "astro:assets";
const { isButtonOn } = Astro.props;
---

<div
  class="relative overflow-hidden rounded-[1.75rem] border border-birch/10 bg-deepforest/64 shadow-2xl shadow-black/28 flex flex-col items-center text-pure max-w-4xl py-12 px-8 md:px-20 transition-all duration-700 hover:border-freshgreen/34 backdrop-blur-xl"
>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_10%,rgba(110,191,126,0.12),transparent_34%),linear-gradient(145deg,rgba(255,255,255,0.035),rgba(18,18,18,0.18))]"></div>

  <p class="reveal opacity-0 relative text-xs font-bold font-roboto pb-8 tracking-[0.45em] text-freshgreen uppercase" data-animation="slide-up" style="transition-delay: 0.05s;">
    OUR VISION
  </p>

  <div class="relative flex flex-col items-center">
    <p class="reveal opacity-0 text-xl sm:text-4xl font-inter text-center sm:leading-[46px] text-pure" data-animation="slide-up" style="transition-delay: 0.2s;">
      Moka Bio envisions a future where <strong class="text-freshgreen">natural products</strong>,
      rigorously evaluated for safety and efficacy, become a trusted
      <span class="text-birch">cornerstone of human health.</span>
    </p>

    {
      isButtonOn && (
        <div class="reveal opacity-0 mt-8" data-animation="slide-up" style="transition-delay: 0.35s;">
          <a href="/about-us" class="group flex gap-6 items-center justify-center bg-pure text-charcoal font-inter font-semibold text-[16px] rounded-full max-w-fit p-1 pl-5 shadow-lg shadow-black/20 ring-1 ring-pure/10 transition-all duration-300 hover:pr-4 hover:bg-freshgreen hover:shadow-freshgreen/20 no-underline">
            <span class="text-center text-[16px]">About us</span>
            <div class="flex items-center justify-center bg-charcoal rounded-full w-10 h-10 transition-transform duration-300 group-hover:rotate-[-45deg] group-hover:scale-110">
              <Image src={ArrowRight} alt="arrow-right" class="w-5 h-5" />
            </div>
          </a>
        </div>
      )
    }
  </div>
</div>

<style>
  .animate-slide-up { animation: slideUp 0.8s ease-out forwards; }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-slide-up { animation-duration: 1ms; }
  }
</style>
