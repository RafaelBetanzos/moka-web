---
import ArrowRight from "@assets/icons/ArrowRight.svg";
import { Image } from "astro:assets";
const { isButtonOn } = Astro.props;
---

<div
  class="rounded-[1.75rem] border border-sage/30 bg-deepforest/70 shadow-2xl shadow-black/30 flex flex-col items-center text-pure max-w-4xl py-12 px-8 md:px-20 reveal-card transition-all duration-700 hover:border-freshgreen/40"
>
  <h1 class="text-sm font-bold font-roboto pb-8 opacity-0 reveal-item-1 tracking-[0.45em] text-freshgreen">OUR VISION</h1>
  <div class="flex flex-col items-center">
    <p class="text-xl sm:text-4xl font-inter text-center sm:leading-[46px] opacity-0 reveal-item-2 text-pure">
      Moka Bio envisions a future where <strong class="text-freshgreen">natural products</strong>, 
      rigorously evaluated for safety and efficacy, become a trusted
      <span class="text-birch">cornerstone of human health.</span>
    </p>
    {
      isButtonOn && (
        <div class="mt-8 opacity-0 reveal-item-3">
          <a href="/about-us" class="group flex gap-6 items-center justify-center bg-pure text-charcoal font-inter font-semibold text-[16px] rounded-full max-w-fit p-1 pl-5 transition-all duration-300 hover:pr-4 hover:bg-freshgreen no-underline">
            <span class="text-center text-[16px]">
              About us
            </span>
            <div class="flex items-center justify-center bg-charcoal rounded-full w-10 h-10 transition-transform duration-300 group-hover:rotate-[-45deg] group-hover:scale-110">
              <Image src={ArrowRight} alt="arrow-right" class="w-5 h-5" />
            </div>
          </a>
        </div>
      )
    }
  </div>
</div>

<style>
  /* Animación de entrada al cargar la página */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .reveal-item-1 {
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 0.2s;
  }

  .reveal-item-2 {
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 0.4s;
  }

  .reveal-item-3 {
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 0.6s;
  }

  /* Efecto de pulso sutil para la tarjeta */
  .reveal-card {}
</style>
