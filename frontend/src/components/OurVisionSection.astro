---
import OurVisionCard from "./OurVisionCard.astro";

const { locale = "en" } = Astro.props;
---

<div class="home-vision-section relative overflow-hidden w-full px-5 sm:px-8 py-20">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-sage/20 to-transparent"></div>
  <div class="relative flex flex-col justify-center items-center">
    <OurVisionCard isButtonOn={true} locale={locale} />
  </div>
</div>

<style>
  .home-vision-section {
    background: transparent;
  }
</style>
