---
import { Image } from "astro:assets";
const { image, altImage, title, chevron, content } = Astro.props;
import DoubleChevron from "../assets/icons/DoubleChevron.svg";
---

<div class="flex flex-row items-center justify-center relative top-6 z-10">
  <Image src={image} alt={altImage} />
</div>
<div class="bg-white drop-shadow-sm rounded-3xl p-6 md:w-[300px] mb-3">
  <div>
    <p class="text-secondary font-medium text-center">{title}</p>
  </div>
  <div>
    <p class="text-graycolor text-center text-[16px]">
      {content}
    </p>
  </div>
</div>
<div class="flex flex-row items-center justify-center mt-3">
  {chevron && <Image src={DoubleChevron} alt="double-chevron" />}
</div>
