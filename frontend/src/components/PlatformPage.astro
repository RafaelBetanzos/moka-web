        <div class="tech-page-rule" aria-hidden="true"></div>
      </div>
    </div>

    <div class="relative z-10 w-full">
      <ModuleJourney id="capabilities" title={copy.modulesTitle} intro={copy.modulesIntro} modules={copy.modules} />
    </div>

    <div class="relative z-10 w-full">
      <TargetSection locale={locale} variant="links" heading="starting" id="starting-points" />
    </div>

    <section id="research-teams" class="industry-section relative z-10 journey-section">
      <div class="landing-split">
        <div>
          <h2 class="industry-h2 reveal opacity-0" data-animation="slide-up">{copy.researchTitle}</h2>
          <p class="industry-intro journey-answer reveal opacity-0" data-animation="slide-up">{copy.researchBody}</p>
          <div class="journey-links">
            <a class="industry-link" href="#explore-icaros">{copy.researchIcaros} <span aria-hidden="true">→</span></a>
            <a class="industry-link" href="#capabilities">{copy.researchCapabilities} <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="landing-split-media reveal opacity-0" data-animation="pop-in">
          <img src="/webpics/technitianextractinplants.png" alt={copy.researchAlt} width="672" height="672" loading="lazy" decoding="async" />
        </div>
      </div>
    </section>

    <div class="relative z-10 w-full">
      <TrustSection locale={locale} showCta={false} variant="platform" />
    </div>

    <div class="relative z-10 w-full">
      <CtaBand
        title={copy.ctaTitle}
        primary={{ label: copy.demo, href: `${contactBase}?interest=demo`, event: "book_demo_click" }}
        secondary={{ label: copy.ctaService, href: `${prefix}/services/`, event: "click_view_services" }}
        analyticsLabel="platform_final"
      />
    </div>
  </div>
</BaseLayout>

<script>
  const techPage = document.querySelector('.tech-page') as HTMLElement | null;

  const updateTechProgress = () => {
    if (!techPage) return;
    const rect = techPage.getBoundingClientRect();
    const scrollable = rect.height - window.innerHeight;
    const progress = scrollable <= 0 ? 1 : Math.min(1, Math.max(0, -rect.top / scrollable));
    techPage.style.setProperty('--tech-progress', progress.toString());
    techPage.style.setProperty('--branch-1', Math.min(1, progress / 0.18).toString());
    techPage.style.setProperty('--branch-2', Math.min(1, Math.max(0, (progress - 0.14) / 0.22)).toString());
    techPage.style.setProperty('--branch-3', Math.min(1, Math.max(0, (progress - 0.34) / 0.28)).toString());
    techPage.style.setProperty('--branch-4', Math.min(1, Math.max(0, (progress - 0.58) / 0.34)).toString());
  };

  updateTechProgress();
  window.addEventListener('scroll', updateTechProgress, { passive: true });
  window.addEventListener('resize', updateTechProgress);

  // ── Consolidated IntersectionObserver for all .reveal elements ──
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const animation = entry.target.getAttribute('data-animation');
          if (animation) entry.target.classList.add(`animate-${animation}`);
          entry.target.classList.remove('opacity-0');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
</script>

