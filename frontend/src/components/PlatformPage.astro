// Same @id as the node that lived on the retired Tech page.
const schema = [
  {
    "@type": "SoftwareApplication",
    "@id": "https://moka.bio/#moka-bde",
    name: "Moka BDE",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    description: copy.schemaDescription,
    featureList: copy.features,
    provider: { "@id": "https://moka.bio/#organization" },
