---
// /our-technology/ (EN, ES, PT): Moka BDE and Icaros. Built from the retired Tech page blocks
// plus the product content that left the home.
import BaseLayout from "@layouts/BaseLayout.astro";
import BotanicalScrollReveal from "@components/BotanicalScrollReveal.astro";
import BrainSection from "@components/BrainSection.astro";
import CtaBand from "@components/CtaBand.astro";
import ModuleJourney from "@components/ModuleJourney.astro";
import TargetSection from "@components/TargetSection.astro";
import TrustSection from "@components/TrustSection.astro";
import "../styles/seo-landing.css";
import { ogImageOr } from "../utils/publicAsset";

