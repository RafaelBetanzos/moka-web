      { id: "log", name: "Log", question: "¿Por qué elegimos este candidato y en qué nos quedamos?", answer: "un chat que responde sobre todo lo que hay en tu sesión o proyecto.", screen: "/mockups/Log", screenAlt: "Moka BDE: Log" },
