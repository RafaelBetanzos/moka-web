            <path d="M16 58h48M22 58V24h36v34" />
            <path d="M30 48V36M40 48V28M50 48V40" />
            <path d="M28 24l8-10h8l8 10" />
          </svg>
          <svg class="tech-silhouette float-b absolute right-[60%] top-[72%] w-14 lg:w-16" viewBox="0 0 80 80">
            <path d="M18 54c14-22 30-22 44 0" />
            <path d="M22 46c8-10 16-16 28-16M30 58c8-9 18-13 30-10" />
            <circle cx="24" cy="46" r="4" />
            <circle cx="50" cy="30" r="4" />
            <circle cx="60" cy="48" r="4" />
          </svg>
        </div>
      </div>
      <div class="relative z-10 flex flex-col items-center text-center px-6 sm:px-8 gap-5">
        <h1 class="tech-page-title">{copy.title}</h1>
        <a class="tech-icaros-pill" href="#explore-icaros" data-analytics-event="click_view_technology" data-analytics-category="cta" data-analytics-label="platform_icaros_pill">Icaros</a>
      </div>
      <BrainSection locale={locale} parts={["brain"]} showName={false} />
      <div class="relative z-10 flex flex-col items-center text-center px-6 sm:px-8 gap-5">
        <p class="tech-page-tagline">{copy.tagline}</p>
        <div class="tech-page-ctas">
          <a href={`${contactBase}?interest=demo`} class="moka-demo-cta" data-analytics-event="book_demo_click" data-analytics-category="cta" data-analytics-label="platform_hero">{copy.demo} <span aria-hidden="true">→</span></a>
          <a href={`${prefix}/services/`} class="industry-secondary" data-analytics-event="click_view_services" data-analytics-category="cta" data-analytics-label="platform_hero">{copy.toServices} <span aria-hidden="true">→</span></a>
