---
import LeafPill from "@assets/icons/LeafPill.svg";
import { Image } from "astro:assets";

const contactCopy = {
  en: {
    kicker: "CONTACT US!",
    headline: "Let's unlock the potential of nature together.",
    pills: ["Bioprospecting", "Nature", "Computational Biology"],
  },
  es: {
    kicker: "CONTACTO",
    headline: "Desbloqueemos juntos el potencial de la naturaleza.",
    pills: ["Bioprospección", "Naturaleza", "Biología computacional"],
  },
  pt: {
    kicker: "CONTATO",
    headline: "Vamos desbloquear juntos o potencial da natureza.",
    pills: ["Bioprospecção", "Natureza", "Biologia computacional"],
  },
};

const { locale = "en" } = Astro.props;
const t = contactCopy[locale] ?? contactCopy.en;
---

<div
  class="relative z-10 overflow-hidden rounded-[2rem] border border-sage/30 bg-deepforest/80 p-8 md:p-12 flex flex-col justify-center text-pure font-inter font-bold shadow-2xl shadow-black/25 max-w-xl px-8 min-h-[450px] reveal opacity-0"
  data-animation="fade-in"
>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_18%,rgba(110,191,126,0.18),transparent_34%),linear-gradient(135deg,rgba(18,18,18,0.1),rgba(19,45,37,0.48))]"></div>
  <div class="mb-12 flex flex-col gap-4">
    <p class="relative text-sm tracking-[0.45em] text-freshgreen reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.2s;">
      {t.kicker}
    </p>
    <p class="relative text-3xl md:text-4xl leading-tight reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.4s;">
      {t.headline}
    </p>
  </div>

  <div class="relative flex flex-wrap gap-3">
    {
      t.pills.map((tag, index) => (
        <div
          key={index}
          class="reveal opacity-0 flex items-center gap-3 text-birch bg-charcoal/50 backdrop-blur-md border border-sage/30 rounded-full py-2 px-5 transition-all duration-300 hover:bg-freshgreen hover:text-charcoal group cursor-default shadow-sm"
          data-animation="pop-in"
          style={`transition-delay: ${0.6 + index * 0.1}s;`}
        >
          <Image 
            src={LeafPill} 
            alt="Leaf Pill" 
            class="w-4 h-4 object-contain transition-transform group-hover:rotate-12" 
          />
          <span class="text-sm md:text-base font-medium whitespace-nowrap">
            {tag}
          </span>
        </div>
      ))
    }
  </div>
</div>

<style>
  /* Entrance Animations */
  .animate-fade-in { animation: fadeIn 1s ease-out forwards; }
  .animate-slide-up { animation: slideUp 0.8s ease-out forwards; }
  .animate-pop-in { animation: popIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.8); }
    to { opacity: 1; transform: scale(1); }
  }
</style>
