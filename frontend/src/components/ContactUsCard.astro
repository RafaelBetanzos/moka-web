---

const contactCopy = {
  en: {
    kicker: "CONTACT",
    headline: "Which plant intrigues you?",
    pageHeadline: "Book a demo or request a service.",
    nextTitle: "What happens next",
    cta: "Contact us",
    steps: [
      { title: "You write to us", body: "A platform demo or an R&D service." },
      { title: "We reply within 1 business day", body: "With a calendar so you can choose the date and time." },
      { title: "Straight to our team", body: "Your message goes only to the Moka team." },
    ],
  },
  es: {
    kicker: "CONTACTO",
    headline: "¿Qué planta te intriga?",
    pageHeadline: "Agenda una demo o solicita un servicio.",
    nextTitle: "Qué pasa después",
    cta: "Contáctanos",
    steps: [
      { title: "Nos escribes", body: "Demo de la plataforma o servicio de I+D." },
      { title: "Te respondemos en 1 día hábil", body: "Con un calendario para que elijas fecha y hora." },
      { title: "Directo a nuestro equipo", body: "Tu mensaje llega solo al equipo de Moka." },
    ],
  },
  pt: {
    kicker: "CONTATO",
    headline: "Qual planta te intriga?",
    pageHeadline: "Agende uma demonstração ou solicite um serviço.",
    nextTitle: "O que acontece depois",
    cta: "Fale conosco",
    steps: [
      { title: "Você nos escreve", body: "Demonstração da plataforma ou serviço de P&D." },
      { title: "Respondemos em até 1 dia útil", body: "Com um calendário para você escolher data e horário." },
      { title: "Direto para a nossa equipe", body: "Sua mensagem chega só à equipe da Moka." },
    ],
  },
};

interface Props {
  locale?: "en" | "es" | "pt";
  /** On the contact page the headline is the page's H1 and names both offers. */
  isPageHeading?: boolean;
  /** When set (home page), the card renders wide and short with a button to the contact page. */
  ctaHref?: string;
}

const { locale = "en", isPageHeading = false, ctaHref } = Astro.props;
const wide = Boolean(ctaHref);
const t = contactCopy[locale] ?? contactCopy.en;
const Heading = isPageHeading ? "h1" : "p";
---

<div
  class:list={[
    "relative z-10 overflow-hidden rounded-[2rem] border border-sage/30 bg-deepforest/80 flex flex-col justify-center text-pure font-inter font-bold shadow-2xl shadow-black/25 reveal opacity-0",
    wide ? "contact-card--wide w-full p-7 md:px-10 md:py-9" : "p-8 md:p-12 max-w-xl px-8 min-h-[450px]",
  ]}
  data-animation="fade-in"
>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_18%,rgba(110,191,126,0.18),transparent_34%),linear-gradient(135deg,rgba(18,18,18,0.1),rgba(19,45,37,0.48))]"></div>
  <div class="contact-card-head relative mb-8">
  <div class="flex flex-col gap-4">
    <p class="relative text-sm tracking-[0.45em] text-freshgreen reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.2s;">
      {t.kicker}
    </p>
    <Heading class="relative text-3xl md:text-4xl leading-tight reveal opacity-0" data-animation="slide-up" style="transition-delay: 0.4s;">
      {isPageHeading ? t.pageHeadline : t.headline}
    </Heading>
  </div>
  {wide && (
    <a
      href={ctaHref}
      class="moka-demo-cta contact-card-cta"
      data-analytics-event="contact_click"
      data-analytics-category="cta"
      data-analytics-label="home_contact"
    >{t.cta} <span aria-hidden="true">→</span></a>
  )}
  </div>

  <div class="relative">
    <p class="contact-next-title">{t.nextTitle}</p>
    <ol class="contact-steps">
      {t.steps.map((step, index) => (
        <li class="contact-step reveal opacity-0" data-animation="slide-up" style={`transition-delay: ${0.5 + index * 0.12}s;`}>
          <span class="contact-step-num" aria-hidden="true">{index + 1}</span>
          <div>
            <p class="contact-step-title">{step.title}</p>
            <p class="contact-step-body">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</div>

<style>
  /* Entrance Animations */
  .animate-fade-in { animation: fadeIn 1s ease-out forwards; }
  .animate-slide-up { animation: slideUp 0.8s ease-out forwards; }
  .animate-pop-in { animation: popIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.8); }
    to { opacity: 1; transform: scale(1); }
  }

  .contact-card-head {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-card--wide .contact-card-head {
    margin-bottom: 1.75rem;
  }

  .contact-card-cta {
    align-self: flex-start;
    min-height: 52px;
    padding: 0.9rem 2rem;
    font-size: 16px;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .contact-card--wide .contact-card-head {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .contact-card--wide .contact-card-cta { align-self: center; }

    .contact-card--wide .contact-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (max-width: 639px) {
    .contact-card-cta { align-self: stretch; justify-content: center; }
  }

  .contact-next-title {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(222, 222, 222, 0.6);
  }

  .contact-steps {
    margin-top: 1rem;
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .contact-step {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }

  .contact-step-num {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(110, 191, 126, 0.5);
    font-family: Roboto, sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: var(--fresh-green-color);
  }

  .contact-step-title {
    font-family: Inter, sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
    color: var(--pure-color);
  }

  .contact-step-body {
    margin-top: 0.2rem;
    font-family: Inter, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    color: rgba(222, 222, 222, 0.75);
  }
</style>
