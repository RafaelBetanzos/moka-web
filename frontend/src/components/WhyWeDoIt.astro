---
import Map from "@assets/Map.svg";
import Argentina from "@assets/icons/Argentina.svg";
import Mexico from "@assets/icons/Mexico.svg";
import Brazil from "@assets/icons/Brazil.svg";
import Peru from "@assets/icons/Peru.svg";
import Venezuela from "@assets/icons/Venezuela.svg";
import { Image } from "astro:assets";

const { locale = "en" } = Astro.props;

const copy = {
  en: {
    kicker: "WHY NOW",
    intro: "We believe the Americas hold the richest, least-understood molecular library on Earth.",
    sub: "For the first time, three forces are converging to make what was once impossible not just achievable — but urgent.",
    forces: [
      { tag: "01 · AI", title: "Predict before you experiment", body: "Bioactivity can now be anticipated before you set foot in the lab." },
      { tag: "02 · DEMAND", title: "Industry is looking for new actives", body: "Nutraceuticals, dermocosmetics, agro, and pharma need to stand out. Latin American flora has barely been touched." },
      { tag: "03 · REGULATION", title: "Origin now has value", body: "Nagoya already requires sharing benefits; the WIPO treaty will require declaring origin in patents. Traceable becomes valuable." },
    ],
    closing: "Moka is built for this window.",
    flags: {
      mexico: { name: "Mexico", stat: "10–12%", desc: "of the world's known species live in Mexico (CONABIO)." },
      argentina: { name: "Argentina", stat: "~10,000", desc: "native vascular plant species, about 2,000 of them endemic (CONICET)." },
      brazil: { name: "Brazil", stat: "15–20%", desc: "of the planet's biological diversity is found in Brazil (UNEP)." },
      peru: { name: "Peru", stat: "25,000", desc: "plant species, 10% of the world total; about 1,400 have medicinal uses (MINAM)." },
      venezuela: { name: "Venezuela", stat: "1 of 17", desc: "megadiverse countries on Earth." },
    },
  },
  es: {
    kicker: "POR QUÉ AHORA",
    intro: "Creemos que las Américas albergan la biblioteca molecular más rica y menos comprendida de la Tierra.",
    sub: "Por primera vez, tres fuerzas convergen para hacer lo imposible no solo alcanzable — sino urgente.",
    forces: [
      { tag: "01 · IA", title: "Predecir antes de experimentar", body: "Hoy ya es posible anticipar bioactividad antes de pisar el laboratorio." },
      { tag: "02 · DEMANDA", title: "La industria busca activos nuevos", body: "Nutracéutica, dermocosmética, agro y pharma necesitan diferenciarse. La flora latinoamericana apenas se ha tocado." },
      { tag: "03 · REGULACIÓN", title: "El origen ahora tiene valor", body: "Nagoya ya exige compartir beneficios; el tratado de la OMPI exigirá declarar el origen en las patentes. Lo trazable se vuelve valioso." },
    ],
    closing: "Moka está construida para esta ventana de oportunidad.",
    flags: {
      mexico: { name: "México", stat: "10–12%", desc: "de las especies conocidas del mundo habitan en México (CONABIO)." },
      argentina: { name: "Argentina", stat: "~10,000", desc: "especies de plantas vasculares nativas, unas 2,000 endémicas (CONICET)." },
      brazil: { name: "Brasil", stat: "15–20%", desc: "de la diversidad biológica del planeta se encuentra en Brasil (PNUMA)." },
      peru: { name: "Perú", stat: "25,000", desc: "especies de plantas, el 10% del total mundial; unas 1,400 de uso medicinal (MINAM)." },
      venezuela: { name: "Venezuela", stat: "1 de 17", desc: "países megadiversos del planeta." },
    },
  },
  pt: {
    kicker: "POR QUE AGORA",
    intro: "Acreditamos que as Américas abrigam a biblioteca molecular mais rica e menos compreendida da Terra.",
    sub: "Pela primeira vez, três forças convergem para tornar o impossível não apenas alcançável — mas urgente.",
    forces: [
      { tag: "01 · IA", title: "Prever antes de experimentar", body: "Hoje já é possível antecipar bioatividade antes de pisar no laboratório." },
      { tag: "02 · DEMANDA", title: "A indústria busca novos ativos", body: "Nutracêutica, dermocosmética, agro e pharma precisam se diferenciar. A flora latino-americana mal foi tocada." },
      { tag: "03 · REGULAÇÃO", title: "A origem agora tem valor", body: "Nagoya já exige repartir benefícios; o tratado da OMPI exigirá declarar a origem nas patentes. O rastreável passa a valer." },
    ],
    closing: "A Moka foi construída para esta janela de oportunidade.",
    flags: {
      mexico: { name: "México", stat: "10–12%", desc: "das espécies conhecidas do mundo vivem no México (CONABIO)." },
      argentina: { name: "Argentina", stat: "~10.000", desc: "espécies de plantas vasculares nativas, cerca de 2.000 endêmicas (CONICET)." },
      brazil: { name: "Brasil", stat: "15–20%", desc: "da diversidade biológica do planeta está no Brasil (PNUMA)." },
      peru: { name: "Peru", stat: "25.000", desc: "espécies de plantas, 10% do total mundial; cerca de 1.400 de uso medicinal (MINAM)." },
      venezuela: { name: "Venezuela", stat: "1 de 17", desc: "países megadiversos do planeta." },
    },
  },
};

const t = copy[locale as keyof typeof copy] ?? copy.en;
const countryHref = (slug: string) => (locale === "en" ? "" : "/" + locale) + "/countries/" + slug + "/";
---

<section class="why-section relative overflow-hidden px-5 py-16 sm:px-8 lg:py-24">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-birch/10 to-transparent"></div>

  <div class="why-shell">

    <!-- Header: text left, map right (2-column grid) -->
    <div class="why-header-grid">

      <!-- Left: kicker + intro + flags -->
      <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.05s;">
        <div class="why-kicker">{t.kicker}</div>
        <h2 class="why-intro mt-5">{t.intro}</h2>
        <p class="why-sub mt-5">{t.sub}</p>

        <!-- Flags below the intro text -->
        <div class="why-flags mt-8">

          <a class="why-flag-item" href={countryHref("mexico")}>
            <Image src={Mexico} alt="Mexico" class="why-flag-icon" />
            <div class="why-flag-tooltip">
              <p class="why-flag-name">{t.flags.mexico.name}</p>
              <p class="why-flag-stat"><span class="why-flag-stat-num">{t.flags.mexico.stat}</span> {t.flags.mexico.desc}</p>
            </div>
          </a>

          <a class="why-flag-item" href={countryHref("argentina")}>
            <Image src={Argentina} alt="Argentina" class="why-flag-icon" />
            <div class="why-flag-tooltip">
              <p class="why-flag-name">{t.flags.argentina.name}</p>
              <p class="why-flag-stat"><span class="why-flag-stat-num">{t.flags.argentina.stat}</span> {t.flags.argentina.desc}</p>
            </div>
          </a>

          <a class="why-flag-item" href={countryHref("brazil")}>
            <Image src={Brazil} alt="Brazil" class="why-flag-icon" />
            <div class="why-flag-tooltip">
              <p class="why-flag-name">{t.flags.brazil.name}</p>
              <p class="why-flag-stat"><span class="why-flag-stat-num">{t.flags.brazil.stat}</span> {t.flags.brazil.desc}</p>
            </div>
          </a>

          <a class="why-flag-item" href={countryHref("peru")}>
            <Image src={Peru} alt="Peru" class="why-flag-icon" />
            <div class="why-flag-tooltip">
              <p class="why-flag-name">{t.flags.peru.name}</p>
              <p class="why-flag-stat"><span class="why-flag-stat-num">{t.flags.peru.stat}</span> {t.flags.peru.desc}</p>
            </div>
          </a>

          <div class="why-flag-item">
            <Image src={Venezuela} alt="Venezuela" class="why-flag-icon" />
            <div class="why-flag-tooltip">
              <p class="why-flag-name">{t.flags.venezuela.name}</p>
              <p class="why-flag-stat"><span class="why-flag-stat-num">{t.flags.venezuela.stat}</span> {t.flags.venezuela.desc}</p>
            </div>
          </div>

        </div>
      </div>

      <!-- Right: map -->
      <div class="why-map-col reveal opacity-0" data-animation="pop-in" style="transition-delay: 0.18s;" aria-hidden="true">
        <div class="why-map-wrap">
          <Image src={Map} alt="" class="why-map-img" />
        </div>
      </div>

    </div>

    <!-- Three forces -->
    <div class="why-forces">
      {t.forces.map((force, i) => (
        <article class="why-force reveal opacity-0" data-animation="pop-in" style={`transition-delay: ${0.1 + i * 0.1}s;`}>
          <p class="why-force-tag">{force.tag}</p>
          <h3 class="why-force-title">{force.title}</h3>
          <p class="why-force-body">{force.body}</p>
        </article>
      ))}
    </div>

    <p class="why-closing reveal opacity-0" data-animation="slide-in">{t.closing}</p>



  </div>
</section>

<style>
  .why-section {
    background: transparent;
    position: relative;
    z-index: 3;
  }

  /* ── Shell ───────────────────────────────────── */
  .why-shell {
    width: min(100%, 1180px);
    margin: 0 auto;
    position: relative;
  }

  /* ── Header: 2-col grid ─────────────────────── */
  .why-header-grid {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: center;
  }

  /* Map column */
  .why-map-col {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 5;
  }

  .why-map-wrap {
    position: relative;
    z-index: 5;
    width: min(78vw, 840px);
    max-width: 840px;
    margin-right: clamp(-8rem, -7vw, -2rem);
    animation: whyMapFloat 7s ease-in-out infinite;
  }

  .why-map-img {
    width: 100%;
    height: auto;
    display: block;
    opacity: 0.9;
    filter: grayscale(1) contrast(1.24) brightness(0.78) drop-shadow(0 28px 80px rgba(0, 0, 0, 0.42));
  }

  @keyframes whyMapFloat {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-12px); }
  }

  /* ── Kicker + intro ──────────────────────────── */
  .why-kicker {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.42em;
    color: var(--fresh-green-color);
    text-transform: uppercase;
  }

  .why-intro {
    font-family: Inter, sans-serif;
    font-size: clamp(2rem, 3.2vw, 2.44rem);
    font-weight: 500;
    line-height: 1.2;
    color: var(--pure-color);
    text-wrap: balance;
  }

  .why-sub {
    max-width: 560px;
    font-family: Inter, sans-serif;
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.7;
    color: var(--moka-text-muted);
  }

  /* ── Country flags ───────────────────────────── */
  .why-flags {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .why-flag-item {
    position: relative;
    cursor: pointer;
  }

  .why-flag-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    transition: transform 280ms ease, box-shadow 280ms ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.28);
  }

  .why-flag-item:hover .why-flag-icon {
    transform: translateY(-4px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.38);
  }

  .why-flag-tooltip {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    width: 200px;
    background: rgba(19, 45, 37, 0.96);
    border: 1px solid rgba(222, 222, 222, 0.12);
    border-radius: 0.75rem;
    padding: 0.65rem 0.85rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 240ms ease, transform 240ms ease;
    backdrop-filter: blur(12px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.34);
    z-index: 10;
  }

  .why-flag-item:hover .why-flag-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .why-flag-name {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fresh-green-color);
    margin-bottom: 0.2rem;
  }

  .why-flag-stat {
    font-family: Inter, sans-serif;
    font-size: 13px;
    line-height: 1.5;
    color: rgba(222, 222, 222, 0.72);
  }

  .why-flag-stat-num {
    font-weight: 700;
    color: var(--fresh-green-color);
  }

  /* ── Animations ──────────────────────────────── */
  .animate-slide-in { animation: whySlideIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  .animate-pop-in   { animation: whyPopIn   0.72s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

  @keyframes whySlideIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes whyPopIn {
    from { opacity: 0; transform: scale(0.96) translateY(14px); }
    to   { opacity: 1; transform: scale(1)    translateY(0); }
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 1023px) {
    .why-header-grid { grid-template-columns: 1fr; }
    .why-map-col { display: none; }
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .why-map-col { display: flex; }
    .why-map-wrap {
      width: min(92vw, 720px);
      max-width: 720px;
      margin-right: 0;
    }
    .why-flag-icon { width: 50px; height: 50px; }
  }

  @media (max-width: 639px) {
    .why-flag-icon { width: 40px; height: 40px; }
    .why-flags { gap: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-slide-in,
    .animate-pop-in { animation-duration: 1ms; }
    .why-map-bg     { animation: none; }
  }

  /* ── Three forces ────────────────────────────── */
  .why-forces {
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .why-force {
    position: relative;
    padding: 1.6rem 1.5rem 1.7rem;
    border-radius: 1.5rem;
    border: 1px solid rgba(222, 222, 222, 0.1);
    background: linear-gradient(160deg, rgba(19, 45, 37, 0.55) 0%, rgba(18, 18, 18, 0.9) 70%);
  }

  .why-force::before {
    content: "";
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, rgba(110, 191, 126, 0.55), transparent);
  }

  .why-force-tag {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--fresh-green-color);
  }

  .why-force-title {
    margin-top: 0.9rem;
    font-family: Inter, sans-serif;
    font-size: clamp(1.2rem, 1.7vw, 1.45rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--pure-color);
  }

  .why-force-body {
    margin-top: 0.7rem;
    font-family: Inter, sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(222, 222, 222, 0.74);
  }

  .why-closing {
    margin-top: 2.5rem;
    text-align: center;
    font-family: Inter, sans-serif;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 650;
    color: var(--fresh-green-color);
  }

  @media (max-width: 900px) {
    .why-forces { grid-template-columns: 1fr; }
  }

  a.why-flag-item { text-decoration: none; }
  a.why-flag-item:focus-visible { outline: 2px solid var(--fresh-green-color); outline-offset: 4px; border-radius: 999px; }
</style>
