---
// Latin America only (Mexico southward), cut from Map.svg along the US–Mexico border.
import Map from "@assets/MapLatam.png";
import Argentina from "@assets/icons/Argentina.svg";
import Mexico from "@assets/icons/Mexico.svg";
import Brazil from "@assets/icons/Brazil.svg";
import Peru from "@assets/icons/Peru.svg";
import { Image } from "astro:assets";
import { hasPublicFile } from "../utils/publicAsset";

interface Props {
  locale?: "en" | "es" | "pt";
  /** The three "why now" forces, their intro line and the closing line. The home hides them. */
  showForces?: boolean;
}

const { locale = "en", showForces = true } = Astro.props;

const copy = {
  en: {
    kicker: "LATIN AMERICA",
    intro: "We believe the Americas hold the richest, least-understood molecular library on Earth.",
    stat: "33%",
    claim: "of the world's known vascular plant species grow in the Americas.",
    subtitle: "Only a small share of these plants has ever been systematically studied.",
    sub: "For the first time, three forces are converging to make what was once impossible not just achievable — but urgent.",
    forces: [
      { tag: "01 · AI", title: "Predict before you experiment", body: "Bioactivity can now be anticipated before you set foot in the lab." },
      { tag: "02 · DEMAND", title: "Industry is looking for new actives", body: "Nutraceuticals, dermocosmetics, agro, and pharma need to stand out." },
      { tag: "03 · REGULATION", title: "Origin now has value", body: "Under the Nagoya Protocol, benefits from using genetic resources must be shared fairly with the providing country, on mutually agreed terms. A WIPO treaty adopted in 2024 would require patent applicants to disclose the origin of genetic resources, once it enters into force." },
    ],
    closing: "Moka is built for this window.",
    flags: {
      mexico: { name: "Mexico", stat: "10–12%", desc: "of the world's known species live in Mexico (CONABIO)." },
      argentina: { name: "Argentina", stat: "~10,000", desc: "vascular plant species grow in Argentina, about 2,000 of them endemic (CONICET, 2013)." },
      brazil: { name: "Brazil", stat: "~15%", desc: "of the world's species (MMA)." },
      peru: { name: "Peru" },
      colombia: { name: "Colombia" },
    },
  },
  es: {
    kicker: "AMÉRICA LATINA",
    intro: "Creemos que las Américas albergan la biblioteca molecular más rica y menos comprendida de la Tierra.",
    stat: "33%",
    claim: "de las especies de plantas vasculares conocidas en el mundo crecen en las Américas.",
    subtitle: "Solo una pequeña parte de estas plantas se ha estudiado de forma sistemática.",
    sub: "Por primera vez, tres fuerzas convergen para hacer lo imposible no solo alcanzable — sino urgente.",
    forces: [
      { tag: "01 · IA", title: "Predecir antes de experimentar", body: "Hoy ya es posible anticipar bioactividad antes de pisar el laboratorio." },
      { tag: "02 · DEMANDA", title: "La industria busca activos nuevos", body: "Nutracéutica, dermocosmética, agro y pharma necesitan diferenciarse." },
      { tag: "03 · REGULACIÓN", title: "El origen ahora tiene valor", body: "Según el Protocolo de Nagoya, los beneficios derivados de la utilización de recursos genéticos deben compartirse de forma justa con el país que los aporta, en condiciones mutuamente acordadas. Un tratado de la OMPI adoptado en 2024 exigiría a quienes solicitan patentes divulgar el origen de los recursos genéticos, una vez que entre en vigor." },
    ],
    closing: "Moka está construida para esta ventana de oportunidad.",
    flags: {
      mexico: { name: "México", stat: "10–12%", desc: "de las especies conocidas del mundo habitan en México (CONABIO)." },
      argentina: { name: "Argentina", stat: "~10,000", desc: "especies de plantas vasculares crecen en Argentina, unas 2,000 de ellas endémicas (CONICET, 2013)." },
      brazil: { name: "Brasil", stat: "~15%", desc: "de las especies del mundo (MMA)." },
      peru: { name: "Perú" },
      colombia: { name: "Colombia" },
    },
  },
  pt: {
    kicker: "AMÉRICA LATINA",
    intro: "Acreditamos que as Américas abrigam a biblioteca molecular mais rica e menos compreendida da Terra.",
    stat: "33%",
    claim: "das espécies de plantas vasculares conhecidas no mundo crescem nas Américas.",
    subtitle: "Apenas uma pequena parte dessas plantas já foi estudada de forma sistemática.",
    sub: "Pela primeira vez, três forças convergem para tornar o impossível não apenas alcançável — mas urgente.",
    forces: [
      { tag: "01 · IA", title: "Prever antes de experimentar", body: "Hoje já é possível antecipar bioatividade antes de pisar no laboratório." },
      { tag: "02 · DEMANDA", title: "A indústria busca novos ativos", body: "Nutracêutica, dermocosmética, agro e pharma precisam se diferenciar." },
      { tag: "03 · REGULAÇÃO", title: "A origem agora tem valor", body: "Pelo Protocolo de Nagoya, os benefícios da utilização de recursos genéticos devem ser repartidos de forma justa com o país provedor, em termos mutuamente acordados. Um tratado da OMPI adotado em 2024 exigiria que os depositantes de patentes divulgassem a origem dos recursos genéticos, quando entrar em vigor." },
    ],
    closing: "A Moka foi construída para esta janela de oportunidade.",
    flags: {
      mexico: { name: "México", stat: "10–12%", desc: "das espécies conhecidas do mundo vivem no México (CONABIO)." },
      argentina: { name: "Argentina", stat: "~10.000", desc: "espécies de plantas vasculares crescem na Argentina, cerca de 2.000 delas endêmicas (CONICET, 2013)." },
      brazil: { name: "Brasil", stat: "~15%", desc: "das espécies do mundo (MMA)." },
      peru: { name: "Peru" },
      colombia: { name: "Colômbia" },
    },
  },
};

const t = copy[locale as keyof typeof copy] ?? copy.en;
// Source for the home's 33% figure (same short form in every locale).
const statSource = { label: "Ulloa et al., 2017", href: "https://doi.org/10.1126/science.aao0398" };
// The Colombia flag is supplied separately; the entry only renders once the file exists.
const colombiaFlag = "/flags/colombiaflag.png";
const hasColombiaFlag = hasPublicFile(colombiaFlag);
const countryHref = (slug: string) => (locale === "en" ? "" : "/" + locale) + "/countries/" + slug + "/";
---

<section class:list={["why-section relative overflow-hidden px-5 py-16 sm:px-8 lg:py-24", !showForces && "why-section--rooted"]}>
  {showForces && <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-birch/10 to-transparent"></div>}

  <div class="why-shell">

    <!-- Header: text left, map right (2-column grid) -->
    <div class="why-header-grid">

      <!-- Left: kicker + intro + flags -->
      <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.05s;">
        {showForces ? (
          <>
            <div class="why-kicker">{t.kicker}</div>
            <h2 class="why-intro mt-5">{t.intro}</h2>
            <p class="why-sub mt-5">{t.sub}</p>
          </>
        ) : (
          <>
            <h2 class="why-intro why-intro--stat">
              <span class="why-region">{t.stat}</span>
              {t.claim}<sup class="why-cite"><a class="data-card-source" href={statSource.href} target="_blank" rel="noopener">{statSource.label} <span aria-hidden="true">↗</span></a></sup>
            </h2>
            <p class="why-sub why-sub--accent mt-5">{t.subtitle}</p>
          </>
        )}

        <!-- Flags below the intro text -->
        <div class="why-flags mt-8">

          <a class="why-flag-item" href={countryHref("mexico")}>
            <Image src={Mexico} alt="Mexico" class="why-flag-icon" />
            <div class="why-flag-tooltip">
              <p class="why-flag-name">{t.flags.mexico.name}</p>
              <p class="why-flag-stat"><span class="why-flag-stat-num">{t.flags.mexico.stat}</span> {t.flags.mexico.desc}</p>
            </div>
          </a>

          <a class="why-flag-item" href={countryHref("argentina")}>
            <Image src={Argentina} alt="Argentina" class="why-flag-icon" />
            <div class="why-flag-tooltip">
              <p class="why-flag-name">{t.flags.argentina.name}</p>
              <p class="why-flag-stat"><span class="why-flag-stat-num">{t.flags.argentina.stat}</span> {t.flags.argentina.desc}</p>
            </div>
          </a>

          <a class="why-flag-item" href={countryHref("brazil")}>
            <Image src={Brazil} alt="Brazil" class="why-flag-icon" />
            <div class="why-flag-tooltip">
              <p class="why-flag-name">{t.flags.brazil.name}</p>
              <p class="why-flag-stat"><span class="why-flag-stat-num">{t.flags.brazil.stat}</span> {t.flags.brazil.desc}</p>
            </div>
          </a>

          <a class="why-flag-item" href={countryHref("peru")}>
            <Image src={Peru} alt="Peru" class="why-flag-icon" />
            <div class="why-flag-tooltip">
              <p class="why-flag-name">{t.flags.peru.name}</p>
            </div>
          </a>

          {hasColombiaFlag && (
            <a class="why-flag-item" href={countryHref("colombia")}>
              <img src={colombiaFlag} alt="Colombia" class="why-flag-icon why-flag-icon--photo" width="44" height="44" loading="lazy" decoding="async" />
              <div class="why-flag-tooltip">
                <p class="why-flag-name">{t.flags.colombia.name}</p>
              </div>
            </a>
          )}

        </div>
      </div>

      <!-- Right: map -->
      <div class="why-map-col reveal opacity-0" data-animation="pop-in" style="transition-delay: 0.18s;" aria-hidden="true">
        <div class="why-map-wrap">
          <Image src={Map} alt="" class="why-map-img" />
        </div>
      </div>

    </div>

    {showForces && (<>
    <!-- Three forces -->
    <div class="why-forces">
      {t.forces.map((force, i) => (
        <article class="why-force reveal opacity-0" data-animation="pop-in" style={`transition-delay: ${0.1 + i * 0.1}s;`}>
          <p class="why-force-tag">{force.tag}</p>
          <h3 class="why-force-title">{force.title}</h3>
          <p class="why-force-body">{force.body}</p>
        </article>
      ))}
    </div>

    <p class="why-closing reveal opacity-0" data-animation="slide-in">{t.closing}</p>
    </>)}



  </div>
</section>

<style>
  .why-section {
    background: transparent;
    position: relative;
    z-index: 3;
  }

  /* Home: the block rises into the bottom of the hero so Latin America grows out of the
     hero plant's roots. It starts just below the marquee, whose bottom sits a fixed
     distance from the hero top (measured: 659px mobile, 768px tablet, 759px desktop; the
     values below add ~56px of room), while the hero is at least one screen tall. */
  .why-section--rooted {
    z-index: 5;
    padding-top: 1rem;
    margin-top: min(0px, calc(715px - 100vh));
  }

  @media (min-width: 640px) {
    .why-section--rooted { margin-top: min(0px, calc(824px - 100vh)); }
  }

  @media (min-width: 1280px) {
    .why-section--rooted { margin-top: min(0px, calc(815px - 100vh)); }
  }

  /* ── Shell ───────────────────────────────────── */
  .why-shell {
    width: min(100%, 1180px);
    margin: 0 auto;
    position: relative;
  }

  /* ── Header: 2-col grid ─────────────────────── */
  .why-header-grid {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    max-width: 1040px;
    margin: 0 auto;
  }

  /* Map column */
  .why-map-col {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 5;
  }

  .why-map-wrap {
    position: relative;
    z-index: 5;
    width: min(100%, 400px);
    animation: whyMapFloat 7s ease-in-out infinite;
  }

  .why-map-img {
    width: 100%;
    height: auto;
    display: block;
    opacity: 0.9;
    filter: grayscale(1) contrast(1.24) brightness(0.78) drop-shadow(0 28px 80px rgba(0, 0, 0, 0.42));
  }

  @keyframes whyMapFloat {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-12px); }
  }

  /* ── Kicker + intro ──────────────────────────── */
  .why-kicker {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.42em;
    color: var(--fresh-green-color);
    text-transform: uppercase;
  }

  .why-region {
    display: block;
    margin-bottom: 0.6rem;
    font-size: clamp(4.5rem, 9vw, 7.5rem);
    font-weight: 650;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--pure-color);
  }

  /* Home: big white 33% → grey claim + citation → green sentence.
     Grey and green text use the same sizes as the next block (DataBioactivitySection). */
  .why-intro.why-intro--stat {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.625;
    color: var(--moka-text-muted);
  }

  .why-intro--stat .why-cite a { color: var(--moka-text-muted); }
  .why-intro--stat .why-cite a:hover { color: var(--fresh-green-color); }

  .why-sub.why-sub--accent {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.375;
    color: var(--fresh-green-color);
  }

  @media (min-width: 640px) {
    .why-intro.why-intro--stat { font-size: 20px; }
    .why-sub.why-sub--accent { font-size: 24px; }
  }

  /* Superscript citation after the home claim; mirrors the .data-card-source link style. */
  .why-cite {
    display: inline-block;
    margin-left: 0.4em;
    vertical-align: super;
    font-size: 13px;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
  }

  .why-cite a {
    color: rgba(222, 222, 222, 0.6);
    text-decoration: underline;
    text-decoration-color: rgba(222, 222, 222, 0.25);
    text-underline-offset: 4px;
    transition: color 150ms ease;
  }

  .why-cite a:hover { color: var(--fresh-green-color); }

  .why-intro {
    font-family: Inter, sans-serif;
    font-size: clamp(2rem, 3.2vw, 2.44rem);
    font-weight: 500;
    line-height: 1.2;
    color: var(--pure-color);
    text-wrap: balance;
  }

  .why-sub {
    max-width: 560px;
    font-family: Inter, sans-serif;
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.7;
    color: var(--moka-text-muted);
  }

  /* ── Country flags ───────────────────────────── */
  .why-flags {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .why-flag-item {
    position: relative;
    cursor: pointer;
  }

  .why-flag-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    transition: transform 280ms ease, box-shadow 280ms ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.28);
  }

  .why-flag-icon--photo {
    object-fit: cover;
  }

  .why-flag-item:hover .why-flag-icon {
    transform: translateY(-4px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.38);
  }

  .why-flag-tooltip {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    width: 200px;
    background: rgba(19, 45, 37, 0.96);
    border: 1px solid rgba(222, 222, 222, 0.12);
    border-radius: 0.75rem;
    padding: 0.65rem 0.85rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 240ms ease, transform 240ms ease;
    backdrop-filter: blur(12px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.34);
    z-index: 10;
  }

  .why-flag-item:hover .why-flag-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .why-flag-name {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fresh-green-color);
    margin-bottom: 0.2rem;
  }

  .why-flag-stat {
    font-family: Inter, sans-serif;
    font-size: 13px;
    line-height: 1.5;
    color: rgba(222, 222, 222, 0.72);
  }

  .why-flag-stat-num {
    font-weight: 700;
    color: var(--fresh-green-color);
  }

  /* ── Animations ──────────────────────────────── */
  .animate-slide-in { animation: whySlideIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  .animate-pop-in   { animation: whyPopIn   0.72s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

  @keyframes whySlideIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes whyPopIn {
    from { opacity: 0; transform: scale(0.96) translateY(14px); }
    to   { opacity: 1; transform: scale(1)    translateY(0); }
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 1023px) {
    .why-header-grid { grid-template-columns: 1fr; }
    .why-map-col { display: none; }
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .why-map-col { display: flex; }
    .why-map-wrap {
      width: min(80vw, 380px);
    }
    .why-flag-icon { width: 50px; height: 50px; }
  }

  @media (max-width: 639px) {
    .why-flag-icon { width: 40px; height: 40px; }
    .why-flags { gap: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-slide-in,
    .animate-pop-in { animation-duration: 1ms; }
    .why-map-bg     { animation: none; }
  }

  /* ── Three forces ────────────────────────────── */
  .why-forces {
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .why-force {
    position: relative;
    padding: 1.6rem 1.5rem 1.7rem;
    border-radius: 1.5rem;
    border: 1px solid rgba(222, 222, 222, 0.1);
    background: linear-gradient(160deg, rgba(19, 45, 37, 0.55) 0%, rgba(18, 18, 18, 0.9) 70%);
  }

  .why-force::before {
    content: "";
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, rgba(110, 191, 126, 0.55), transparent);
  }

  .why-force-tag {
    font-family: Roboto, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--fresh-green-color);
  }

  .why-force-title {
    margin-top: 0.9rem;
    font-family: Inter, sans-serif;
    font-size: clamp(1.2rem, 1.7vw, 1.45rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--pure-color);
  }

  .why-force-body {
    margin-top: 0.7rem;
    font-family: Inter, sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(222, 222, 222, 0.74);
  }

  .why-closing {
    margin-top: 2.5rem;
    text-align: center;
    font-family: Inter, sans-serif;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 650;
    color: var(--fresh-green-color);
  }

  @media (max-width: 900px) {
    .why-forces { grid-template-columns: 1fr; }
  }

  a.why-flag-item { text-decoration: none; }
  a.why-flag-item:focus-visible { outline: 2px solid var(--fresh-green-color); outline-offset: 4px; border-radius: 999px; }
</style>
