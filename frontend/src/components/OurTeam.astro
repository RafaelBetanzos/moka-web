---
import { MembersTeam } from "./Members/MembersTeam";
import { AdvisorsTeam } from "./Advisors/AdvisorsTeam";
---

<div class="flex flex-col items-center justify-center py-20 px-8 bg-charcoal text-[28px]">
  
  <div class="mb-8"> <h1 class="font-roboto font-medium text-birch leading-4 tracking-[0.4em] text-center">
      MEET OUR TEAM
    </h1>
  </div>

  <div class="xl:text-[48px] lg:text-[36px] text-[28px] font-bold text-center leading-tight mb-8">
    <h2>
      <span class="text-freshgreen">We combine scientific excellence</span> 
      <span class="text-pure"> with international experience</span>
    </h2>
  </div>

  <MembersTeam client:load />
  
  <div class="h-8"></div>
  
  <AdvisorsTeam client:load />
</div>
