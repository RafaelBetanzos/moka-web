---
import { MembersTeam } from "./Members/MembersTeam";
import { AdvisorsTeam } from "./Advisors/AdvisorsTeam";

interface Props {
  locale?: "en" | "es" | "pt";
}

const { locale = "en" } = Astro.props;
const copy = {
  en: {
    kicker: "MEET OUR TEAM",
    titleA: "We combine scientific excellence",
    titleB: " with international experience",
  },
  es: {
    kicker: "CONOCE AL EQUIPO",
    titleA: "Combinamos excelencia científica",
    titleB: " con experiencia internacional",
  },
  pt: {
    kicker: "CONHEÇA A EQUIPE",
    titleA: "Combinamos excelência científica",
    titleB: " com experiência internacional",
  },
}[locale];
---

<div class="flex flex-col items-center justify-center py-20 px-8 bg-charcoal text-[28px]">
  
  <div class="mb-8"> <p class="font-roboto font-medium text-birch leading-4 tracking-[0.4em] text-center">
      {copy.kicker}
    </p>
  </div>

  <div class="text-[clamp(1.9rem,3.4vw,3rem)] font-semibold text-center leading-tight mb-8">
    <h2>
      <span class="text-freshgreen">{copy.titleA}</span> 
      <span class="text-pure">{copy.titleB}</span>
    </h2>
  </div>

  <MembersTeam client:load locale={locale} />
  
  <div class="h-8"></div>
  
  <AdvisorsTeam client:load locale={locale} />
</div>
