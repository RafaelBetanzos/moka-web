---
import BigData from "@assets/icons/BigData.svg";
import DoubleChevronSecondary from "@assets/icons/DoubleChevronSecondary.svg";
import Integration from "@assets/icons/Integration.svg";
import Scalability from "@assets/icons/Scalability.svg";
import { Image } from "astro:assets";
---

<div class="flex flex-col gap-8 mt-8 w-full">
  <div class="py-36">
    <h1 class="font-roboto font-medium text-black leading-4 tracking-widest text-center py-8">
      THE PROBLEM
    </h1>
    <p class="text-[#4F7363FF] text-[26px] font-semibold text-center font-inter max-w-4xl mx-auto px-4">
      Almost 99% of plant bioactives are unexplored — a living library waiting to be read. 
    </p>
  </div>

  <div class="bg-custom-gradient px-8 py-20"> 
    <div class="flex flex-col md:flex-row gap-16 md:gap-6 justify-center items-stretch"> 
      
      <div class="relative flex-1 max-w-sm mx-auto w-full">
        <Image src={Integration} alt="integration" class="w-24 absolute z-10 left-1/2 -translate-x-1/2 -top-12" />
        <div class="bg-white rounded-2xl pt-16 pb-8 px-8 min-h-[420px] h-full flex flex-col shadow-sm">
          <h1 class="font-inter font-semibold text-secondary text-[22px] text-center mb-6 leading-tight">
            The Invisible Chemistry Gap
          </h1>
          <ul class="text-graycolor space-y-4 text-center list-none flex-grow flex flex-col justify-center text-[15px]">
            <li>Less than 1% of the plant kingdom's potential has been explored</li>
            <li>Slow and manual discovery processes</li>
            <li>Unmapped chemical diversity</li>
          </ul>
        </div>
      </div>

      <div class="relative flex-1 max-w-sm mx-auto w-full">
        <Image src={BigData} alt="Big Data" class="w-24 absolute z-10 left-1/2 -translate-x-1/2 -top-12" />
        <div class="bg-white rounded-2xl pt-16 pb-8 px-8 min-h-[420px] h-full flex flex-col shadow-sm">
          <h1 class="font-inter font-semibold text-secondary text-[22px] text-center mb-6 leading-tight">
            The Consistency Crisis
          </h1>
          <ul class="text-graycolor space-y-4 text-center list-none flex-grow flex flex-col justify-center text-[15px]">
            <li>Natural ingredients vary by soil, weather, and season</li>
            <li>Instability for pharmaceutical or industrial standards</li>
            <li>Lack of chemical standardization</li>
          </ul>
        </div>
      </div>

      <div class="relative flex-1 max-w-sm mx-auto w-full">
        <Image src={Scalability} alt="scalability" class="w-24 absolute z-10 left-1/2 -translate-x-1/2 -top-12" />
        <div class="bg-white rounded-2xl pt-16 pb-8 px-8 min-h-[420px] h-full flex flex-col shadow-sm">
          <h1 class="font-inter font-semibold text-secondary text-[22px] text-center mb-6 leading-tight">
            The Scalability Bottleneck
          </h1>
          <ul class="text-graycolor space-y-4 text-center list-none flex-grow flex flex-col justify-center text-[15px]">
            <li>Extracting rare molecules requires massive land use</li>
            <li>Environmentally destructive extraction methods</li>
            <li>Economically impossible to scale manually</li>
          </ul>
        </div>
      </div>

    </div>

    <Image src={DoubleChevronSecondary} alt="Double Chevron Secondary" class="w-16 mt-16 align-middle mx-auto" />
  </div>
</div>