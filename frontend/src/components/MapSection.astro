---
import Map from "@assets/Map.svg";
import Argentina from "@assets/icons/Argentina.svg";
import Mexico from "@assets/icons/Mexico.svg";
import Venezuela from "@assets/icons/Venezuela.svg";
import { Image } from "astro:assets";

interface Props {
  locale?: "en" | "es" | "pt";
}

const { locale = "en" } = Astro.props;
const copy = {
  en: {
    titleA: "AI Powered Nature",
    titleB: "The operating system for natural product discovery.",
    body: "Despite the Americas hosting 40% of the world’s plant diversity, it is estimated that over 85% of these species have yet to be scientifically mapped for their molecular activity.",
    mexico: "Mexico hosts over 23,000 plant species, but only",
    mexicoEnd: "are currently utilized in scientific discovery.",
    argentina: "Argentina preserves 10,000+ species, yet less than",
    argentinaEnd: "have been mapped for their molecular potential.",
    venezuela: "With 30,000+ species, Venezuela is a megadiverse giant with over",
    venezuelaEnd: "of its chemical library unexplored.",
  },
  es: {
    titleA: "Naturaleza impulsada por IA",
    titleB: "El sistema operativo para el descubrimiento de productos naturales.",
    body: "Aunque América concentra el 40% de la diversidad vegetal del mundo, se estima que más del 85% de estas especies aún no han sido mapeadas científicamente por su actividad molecular.",
    mexico: "México alberga más de 23,000 especies vegetales, pero solo",
    mexicoEnd: "se utiliza actualmente en descubrimiento científico.",
    argentina: "Argentina preserva más de 10,000 especies, pero menos del",
    argentinaEnd: "ha sido mapeado por su potencial molecular.",
    venezuela: "Con más de 30,000 especies, Venezuela es un gigante megadiverso con más del",
    venezuelaEnd: "de su biblioteca química sin explorar.",
  },
  pt: {
    titleA: "Natureza impulsionada por IA",
    titleB: "O sistema operacional para a descoberta de produtos naturais.",
    body: "Embora as Américas concentrem 40% da diversidade vegetal do mundo, estima-se que mais de 85% dessas espécies ainda não tenham sido mapeadas cientificamente por sua atividade molecular.",
    mexico: "O México abriga mais de 23.000 espécies vegetais, mas apenas",
    mexicoEnd: "é usado atualmente em descoberta científica.",
    argentina: "A Argentina preserva mais de 10.000 espécies, mas menos de",
    argentinaEnd: "foi mapeado por seu potencial molecular.",
    venezuela: "Com mais de 30.000 espécies, a Venezuela é um gigante megadiverso com mais de",
    venezuelaEnd: "de sua biblioteca química inexplorada.",
  },
}[locale];
---

<div class="bg-transparent overflow-hidden py-10 md:py-20">
  <div class="flex flex-col lg:flex-row items-center lg:items-stretch justify-between max-w-7xl mx-auto px-6 md:px-12 gap-12 lg:gap-20 group">
    
    <div class="relative w-full lg:w-1/2 flex items-center justify-center reveal opacity-0" data-animation="pop-in">
      <div class="animate-float relative w-full h-full flex items-center justify-center transition-all duration-1000 ease-out transform group-hover:scale-105">
        <Image 
          src={Map} 
          alt="Map" 
          class="w-full h-auto lg:h-full lg:max-h-[500px] object-contain drop-shadow-2xl opacity-85 grayscale contrast-125 brightness-75" 
        />
        <div class="absolute inset-0 bg-freshgreen/10 mix-blend-screen rounded-full"></div>
        <div class="absolute inset-0 bg-secondary/5 rounded-full blur-3xl -z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-1000"></div>
      </div>
    </div>

    <div class="flex flex-col gap-6 w-full lg:w-1/2 items-center lg:items-end text-center lg:text-end">
      
      <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.1s;">
        <h1 class="font-roboto font-medium text-birch text-sm md:text-base leading-4 tracking-[0.4em] uppercase transition-transform duration-300 hover:scale-105 lg:origin-right cursor-default">
          MOKA BIO
        </h1>
      </div>
      
      <div class="reveal opacity-0 xl:text-[48px] lg:text-[38px] text-[28px] md:text-[32px] font-semibold leading-tight" data-animation="slide-in" style="transition-delay: 0.3s;">
        <h2 class="text-freshgreen transition-transform duration-300 hover:scale-105 lg:origin-right cursor-default">{copy.titleA}</h2>
        <h2 class="transition-transform duration-300 hover:scale-105 lg:origin-right cursor-default text-pure">{copy.titleB}</h2>
      </div>

      <div class="reveal opacity-0 flex flex-col gap-8 items-center lg:items-end" data-animation="slide-in" style="transition-delay: 0.5s;">
        <p class="text-birch/75 font-inter font-medium text-base md:text-lg leading-relaxed lg:pl-20">
          {copy.body}
        </p>
        
        <div class="flex flex-col items-center lg:items-end gap-6 w-full">
          <div class="flex gap-4 md:gap-6 justify-center lg:justify-end">
            
            <div class="group/mx relative">
              <Image src={Mexico} alt="Mexico" class="w-12 h-12 md:w-16 md:h-16 hover:-translate-y-2 transition-all duration-300 cursor-pointer shadow-sm hover:shadow-xl rounded-full" />
              <div class="absolute right-1/2 translate-x-1/2 lg:translate-x-0 lg:right-0 top-full mt-4 w-[260px] md:w-[300px] opacity-0 pointer-events-none group-hover/mx:opacity-100 transition-all duration-500 translate-y-2 group-hover/mx:translate-y-0 z-20">
                <p class="text-freshgreen font-bold text-xs md:text-sm uppercase tracking-widest mb-1">Mexico</p>
                <p class="text-birch text-xs md:text-sm bg-deepforest/95 backdrop-blur-md p-3 rounded-xl shadow-lg border border-sage/30">
                  {copy.mexico} <span class="text-freshgreen font-bold">10%</span> {copy.mexicoEnd}
                </p>
              </div>
            </div>

            <div class="group/ar relative">
              <Image src={Argentina} alt="Argentina" class="w-12 h-12 md:w-16 md:h-16 hover:-translate-y-2 transition-all duration-300 cursor-pointer shadow-sm hover:shadow-xl rounded-full" />
              <div class="absolute right-1/2 translate-x-1/2 lg:translate-x-0 lg:right-0 top-full mt-4 w-[260px] md:w-[300px] opacity-0 pointer-events-none group-hover/ar:opacity-100 transition-all duration-500 translate-y-2 group-hover/ar:translate-y-0 z-20">
                <p class="text-freshgreen font-bold text-xs md:text-sm uppercase tracking-widest mb-1">Argentina</p>
                <p class="text-birch text-xs md:text-sm bg-deepforest/95 backdrop-blur-md p-3 rounded-xl shadow-lg border border-sage/30">
                  {copy.argentina} <span class="text-freshgreen font-bold">5%</span> {copy.argentinaEnd}
                </p>
              </div>
            </div>

            <div class="group/ve relative">
              <Image src={Venezuela} alt="Venezuela" class="w-12 h-12 md:w-16 md:h-16 hover:-translate-y-2 transition-all duration-300 cursor-pointer shadow-sm hover:shadow-xl rounded-full" />
              <div class="absolute right-1/2 translate-x-1/2 lg:translate-x-0 lg:right-0 top-full mt-4 w-[260px] md:w-[300px] opacity-0 pointer-events-none group-hover/ve:opacity-100 transition-all duration-500 translate-y-2 group-hover/ve:translate-y-0 z-20">
                <p class="text-freshgreen font-bold text-xs md:text-sm uppercase tracking-widest mb-1">Venezuela</p>
                <p class="text-birch text-xs md:text-sm bg-deepforest/95 backdrop-blur-md p-3 rounded-xl shadow-lg border border-sage/30">
                  {copy.venezuela} <span class="text-freshgreen font-bold">90%</span> {copy.venezuelaEnd}
                </p>
              </div>
            </div>

          </div>
          
          <div class="h-28 hidden lg:block"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -50px 0px' };
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const animationType = entry.target.getAttribute('data-animation');
        entry.target.classList.add(`animate-${animationType}`);
        entry.target.classList.remove('opacity-0');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>

<style>
  .animate-float { animation: float 6s ease-in-out infinite; }
  .animate-slide-in { animation: slideIn 0.8s ease-out forwards; }
  .animate-pop-in { animation: popIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-15px) rotate(1deg); }
  }

  @keyframes slideIn {
    from { opacity: 0; transform: translateX(40px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 1; transform: scale(1); }
  }

  /* Specific fix for mobile text centering */
  @media (max-width: 1023px) {
    .lg\:origin-right {
      origin: center;
    }
  }
</style>
