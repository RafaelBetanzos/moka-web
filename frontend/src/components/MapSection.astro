---
import Map from "@assets/Map.svg";
import Argentina from "@assets/icons/Argentina.svg";
import Mexico from "@assets/icons/Mexico.svg";
import Venezuela from "@assets/icons/Venezuela.svg";
import { Image } from "astro:assets";
---

<div
  class="flex flex-shrink-0 items-center justify-between xl:gap-24 lg:gap-12 px-8"
>
  <div>
    <Image src={Map} alt="Map" class="object-fit" />
  </div>
  <div class="flex flex-col gap-4 xl:w-[40%] lg:w-[60%] md:w-[80%]">
    <div>
      <h1
        class="font-roboto font-medium text-black leading-4 tracking-widest text-end"
      >
        MOKA THERAPEUTICS
      </h1>
    </div>
    <div
      class="xl:text-[48px] lg:text-[32px] md:text-[32px] font-semibold text-end"
    >
      <h2 class="text-secondary">AI Powered Ethnobotanic</h2>
      <h2>Drug Discovery Platform</h2>
    </div>
    <div class="flex flex-col gap-4 justify-end items-end">
      <p
        class="text-neutral-500 font-inter font-medium xl:text-[18px] lg:text-[16px] md:text-[16px] leading-12 text-end xl:pl-[42%] lg:pl-[35%] md:pl-[28%] text-sm sm:text-base"
      >
        Traditional medicine is widely used and increasingly relevant in the
        world today. We have begun exploring its healing powers to address
        inflammation.
      </p>
      <div class="flex gap-4 jusitfy-end relative z-10 left-12">
        <Image src={Argentina} alt="Argentina" class="w-[20%]" />
        <Image src={Mexico} alt="Mexico" class="w-[20%]" />
        <Image src={Venezuela} alt="Venezuela" class="w-[20%]" />
      </div>
    </div>
  </div>
</div>
