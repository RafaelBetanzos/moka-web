---
import ArrowRight from "@assets/icons/ArrowRight.svg";
import { Image } from "astro:assets";

const dataCopy = {
  en: {
    headline: "Index. Program. Scale.",
    subheadline: "The Biological Intelligence Layer",
    intro: "We transform the planet’s largest validated chemical library into a programmable engine for molecular innovation across medicine, nutrition, and beyond.",
    pills: ["Validated bioactivity", "Molecular indexing", "IP-ready assets"],
    cta: "Our Technology",
    global: "Global Bioactivity",
    globalBadge: "VALIDATED",
    globalDesc: "Of the world population utilizes natural molecular solutions.",
    globalNote: "Synthetic signal mapped",
    natural: "Natural Chemistry",
    naturalBadge: "INDEXED",
    naturalDesc: "Of the world’s natural chemistry has been chemically characterized.",
    naturalNote: "Unindexed opportunity",
    problem: "The Problem",
    problemDesc: "Nature’s chemical diversity is unstructured and offline, making the discovery of predictable, scalable bioactives an artisanal and high-risk process.",
    solution: "The Solution",
    solutionDesc: "Moka provides the programmable infrastructure to decode natural bioactivity into standardized, IP-protected molecular assets for global industries.",
  },
  es: {
    headline: "Indexar. Programar. Escalar.",
    subheadline: "La capa de inteligencia biológica",
    intro: "Transformamos la mayor biblioteca química validada del planeta en un motor programable para innovación molecular en medicina, nutrición y más.",
    pills: ["Bioactividad validada", "Indexación molecular", "Activos listos para PI"],
    cta: "Nuestra tecnología",
    global: "Bioactividad global",
    globalBadge: "VALIDADO",
    globalDesc: "De la población mundial utiliza soluciones moleculares naturales.",
    globalNote: "Señal sintética mapeada",
    natural: "Química natural",
    naturalBadge: "INDEXADO",
    naturalDesc: "De la química natural del mundo ha sido caracterizada químicamente.",
    naturalNote: "Oportunidad no indexada",
    problem: "El problema",
    problemDesc: "La diversidad química de la naturaleza está desestructurada y fuera de línea, haciendo que descubrir bioactivos predecibles y escalables sea artesanal y riesgoso.",
    solution: "La solución",
    solutionDesc: "Moka ofrece la infraestructura programable para decodificar bioactividad natural en activos moleculares estandarizados y protegidos por PI para industrias globales.",
  },
  pt: {
    headline: "Indexar. Programar. Escalar.",
    subheadline: "A camada de inteligência biológica",
    intro: "Transformamos a maior biblioteca química validada do planeta em um motor programável para inovação molecular em medicina, nutrição e além.",
    pills: ["Bioatividade validada", "Indexação molecular", "Ativos prontos para PI"],
    cta: "Nossa tecnologia",
    global: "Bioatividade global",
    globalBadge: "VALIDADO",
    globalDesc: "Da população mundial utiliza soluções moleculares naturais.",
    globalNote: "Sinal sintético mapeado",
    natural: "Química natural",
    naturalBadge: "INDEXADO",
    naturalDesc: "Da química natural do mundo foi caracterizada quimicamente.",
    naturalNote: "Oportunidade não indexada",
    problem: "O problema",
    problemDesc: "A diversidade química da natureza está desestruturada e offline, tornando a descoberta de bioativos previsíveis e escaláveis um processo artesanal e de alto risco.",
    solution: "A solução",
    solutionDesc: "A Moka oferece a infraestrutura programável para decodificar bioatividade natural em ativos moleculares padronizados e protegidos por PI para indústrias globais.",
  },
};

const { locale = "en" } = Astro.props;
const t = dataCopy[locale] ?? dataCopy.en;
---

<section class="home-data-section relative -mt-1 overflow-hidden px-5 py-20 sm:px-8 lg:py-28">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/24 to-transparent"></div>
  <div class="absolute left-1/2 top-0 h-[520px] w-[520px] -translate-x-1/2 rounded-full bg-freshgreen/8 blur-3xl"></div>
  <div class="absolute right-[-12%] bottom-[-20%] h-[620px] w-[620px] rounded-full bg-sage/10 blur-3xl"></div>
  <div class="data-botanical data-botanical-left" aria-hidden="true"></div>
  <div class="data-botanical data-botanical-right" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
    <div class="flex flex-col">
      <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.1s;">
        <p class="font-roboto text-[13px] font-medium leading-none tracking-[0.45em] text-freshgreen uppercase">
          MOKA BIO
        </p>
        <div class="mt-5">
          <h2 class="font-inter text-[40px] font-semibold leading-[1.05] text-pure sm:text-[56px] lg:text-[64px]">{t.headline}</h2>
          <p class="mt-3 font-inter text-[40px] font-semibold leading-[1.05] text-birch/88 sm:text-[56px] lg:text-[64px]">{t.subheadline}</p>
        </div>
      </div>

      <div class="reveal opacity-0 font-inter mt-4" data-animation="slide-in" style="transition-delay: 0.3s;">
        <p class="max-w-xl text-[18px] leading-relaxed text-birch/72 sm:text-[20px]">
          {t.intro}
        </p>
      </div>

      <div class="reveal opacity-0 mt-8 flex flex-wrap gap-3" data-animation="slide-in" style="transition-delay: 0.45s;">
        {t.pills.map((pill) => (
          <span class="rounded-full border border-birch/10 bg-charcoal/40 px-4 py-2 text-sm font-medium text-birch/82 shadow-sm shadow-black/20 backdrop-blur-md">{pill}</span>
        ))}
      </div>

      <a 
        href="/our-technology" 
        class="reveal opacity-0 mt-10 flex w-fit items-center gap-3 rounded-full bg-pure py-2 pl-6 pr-2 font-inter text-[16px] font-semibold text-charcoal shadow-lg shadow-black/20 ring-1 ring-pure/10 transition-all duration-300 hover:bg-freshgreen hover:shadow-freshgreen/20 active:scale-95 no-underline"
        data-animation="bounce-in"
        style="transition-delay: 0.75s;"
      >
        <span>{t.cta}</span>
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-charcoal">
          <Image src={ArrowRight} alt="arrow-right" class="h-5 w-5" />
        </span>
      </a>
    </div>

    <div class="grid gap-4 font-inter">
      <div class="grid gap-4 sm:grid-cols-2">
        <article class="data-card reveal opacity-0 rounded-[1.5rem] border border-birch/10 bg-charcoal/52 p-6 shadow-2xl shadow-black/25 backdrop-blur-xl" data-animation="pop-in" style="transition-delay: 0.25s;">
          <p class="text-xs font-semibold uppercase tracking-[0.32em] text-birch/70">{t.global}</p>
          <div class="mt-6 flex flex-wrap items-end gap-3">
            <p class="text-[56px] font-semibold leading-none text-freshgreen sm:text-[64px]">80%</p>
            <span class="mb-2 rounded-full border border-freshgreen/30 px-3 py-1 text-[11px] font-semibold text-freshgreen">{t.globalBadge}</span>
          </div>
          <p class="mt-5 text-[15px] leading-relaxed text-birch/74">
            {t.globalDesc}
          </p>
          <p class="mt-6 text-xs font-semibold uppercase tracking-[0.28em] text-sage/90">{t.globalNote}</p>
        </article>

        <article class="data-card reveal opacity-0 rounded-[1.5rem] border border-freshgreen/18 bg-deepforest/62 p-6 shadow-2xl shadow-black/25 backdrop-blur-xl" data-animation="pop-in" style="transition-delay: 0.4s;">
          <p class="text-xs font-semibold uppercase tracking-[0.32em] text-birch/70">{t.natural}</p>
          <div class="mt-6 flex flex-wrap items-end gap-3">
            <p class="text-[56px] font-semibold leading-none text-freshgreen sm:text-[64px]">&lt;9%</p>
            <span class="mb-2 rounded-full border border-freshgreen/30 px-3 py-1 text-[11px] font-semibold text-freshgreen">{t.naturalBadge}</span>
          </div>
          <p class="mt-5 text-[15px] leading-relaxed text-birch/74">
            {t.naturalDesc}
          </p>
          <p class="mt-6 text-xs font-semibold uppercase tracking-[0.28em] text-sage/90">{t.naturalNote}</p>
        </article>
      </div>

      <div class="grid gap-4">
        <article class="data-card reveal opacity-0 rounded-[1.25rem] border border-birch/10 bg-charcoal/58 p-6 shadow-lg shadow-black/10 backdrop-blur-xl" data-animation="slide-in-right" style="transition-delay: 0.55s;">
          <div class="flex items-center gap-3">
            <span class="h-2.5 w-2.5 rounded-full bg-sage shadow-[0_0_18px_rgba(86,114,99,0.45)]"></span>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-sage/95">{t.problem}</p>
          </div>
          <p class="mt-4 text-[17px] leading-relaxed text-birch">
            {t.problemDesc}
          </p>
        </article>

        <article class="data-card reveal opacity-0 rounded-[1.25rem] border border-freshgreen/24 bg-gradient-to-br from-deepforest/90 via-deepforest/62 to-charcoal/88 p-6 shadow-xl shadow-freshgreen/5 backdrop-blur-xl" data-animation="slide-in-right" style="transition-delay: 0.7s;">
          <div class="flex items-center gap-3">
            <span class="h-2.5 w-2.5 rounded-full bg-freshgreen shadow-[0_0_18px_rgba(110,191,126,0.55)]"></span>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-freshgreen">{t.solution}</p>
          </div>
          <p class="mt-4 text-[17px] leading-relaxed text-birch">
            {t.solutionDesc}
          </p>
        </article>
      </div>
    </div>
  </div>
</section>


<style>
  .home-data-section {
    background:
      radial-gradient(circle at 8% 14%, rgba(110, 191, 126, 0.08), transparent 28%),
      radial-gradient(circle at 74% 44%, rgba(86, 114, 99, 0.08), transparent 34%);
  }

  .home-data-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(222, 222, 222, 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(110, 191, 126, 0.032) 1px, transparent 1px);
    background-size: 86px 86px;
    mask-image: radial-gradient(circle at 64% 44%, black, transparent 68%);
    opacity: 0.42;
    pointer-events: none;
  }

  .data-botanical {
    position: absolute;
    pointer-events: none;
    background-repeat: no-repeat;
    background-size: contain;
    filter: invert(1);
    opacity: 0.06;
  }

  .data-botanical-left {
    left: -5rem;
    top: 16%;
    width: min(30vw, 360px);
    height: min(42vw, 520px);
    background-image: url("/assets/about-botanicals/botanical-line-02.png");
  }

  .data-botanical-right {
    right: -5rem;
    bottom: 3%;
    width: min(32vw, 400px);
    height: min(42vw, 520px);
    background-image: url("/assets/about-botanicals/botanical-line-04.png");
    transform: rotate(8deg);
  }

  .data-card {
    position: relative;
    overflow: hidden;
    transition: transform 320ms ease, border-color 320ms ease, background 320ms ease;
  }

  .data-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 24% 0%, rgba(110, 191, 126, 0.12), transparent 36%);
    opacity: 0;
    transition: opacity 320ms ease;
    pointer-events: none;
  }

  .data-card:hover {
    transform: translateY(-4px);
    border-color: rgba(110, 191, 126, 0.34);
  }

  .data-card:hover::after {
    opacity: 1;
  }

  /* Entrance Animations */
  .animate-slide-in { animation: slideIn 0.8s ease-out forwards; }
  .animate-slide-in-right { animation: slideInRight 0.8s ease-out forwards; }
  .animate-pop-in { animation: popIn 0.7s ease-out forwards; }
  .animate-bounce-in { animation: bounceIn 0.7s ease-out forwards; }

  @keyframes slideIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(40px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.96) translateY(16px); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes bounceIn {
    0% { opacity: 0; transform: translateY(20px); }
    100% { opacity: 1; transform: scale(1); }
  }

  @media (max-width: 767px) {
    .data-botanical-right {
      display: none;
    }

    .data-botanical-left {
      width: 240px;
      height: 340px;
      opacity: 0.045;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-slide-in,
    .animate-slide-in-right,
    .animate-pop-in,
    .animate-bounce-in {
      animation-duration: 1ms;
    }
  }
</style>
