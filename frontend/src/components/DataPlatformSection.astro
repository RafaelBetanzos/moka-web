---
import ArrowRight from "@assets/icons/ArrowRight.svg";
import { Image } from "astro:assets";
---

<section class="relative -mt-1 overflow-hidden bg-charcoal px-5 py-20 sm:px-8 lg:py-28">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-freshgreen/40 to-transparent"></div>
  <div class="absolute left-1/2 top-0 h-[520px] w-[520px] -translate-x-1/2 rounded-full bg-deepforest/40 blur-3xl"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
    <div class="flex flex-col">
      <div class="reveal opacity-0" data-animation="slide-in" style="transition-delay: 0.1s;">
        <p class="font-roboto text-[13px] font-medium leading-none tracking-[0.45em] text-freshgreen uppercase">
          MOKA BIO
        </p>
        <div class="mt-5 font-inter text-[40px] font-semibold leading-[1.05] text-pure sm:text-[56px] lg:text-[64px]">
          <p>Index. Program. Scale.</p>
          <p class="mt-3 text-birch">The Biological Intelligence Layer</p>
        </div>
      </div>

      <div class="reveal opacity-0 font-inter mt-4" data-animation="slide-in" style="transition-delay: 0.3s;">
        <p class="max-w-xl text-[18px] leading-relaxed text-birch/75 sm:text-[20px]">
          We transform the planet’s largest validated chemical library
          into a programmable engine for molecular innovation
          across medicine, nutrition, and beyond.
        </p>
      </div>

      <div class="reveal opacity-0 mt-8 flex flex-wrap gap-3" data-animation="slide-in" style="transition-delay: 0.45s;">
        <span class="rounded-full border border-sage/40 bg-deepforest/70 px-4 py-2 text-sm font-medium text-birch">Validated bioactivity</span>
        <span class="rounded-full border border-sage/40 bg-deepforest/70 px-4 py-2 text-sm font-medium text-birch">Molecular indexing</span>
        <span class="rounded-full border border-sage/40 bg-deepforest/70 px-4 py-2 text-sm font-medium text-birch">IP-ready assets</span>
      </div>

      <a 
        href="/our-technology" 
        class="reveal opacity-0 mt-10 flex w-fit items-center gap-3 rounded-full bg-pure py-2 pl-6 pr-2 font-inter text-[16px] font-semibold text-charcoal shadow-sm transition-all duration-300 hover:bg-freshgreen hover:shadow-freshgreen/20 active:scale-95 no-underline"
        data-animation="bounce-in"
        style="transition-delay: 0.75s;"
      >
        <span>Our Technology</span>
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-charcoal">
          <Image src={ArrowRight} alt="arrow-right" class="h-5 w-5" />
        </span>
      </a>
    </div>

    <div class="grid gap-4 font-inter">
      <div class="grid gap-4 sm:grid-cols-2">
        <article class="reveal opacity-0 rounded-[1.5rem] border border-sage/25 bg-deepforest/80 p-6 shadow-2xl shadow-black/20" data-animation="pop-in" style="transition-delay: 0.25s;">
          <p class="text-xs font-semibold uppercase tracking-[0.32em] text-birch/70">Global Bioactivity</p>
          <div class="mt-6 flex flex-wrap items-end gap-3">
            <p class="text-[56px] font-semibold leading-none text-freshgreen sm:text-[64px]">80%</p>
            <span class="mb-2 rounded-full border border-freshgreen/30 px-3 py-1 text-[11px] font-semibold text-freshgreen">VALIDATED</span>
          </div>
          <p class="mt-5 text-[15px] leading-relaxed text-birch/75">
            Of the world population utilizes natural molecular solutions.
          </p>
          <p class="mt-6 text-xs font-semibold uppercase tracking-[0.28em] text-sage">Synthetic signal mapped</p>
        </article>

        <article class="reveal opacity-0 rounded-[1.5rem] border border-sage/25 bg-deepforest/80 p-6 shadow-2xl shadow-black/20" data-animation="pop-in" style="transition-delay: 0.4s;">
          <p class="text-xs font-semibold uppercase tracking-[0.32em] text-birch/70">Natural Chemistry</p>
          <div class="mt-6 flex flex-wrap items-end gap-3">
            <p class="text-[56px] font-semibold leading-none text-freshgreen sm:text-[64px]">&lt;9%</p>
            <span class="mb-2 rounded-full border border-freshgreen/30 px-3 py-1 text-[11px] font-semibold text-freshgreen">INDEXED</span>
          </div>
          <p class="mt-5 text-[15px] leading-relaxed text-birch/75">
            Of the world’s natural chemistry has been chemically characterized.
          </p>
          <p class="mt-6 text-xs font-semibold uppercase tracking-[0.28em] text-sage">Unindexed opportunity</p>
        </article>
      </div>

      <div class="grid gap-4">
        <article class="reveal opacity-0 rounded-[1.25rem] border border-sage/25 bg-charcoal/80 p-6" data-animation="slide-in-right" style="transition-delay: 0.55s;">
          <div class="flex items-center gap-3">
            <span class="h-2.5 w-2.5 rounded-full bg-sage"></span>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-sage">The Problem</p>
          </div>
          <p class="mt-4 text-[17px] leading-relaxed text-birch">
            Nature’s chemical diversity is unstructured and offline, making the discovery of predictable, scalable bioactives an artisanal and high-risk process.
          </p>
        </article>

        <article class="reveal opacity-0 rounded-[1.25rem] border border-freshgreen/30 bg-gradient-to-br from-deepforest to-charcoal p-6" data-animation="slide-in-right" style="transition-delay: 0.7s;">
          <div class="flex items-center gap-3">
            <span class="h-2.5 w-2.5 rounded-full bg-freshgreen"></span>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-freshgreen">The Solution</p>
          </div>
          <p class="mt-4 text-[17px] leading-relaxed text-birch">
            Moka provides the programmable infrastructure to decode natural bioactivity into standardized, IP-protected molecular assets for global industries.
          </p>
        </article>
      </div>
    </div>
  </div>
</section>

<script>
  // Intersection Observer Logic
  const observerOptions = {
    threshold: 0.15 // Trigger when 15% of the element is visible
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const animationType = entry.target.getAttribute('data-animation');
        entry.target.classList.add(`animate-${animationType}`);
        entry.target.classList.remove('opacity-0');
        observer.unobserve(entry.target); // Run only once
      }
    });
  }, observerOptions);

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>

<style>
  /* Entrance Animations */
  .animate-slide-in { animation: slideIn 0.8s ease-out forwards; }
  .animate-slide-in-right { animation: slideInRight 0.8s ease-out forwards; }
  .animate-pop-in { animation: popIn 0.7s ease-out forwards; }
  .animate-bounce-in { animation: bounceIn 0.7s ease-out forwards; }

  @keyframes slideIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(40px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.96) translateY(16px); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes bounceIn {
    0% { opacity: 0; transform: translateY(20px); }
    100% { opacity: 1; transform: scale(1); }
  }
</style>
